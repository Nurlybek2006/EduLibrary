{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Library": {
    "FinePerOverdueDay": 100,
    "DefaultLoanDays": 14
  },
  "Database": {
    "ApplyMigrations": false
  },
  "DigitalLibrary": {
    "SeedDemoContent": false,
    "StorageRoot": "App_Data/DigitalLibrary",
    "MaxFileBytes": 52428800,
    "MaxExpandedEpubBytes": 104857600,
    "MaxEpubEntries": 1000,
    "MaxBookmarksPerAsset": 200,
    "SessionIdleMinutes": 30
  },
  "Reservations": {
    "OpeningTime": "09:00",
    "ClosingTime": "18:00",
    "OpenDays": [1, 2, 3, 4, 5],
    "SlotMinutes": 30,
    "SlotCapacity": 5,
    "MaxAdvanceDays": 14,
    "MinimumLeadMinutes": 30,
    "ReadyHoldHours": 48,
    "PendingHoldHours": 24,
    "PickupGraceMinutes": 60,
    "ExpiringSoonHours": 6,
    "ReconcileIntervalMinutes": 5,
    "PickupLocations": [
      { "Id": "main", "Name": "Негізгі кітапхана", "Address": "Кітапхананың абонемент бөлімі" }
    ]
  },
  "Recommendations": {
    "InterestWeight": 30,
    "SubjectWeight": 25,
    "HistoryWeight": 25,
    "PopularityWeight": 20,
    "ExcludePreviouslyBorrowed": true,
    "PrioritizeAvailable": true,
    "CandidateLimit": 2000,
    "ItemsPerSection": 4,
    "Llm": {
      "Enabled": false,
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "",
      "TimeoutSeconds": 8,
      "MaxExplanations": 12
    }
  }
}
