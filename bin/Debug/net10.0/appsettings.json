{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Library": {
    "FinePerOverdueDay": 100,
    "DefaultLoanDays": 14
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Recommendations": {
    "InterestWeight": 30,
    "SubjectWeight": 25,
    "HistoryWeight": 25,
    "PopularityWeight": 20,
    "ExcludePreviouslyBorrowed": true,
    "PrioritizeAvailable": true,
    "CandidateLimit": 2000,
    "ItemsPerSection": 4,
    "Llm": {
      "Enabled": false,
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "",
      "TimeoutSeconds": 8,
      "MaxExplanations": 12
    }
  }
}
