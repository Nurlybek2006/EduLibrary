@model EduLibrary.ViewModels.CategoryEditViewModel
@{ ViewData["Title"] = UiText.Get("Мәліметтерді өзгерту"); }
<div class="workspace-page categories-workspace form-workspace">
<div class="page-header workspace-heading"><div><p class="eyebrow">@T["АНЫҚТАМАЛЫҚТЫ БАСҚАРУ"]</p><h1>@T["Мәліметтерді өзгерту"]</h1><p class="text-muted">@T["Санаттар анықтамалығы"]</p></div><a asp-action="Index" class="btn btn-outline-secondary">@T["Тізімге оралу"]</a></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card ledger-panel"><partial name="_Form" model="Model" /></form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
