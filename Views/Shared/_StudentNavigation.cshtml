@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Current(string name) => controller == name ? "current" : "";
}
<nav class="reader-navigation" id="reader-navigation" aria-label="@T["Кітапхана навигациясы"]">
    <a class="@Current("Books")" asp-controller="Books" asp-action="Index">@T["Каталог"]</a>
    <a class="@Current("DigitalLibrary")" asp-controller="DigitalLibrary" asp-action="Index">@T["Digital library"]</a>
    @if (User.Identity?.IsAuthenticated == true) {
        <a class="@Current("Loans")" asp-controller="Loans" asp-action="Index">@T["Менің кітаптарым"]</a>
        @if (User.IsInRole("Student")) { <a class="reader-mobile-link @Current("Reservations")" asp-controller="Reservations" asp-action="Index">@T["Броньдарым"]</a> }
        <a class="@Current("Recommendations")" asp-controller="Recommendations" asp-action="Index">@T["Ұсыныстар"]</a>
        @if (User.IsInRole("Student")) { <a class="reader-mobile-link @Current("ReadingSpace")" asp-controller="ReadingSpace" asp-action="Index">@T["Оқу кеңістігім"] <i data-lucide="arrow-up-right"></i></a> }
        <a class="reader-mobile-link @Current("Fines")" asp-controller="Fines" asp-action="Index">@T["Айыппұлдар"]</a>
        <a class="reader-mobile-link" asp-controller="Account" asp-action="Profile">@T["Профиль"]</a>
    } else {
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Recommendations">@T["Жеке ұсыныстар"]</a>
        <a asp-controller="Account" asp-action="Register">@T["Оқырман болу"] <i data-lucide="arrow-up-right"></i></a>
    }
</nav>
