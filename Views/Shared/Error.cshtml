@model ErrorViewModel
@{ ViewData["Title"]=UiText.Get("Қате орын алды"); }
<section class="status-page"><div class="status-number">…</div><span class="eyebrow">EDULIBRARY</span><h1>@T["Сұрауды орындау мүмкін болмады"]</h1><p>@T["Кейінірек қайталап көріңіз. Мәселе қайталанса, кітапхана әкімшісіне хабарласыңыз."]</p>@if(Model.ShowRequestId){<p class="request-reference">@T["Сұрау нөмірі:"] <code>@Model.RequestId</code></p>}<a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i data-lucide="arrow-left"></i>@T["Басты бетке оралу"]</a></section>
