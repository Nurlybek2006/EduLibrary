@model EduLibrary.ViewModels.ReservationListViewModel
@using EduLibrary.ViewModels
<section class="reservation-summary" id="reservation-summary"><div class="reservation-ledger-heading"><div><span class="section-caption">Кітапханадан алып кету</span><h2>Броньдарым мен кезегім</h2></div><a asp-controller="Reservations" asp-action="Index" class="text-link">Барлық броньдар <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div>
@if (Model.TotalCount == 0) { <div class="reservation-workflow-note"><i data-lucide="bookmark" aria-hidden="true"></i><p>Белсенді броньдарыңыз жоқ. Каталогтан қажетті кітапты алып кетуге брондаңыз немесе бос дананы күту кезегіне тұрыңыз. <a asp-controller="Books" asp-action="Index">Кітап таңдау</a></p></div> }
else { <p class="reservation-summary-counts">@Model.ReadyCount алып кетуге дайын · @Model.PendingCount дайындалуын күтуде · @Model.QueuedCount кезекте</p><div class="reservation-summary-list">@foreach (var reservation in Model.Items.Take(3)) { var cover = new BookCoverViewModel { BookId = reservation.BookId, Title = reservation.BookTitle, Authors = reservation.Authors, CoverImageUrl = reservation.CoverImageUrl, PublicationYear = reservation.PublicationYear, Size = "compact" }; <article class="reservation-summary-book" data-reservation-id="@reservation.Id" data-reservation-status="@reservation.Status"><partial name="_BookCover" model="cover" /><div><span class="reservation-status" data-status="@reservation.Status">@reservation.StatusLabel</span><h3><a asp-controller="Reservations" asp-action="Details" asp-route-id="@reservation.Id">@reservation.BookTitle</a></h3>@if (reservation.PickupAt.HasValue) { <p>@reservation.PickupAt.Value.ToString("dd.MM · HH:mm") · @reservation.PickupLocationName</p> }@if (reservation.QueuePosition.HasValue) { <p>Кезектегі орныңыз: @reservation.QueuePosition</p> }</div></article> }</div> }
</section>
