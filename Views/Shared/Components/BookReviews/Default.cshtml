@model EduLibrary.ViewModels.BookReviewsViewModel
<section id="reviews" class="card mt-4 reviews-section" aria-labelledby="reviews-heading">
    <div class="page-header"><div><p class="eyebrow">ОҚЫРМАНДАР ДАУЫСЫ</p><h2 id="reviews-heading">Пікірлер мен бағалар</h2><p class="text-muted">Оқу тәжірибеңізбен бөлісіп, басқа оқырмандарға таңдау жасауға көмектесіңіз.</p></div><div class="rating-summary"><strong>@Model.AverageRating.ToString("0.0") <span aria-hidden="true">★</span></strong><span class="text-muted">@Model.ReviewCount пікір</span></div></div>
    @if (Model.OwnReview is not null)
    {
        <div class="note-block mb-4"><div class="actions"><strong>Сіздің пікіріңіз</strong><span class="badge @(Model.OwnReview.IsHidden ? "badge-warning" : "badge-success")">@(Model.OwnReview.IsHidden ? "Модератор жасырған" : "Жарияланған")</span><a asp-controller="Reviews" asp-action="Edit" asp-route-id="@Model.OwnReview.Id" class="btn btn-sm btn-outline-secondary">Өзгерту</a></div>
        @if (Model.OwnReview.IsHidden) { <p class="mt-2 preserve-lines">@Model.OwnReview.Comment</p><p class="text-muted small">Бұл пікір жалпы рейтингке қосылмайды. Өзгерткеннен кейін де модератордың шешімі сақталады.</p> }
        </div>
    }
    else if (Model.CanWrite) { <a asp-controller="Reviews" asp-action="Create" asp-route-bookId="@Model.BookId" class="btn btn-primary mb-4"><i data-lucide="message-square-plus" aria-hidden="true"></i> Пікір жазу</a> }
    else if (User.Identity?.IsAuthenticated != true) { <p class="text-muted"><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"/Books/Details/{Model.BookId}#reviews")">Жүйеге кіріңіз</a> және студент аккаунтымен кітапты бағалаңыз.</p> }
    @if (User.IsInRole("Admin")) { <a asp-controller="Reviews" asp-action="Index" asp-route-bookId="@Model.BookId" class="btn btn-outline-secondary mb-3">Пікірлерді модерациялау</a> }
    @if (Model.Reviews.Count == 0)
    {
        <div class="empty-state"><i data-lucide="messages-square" aria-hidden="true"></i><h3>Әзірге жария пікір жоқ</h3><p>Кітаптан алған әсеріңізді бірінші болып бөлісіңіз.</p></div>
    }
    else
    {
        <div class="review-list">
        @foreach (var review in Model.Reviews)
        {
            <article class="review-item"><div class="actions"><strong>@review.ReviewerLabel</strong><span class="review-stars" aria-label="@review.Rating / 5 жұлдыз">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span><time class="text-muted small" datetime="@review.CreatedAt.ToString("O")">@review.CreatedAt.ToString("dd.MM.yyyy")</time></div>@if (!string.IsNullOrWhiteSpace(review.Comment)) { <p class="preserve-lines mt-2">@review.Comment</p> }@if (review.UpdatedAt.HasValue) { <small class="text-muted">Өзгертілген</small> }</article>
        }
        </div>
        @if (Model.TotalPages > 1) { <nav class="actions mt-3" aria-label="Пікір беттері">@if (Model.Page > 1) { <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" asp-route-reviewPage="@(Model.Page - 1)" asp-fragment="reviews" class="btn btn-sm btn-outline-secondary">Алдыңғы</a> }<span class="text-muted">@Model.Page / @Model.TotalPages</span>@if (Model.Page < Model.TotalPages) { <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" asp-route-reviewPage="@(Model.Page + 1)" asp-fragment="reviews" class="btn btn-sm btn-outline-secondary">Келесі</a> }</nav> }
    }
</section>
