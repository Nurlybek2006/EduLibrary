@{ var staff = User.IsInRole("Admin") || User.IsInRole("Librarian"); }
<div class="dropdown user-menu"><button class="avatar profile-menu-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Жеке кабинет мәзірі"><i data-lucide="user-round"></i></button>
    <div class="dropdown-menu dropdown-menu-end profile-dropdown"><span class="dropdown-title user-identity">@User.Identity?.Name</span>
        @if (User.IsInRole("Student")) { <a class="dropdown-item" asp-controller="ReadingSpace" asp-action="Index"><i data-lucide="armchair"></i>Менің оқу кеңістігім</a> }
        <a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i data-lucide="user-round"></i>Профиль</a>
        <a class="dropdown-item" asp-controller="Recommendations" asp-action="@(staff ? "Index" : "Preferences")"><i data-lucide="sliders-horizontal"></i>Қызығушылықтар</a>
        <a class="dropdown-item" asp-controller="Notifications" asp-action="Index"><i data-lucide="bell"></i>Хабарландырулар</a>
        @if (!staff) { <a class="dropdown-item" asp-controller="Fines" asp-action="Index"><i data-lucide="receipt-text"></i>Айыппұлдар</a> }
        <div class="dropdown-divider"></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item" type="submit"><i data-lucide="log-out"></i>Шығу</button></form>
    </div>
</div>
