@{ var staff = User.IsInRole("Admin") || User.IsInRole("Librarian"); }
<div class="dropdown user-menu"><button class="avatar profile-menu-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@T["Account menu"]">@await Component.InvokeAsync("Avatar", new { size = "small" })</button>
    <div class="dropdown-menu dropdown-menu-end profile-dropdown"><span class="dropdown-title user-identity">@User.Identity?.Name</span>
        @if (User.IsInRole("Student")) { <a class="dropdown-item" asp-controller="ReadingSpace" asp-action="Index"><i data-lucide="armchair"></i>@T["My reading space"]</a><a class="dropdown-item" asp-controller="DigitalLibrary" asp-action="My"><i data-lucide="tablet"></i>@T["My digital books"]</a> }
        <a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i data-lucide="user-round"></i>@T["Profile"]</a>
        @if (staff || User.IsInRole("Student")) { <a class="dropdown-item" asp-controller="Reservations" asp-action="Index"><i data-lucide="bookmark-check"></i>@T[staff ? "Manage reservations" : "My reservations"]</a> }
        <a class="dropdown-item" asp-controller="Recommendations" asp-action="@(staff ? "Index" : "Preferences")"><i data-lucide="sliders-horizontal"></i>@T["Interests"]</a>
        <a class="dropdown-item" asp-controller="Notifications" asp-action="Index"><i data-lucide="bell"></i>@T["Notifications"]</a>
        @if (!staff) { <a class="dropdown-item" asp-controller="Fines" asp-action="Index"><i data-lucide="receipt-text"></i>@T["Fines"]</a> }
        <div class="dropdown-divider"></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item" type="submit"><i data-lucide="log-out"></i>@T["Sign out"]</button></form>
    </div>
</div>
