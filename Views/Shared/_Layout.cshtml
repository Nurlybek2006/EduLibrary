@{ var staff = User.IsInRole("Admin") || User.IsInRole("Librarian"); }
<!DOCTYPE html>
<html lang="kk" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#18382F" />
    <title>@ViewData["Title"] · EduLibrary</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="preload" href="~/fonts/manrope-cyrillic-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/manrope-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body class="@(staff ? "staff-workspace" : "reader-workspace")">
<a class="skip-link" href="#main-content">Мазмұнға өту</a>
@if (staff) { <partial name="_AdminNavigation" /> }
<div class="workspace-shell">
    <partial name="_AppHeader" />
    <main id="main-content" class="main-content" tabindex="-1">
        <partial name="_FlashMessages" />
        @RenderBody()
        <footer class="library-footer"><a asp-controller="Books" asp-action="Index">EduLibrary<span>Білімге құштар қауымдастық.</span></a><div><a asp-controller="Home" asp-action="Privacy">Құпиялылық</a><span>Университеттің цифрлық кітапханасы</span></div></footer>
    </main>
</div>
<button class="navigation-backdrop" id="navigation-backdrop" type="button" aria-label="Мәзірді жабу" tabindex="-1"></button>
<dialog id="confirm-dialog" class="confirm-dialog"><form method="dialog"><span class="confirm-icon"><i data-lucide="circle-help"></i></span><h2>Әрекетті растау</h2><p id="confirm-message">Жалғастырғыңыз келе ме?</p><div class="actions"><button class="btn btn-light" value="cancel">Бас тарту</button><button class="btn btn-primary" value="confirm">Растау</button></div></form></dialog>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/lucide/lucide.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
