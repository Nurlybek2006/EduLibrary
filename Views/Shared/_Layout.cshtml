@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var staff = User.IsInRole("Admin") || User.IsInRole("Librarian");
    string Active(string name) => controller == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="kk" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · EduLibrary</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Мазмұнға өту</a>
<div class="sidebar-backdrop" id="sidebar-backdrop"></div>
<aside class="sidebar" id="sidebar" aria-label="Негізгі мәзір">
    <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon"><i data-lucide="library-big"></i></span><span>EduLibrary<small>УНИВЕРСИТЕТ КІТАПХАНАСЫ</small></span></a>
    <div class="workspace-label"><span class="workspace-dot"></span> Академиялық кеңістік <i data-lucide="chevrons-up-down"></i></div>
    <nav class="sidebar-nav">
        <span class="nav-section">КІТАПХАНА</span>
        @if(staff) { <a class="@Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i data-lucide="layout-dashboard"></i>Басқару тақтасы</a> }
        <a class="@Active("Books")" asp-controller="Books" asp-action="Index"><i data-lucide="book-open"></i>Кітаптар каталогы</a>
        @if(staff) {
            <a class="@Active("Authors")" asp-controller="Authors" asp-action="Index"><i data-lucide="feather"></i>Авторлар</a>
            <a class="@Active("Publishers")" asp-controller="Publishers" asp-action="Index"><i data-lucide="building-2"></i>Баспалар</a>
            <a class="@Active("Categories")" asp-controller="Categories" asp-action="Index"><i data-lucide="shapes"></i>Санаттар</a>
            <a class="@Active("Copies")" asp-controller="Copies" asp-action="Index"><i data-lucide="layers"></i>Кітап даналары</a>
        }
        @if(User.Identity?.IsAuthenticated == true) {
            <span class="nav-section">БАСҚАРУ</span>
            @if(staff) { <a class="@Active("Students")" asp-controller="Students" asp-action="Index"><i data-lucide="graduation-cap"></i>Студенттер</a> }
            <a class="@Active("Loans")" asp-controller="Loans" asp-action="Index"><i data-lucide="arrow-up-right"></i>@(staff ? "Кітап беру" : "Менің кітаптарым")</a>
            @if(staff) { <a class="@Active("Returns")" asp-controller="Returns" asp-action="Index"><i data-lucide="arrow-down-left"></i>Қайтарулар</a> }
            <a class="@Active("Fines")" asp-controller="Fines" asp-action="Index"><i data-lucide="wallet"></i>Айыппұлдар</a>
            <span class="nav-section">ИНТЕЛЛЕКТ</span>
            <a asp-controller="Home" asp-action="Intelligence" asp-route-section="recommendations"><i data-lucide="sparkles"></i>AI ұсыныстары<span class="soon-tag">Жақында</span></a>
            @if(staff) {
                <a asp-controller="Home" asp-action="Intelligence" asp-route-section="analytics"><i data-lucide="chart-no-axes-combined"></i>Талдау</a>
                <a asp-controller="Home" asp-action="Intelligence" asp-route-section="reports"><i data-lucide="file-chart-column"></i>Есептер</a>
            }
        }
    </nav>
    <div class="sidebar-bottom">
        @if(User.IsInRole("Admin")) {
            <a class="@Active("Staff")" asp-controller="Staff" asp-action="Index"><i data-lucide="shield-check"></i>Қызметкерлер</a>
            <a asp-controller="Home" asp-action="Settings"><i data-lucide="settings-2"></i>Баптаулар</a>
        }
        @if(User.Identity?.IsAuthenticated == true) {
            <a class="profile-link" asp-controller="Account" asp-action="Profile"><span class="avatar"><i data-lucide="user-round"></i></span><span>Жеке кабинет<small>@User.Identity.Name</small></span><i data-lucide="chevron-right"></i></a>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="logout-button" type="submit"><i data-lucide="log-out"></i>Шығу</button></form>
        } else { <a asp-controller="Account" asp-action="Login"><i data-lucide="log-in"></i>Жүйеге кіру</a> }
    </div>
</aside>
<div class="app-shell">
    <header class="topbar">
        <div class="topbar-location"><button class="icon-button mobile-menu" id="menu-toggle" type="button" aria-label="Мәзірді ашу" aria-controls="sidebar" aria-expanded="false"><i data-lucide="menu"></i></button><span class="breadcrumb-home">Кітапхана</span><i data-lucide="chevron-right"></i><strong>@ViewData["Title"]</strong></div>
        <div class="topbar-actions"><span class="semester-label"><span class="workspace-dot"></span>Оқу кеңістігі</span><button type="button" class="icon-button" id="theme-toggle" aria-label="Түс режимін ауыстыру"><i data-lucide="sun-moon"></i></button>
        @if(User.Identity?.IsAuthenticated != true) { <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Кіру <i data-lucide="arrow-right"></i></a> }
        </div>
    </header>
    <main id="main-content" class="main-content">
        @if(TempData["Success"] is string success) { <div class="toast-notice success-notice" role="status"><i data-lucide="circle-check"></i>@success<button type="button" aria-label="Хабарламаны жабу" data-dismiss-notice>×</button></div> }
        @if(TempData["Error"] is string error) { <div class="toast-notice error-notice" role="alert"><i data-lucide="circle-alert"></i>@error<button type="button" aria-label="Хабарламаны жабу" data-dismiss-notice>×</button></div> }
        @RenderBody()
        <footer class="app-footer"><span>EduLibrary <span class="footer-dot">·</span> Білімге ашылған жол</span><span>Академиялық кітапхана жүйесі</span></footer>
    </main>
</div>
<dialog id="confirm-dialog" class="confirm-dialog"><form method="dialog"><span class="confirm-icon"><i data-lucide="circle-help"></i></span><h2>Әрекетті растау</h2><p id="confirm-message">Жалғастырғыңыз келе ме?</p><div class="actions"><button class="btn btn-light" value="cancel">Бас тарту</button><button class="btn btn-primary" value="confirm">Растау</button></div></form></dialog>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/lucide/lucide.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
