@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Current(string name) => controller == name ? "current" : "";
}
<aside class="management-rail" id="management-navigation" aria-label="@T["Қызметкер навигациясы"]">
    <a class="rail-emblem" asp-controller="Dashboard" asp-action="Index" aria-label="@T["EduLibrary басқару"]"><span>E<span>.</span></span></a>
    <nav>
        <a class="rail-link @Current("Dashboard")" asp-controller="Dashboard" asp-action="Index" aria-label="@T["Басқару шолуы"]"><i data-lucide="panels-top-left"></i><span>@T["Шолу"]</span></a>
        <a class="rail-link @Current("Books")" asp-controller="Books" asp-action="Index" aria-label="@T["Кітаптар каталогы"]"><i data-lucide="book-open"></i><span>@T["Каталог"]</span></a>
        <a class="rail-link @Current("DigitalLibrary")" asp-controller="DigitalLibrary" asp-action="Manage" aria-label="@T["Manage digital content"]"><i data-lucide="tablet"></i><span>PDF / EPUB</span></a>
        <a class="rail-link @Current("Reservations")" asp-controller="Reservations" asp-action="Index" aria-label="@T["Кітап броньдары мен алып кету"]"><i data-lucide="bookmark-check"></i><span>@T["Броньдар"]</span></a>
        <a class="rail-link @Current("Loans")" asp-controller="Loans" asp-action="Index" aria-label="@T["Кітап беру"]"><i data-lucide="arrow-up-right"></i><span>@T["Беру"]</span></a>
        <a class="rail-link @Current("Returns")" asp-controller="Returns" asp-action="Index" aria-label="@T["Қайтарулар"]"><i data-lucide="arrow-down-left"></i><span>@T["Қайтару"]</span></a>
        <a class="rail-link @Current("Students")" asp-controller="Students" asp-action="Index" aria-label="@T["Студенттер"]"><i data-lucide="users-round"></i><span>@T["Оқырман"]</span></a>
        <a class="rail-link @Current("Fines")" asp-controller="Fines" asp-action="Index" aria-label="@T["Айыппұлдар"]"><i data-lucide="receipt-text"></i><span>@T["Төлем"]</span></a>
        <span class="rail-divider"></span>
        <a class="rail-link @Current("Copies")" asp-controller="Copies" asp-action="Index" aria-label="@T["Кітап даналары және QR іздеу"]"><i data-lucide="scan-line"></i><span>@T["Даналар"]</span></a>
        <a class="rail-link @Current("Authors")" asp-controller="Authors" asp-action="Index" aria-label="@T["Авторлар"]"><i data-lucide="feather"></i><span>@T["Автор"]</span></a>
        <a class="rail-link @Current("Publishers")" asp-controller="Publishers" asp-action="Index" aria-label="@T["Баспалар"]"><i data-lucide="building-2"></i><span>@T["Баспа"]</span></a>
        <a class="rail-link @Current("Categories")" asp-controller="Categories" asp-action="Index" aria-label="@T["Санаттар"]"><i data-lucide="tags"></i><span>@T["Санат"]</span></a>
        <span class="rail-divider"></span>
        <a class="rail-link @Current("Recommendations")" asp-controller="Recommendations" asp-action="Index" aria-label="@T["Жеке ұсыныстар"]"><i data-lucide="sparkles"></i><span>@T["Ұсыныс"]</span></a>
        <a class="rail-link @Current("Analytics")" asp-controller="Analytics" asp-action="Index" aria-label="@T["Талдау"]"><i data-lucide="chart-no-axes-combined"></i><span>@T["Талдау"]</span></a>
        <a class="rail-link @Current("Reports")" asp-controller="Reports" asp-action="Index" aria-label="@T["Есептер"]"><i data-lucide="files"></i><span>@T["Есептер"]</span></a>
        @if (User.IsInRole("Admin")) {
            <span class="rail-divider"></span>
            <a class="rail-link @Current("Staff")" asp-controller="Staff" asp-action="Index" aria-label="@T["Қызметкерлер"]"><i data-lucide="shield-check"></i><span>@T["Топ"]</span></a>
            <a class="rail-link @Current("Reviews")" asp-controller="Reviews" asp-action="Index" aria-label="@T["Пікірлерді тексеру"]"><i data-lucide="message-square-text"></i><span>@T["Пікір"]</span></a>
            <a class="rail-link @(controller == "Home" ? "current" : "")" asp-controller="Home" asp-action="Settings" aria-label="@T["Кітапхана саясаты"]"><i data-lucide="settings-2"></i><span>@T["Саясат"]</span></a>
        }
    </nav>
</aside>

