@model EduLibrary.ViewModels.AnalyticsViewModel
@using System.Text.Json
@{ ViewData["Title"] = "Кеңейтілген талдау"; }
<div class="workspace-page analytics-workspace index-workspace">
<div class="page-header workspace-heading"><div><span class="eyebrow">КІТАПХАНА АНАЛИТИКАСЫ</span><h1>Кеңейтілген талдау</h1><p id="analytics-period">@Model.StartDate.ToString("dd.MM.yyyy") – @Model.EndDate.ToString("dd.MM.yyyy")</p></div><a class="btn btn-secondary" asp-controller="Reports" asp-action="Index"><i data-lucide="file-chart-column"></i> Есептерді ашу</a></div>
<form method="get" class="card ledger-panel report-filter no-print" id="analytics-filter" data-report-filter data-endpoint="@Url.Action("Data")"><div class="form-grid"><partial name="~/Views/Reports/_PeriodFilter.cshtml" model="Model.Filter" /></div><div class="actions"><button class="btn btn-primary" type="submit"><i data-lucide="refresh-cw"></i> Кезеңді қолдану</button><a class="btn btn-secondary" asp-action="Index">Тазарту</a><span id="analytics-status" role="status" aria-live="polite"></span></div></form>
<p class="text-muted">Қор мен ағымдағы берешек — бүгінгі жағдай. Белсенді оқырмандар, төлемдер және рейтинг — таңдалған кезең бойынша.</p>
<div class="stat-grid" id="analytics-statistics">@foreach(var metric in Model.Statistics) { <div class="stat-card"><span>@metric.Label</span><strong>@metric.Value</strong><small class="text-muted">@metric.Hint</small></div> }</div>
<div class="dashboard-grid analytics-grid" id="analytics-charts">@foreach(var chart in Model.Charts) { <section class="card ledger-panel chart-card"><div class="card-header section-heading"><div><h2>@chart.Title</h2><p class="text-muted">@chart.Description</p></div></div><div class="chart-container"><canvas id="chart-@chart.Id" role="img" aria-label="@chart.Title"></canvas><p class="empty-state chart-empty" id="empty-@chart.Id" hidden="@chart.HasData">Осы кезеңде деректер жоқ.</p></div><details class="chart-data"><summary>Деректерді кестемен көру</summary><div class="table-responsive"><table class="table data-ledger"><thead><tr><th>Атауы / кезең</th><th>Мәні</th></tr></thead><tbody id="data-@chart.Id">@for(var index = 0; index < chart.Labels.Length; index++) { <tr><td>@chart.Labels[index]</td><td>@chart.Values[index].ToString(chart.IsRating ? "0.00" : "N0")</td></tr> }</tbody></table></div></details></section> }</div>
<script type="application/json" id="analytics-data">@Html.Raw(JsonSerializer.Serialize(Model, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
</div>
@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js" asp-append-version="true"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>
    <script src="~/js/analytics.js" asp-append-version="true"></script>
}
