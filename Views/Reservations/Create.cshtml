@model EduLibrary.ViewModels.ReservationCreateViewModel
@using EduLibrary.ViewModels
@using System.Globalization
@{ ViewData["Title"] = Model.JoinQueue ? "Кітап кезегіне тұру" : "Кітапты брондау"; var cover = new BookCoverViewModel { BookId = Model.BookId, Title = Model.BookTitle, Authors = Model.Authors, CoverImageUrl = Model.CoverImageUrl, PublicationYear = Model.PublicationYear, Size = "shelf" }; }
<section class="reservation-page"><header class="reservation-heading"><div><span class="section-caption">Кітапханадан алып кету</span><h1>@ViewData["Title"]</h1><p>@(Model.JoinQueue ? "Бос дана шыққанда өтінімдер түскен ретімен орындалады." : "Кітапханаға келетін күніңіз бен уақытыңызды таңдаңыз.")</p></div><a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">Кітапқа оралу</a></header>
<div class="reservation-workflow-note"><i data-lucide="info" aria-hidden="true"></i><p>@(Model.JoinQueue ? "Кезек келгенде жүйе бос дананы және қолжетімді алып кету уақытын бөледі. Хабарламада нақты күн мен уақыт көрсетіледі." : "Бронь кітапханашының дайындауын күтеді. Кітап дайын болғаны туралы хабарламадан кейін оны кітапханадан алып кете аласыз.") Бронь жасау кітап беру болып есептелмейді.</p></div>
@if (!Model.JoinQueue) { <noscript><form asp-action="Create" method="get" class="reservation-slot-refresh" id="reservation-slot-refresh-form"><input type="hidden" name="bookId" value="@Model.BookId" /><p>Басқа күннің уақыттарын көру үшін орын мен күнді таңдап, тізімді жаңартыңыз. Содан кейін төмендегі нысанда бос уақытты таңдаңыз.</p><div class="form-grid"><div><label for="refresh-location">Алып кету орны</label><select name="pickupLocationId" id="refresh-location" class="form-select">@foreach (var location in Model.Locations) { <option value="@location.Value" selected="@(location.Value == Model.PickupLocationId)">@location.Text</option> }</select></div><div><label for="refresh-date">Алып кету күні</label><select name="pickupDate" id="refresh-date" class="form-select">@foreach (var day in Model.PickupDates) { <option value="@day.Value" selected="@(day.Value == Model.PickupDate?.ToString("yyyy-MM-dd"))" disabled="@day.Disabled">@day.Text</option> }</select></div></div><button class="btn btn-outline-secondary" type="submit">Уақыттарды жаңарту</button></form></noscript> }
<div class="reservation-form-grid"><form asp-action="Create" method="post" class="reservation-form-panel" id="reservation-create-form" data-slots-url="@Url.Action("Slots")" data-queue="@Model.JoinQueue.ToString().ToLowerInvariant()"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><input asp-for="BookId" type="hidden" /><input name="JoinQueue" value="@Model.JoinQueue.ToString().ToLowerInvariant()" type="hidden" /><h2>@(Model.JoinQueue ? "Кезекке қосылу" : "Алып кету уақытын таңдаңыз")</h2><p>@(Model.JoinQueue ? "Алып кету орнын көрсетіп, кезекке қосылғаныңызды растаңыз." : "Тек кітапхананың жұмыс кестесі мен бос орындары бар уақыттар көрсетіледі.")</p>
    <div class="form-group"><label asp-for="PickupLocationId"></label><select asp-for="PickupLocationId" asp-items="Model.Locations" class="form-select" required><option value="">Алып кету орнын таңдаңыз</option></select><span asp-validation-for="PickupLocationId" class="text-danger"></span></div>
    @if (!Model.JoinQueue)
    {
        <div class="form-grid"><div class="form-group"><label asp-for="PickupDate"></label><select name="PickupDate" id="PickupDate" class="form-select" required><option value="">Күнді таңдаңыз</option>@foreach (var day in Model.PickupDates) { var selected = DateTime.TryParse(day.Value, CultureInfo.InvariantCulture, DateTimeStyles.None, out var value) && value.Date == Model.PickupDate?.Date; <option value="@day.Value" selected="@selected" disabled="@day.Disabled">@day.Text</option> }</select><span asp-validation-for="PickupDate" class="text-danger"></span></div><div class="form-group"><label asp-for="PickupTime"></label><select asp-for="PickupTime" class="form-select" required><option value="">Уақытты таңдаңыз</option>@foreach (var slot in Model.Slots) { <option value="@slot.Value" disabled="@(slot.AvailableCapacity <= 0)">@slot.Label</option> }</select><span asp-validation-for="PickupTime" class="text-danger"></span></div></div><p id="reservation-slot-status" class="reservation-slot-status" role="status" aria-live="polite">@(!Model.Slots.Any(s => s.AvailableCapacity > 0) ? "Күнді және алып кету орнын таңдаңыз немесе басқа күнді қараңыз." : "Қолжетімді уақытты таңдаңыз. Орын бронь расталғанда қайта тексеріледі.")</p>
    }
    <div class="form-actions actions"><button type="submit" class="btn btn-primary" id="reservation-submit"><i data-lucide="@(Model.JoinQueue ? "list-ordered" : "bookmark-check")" aria-hidden="true"></i>@(Model.JoinQueue ? "Кезекке тұруды растау" : "Брондауды растау")</button><a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">Бас тарту</a></div><p class="reservation-form-note">Кітапты тек кітапханашы сізге физикалық тапсырған кезде кітап беру жазбасы ашылады. Қажет болмаса, белсенді броньды жеке тізіміңізден тоқтата аласыз.</p>
</form><aside class="reservation-book-preview"><partial name="_BookCover" model="cover" /><h2>@Model.BookTitle</h2><p>@Model.Authors</p><p>@Model.AvailableCopies бос дана</p></aside></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/reservations.js" asp-append-version="true"></script> }
