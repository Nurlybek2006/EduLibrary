@model EduLibrary.ViewModels.ReservationDetailsViewModel
@using EduLibrary.ViewModels
@using EduLibrary.Models.Enums
@using System.Globalization
@{
    ViewData["Title"] = "Бронь туралы";
    var cover = new BookCoverViewModel { BookId = Model.BookId, Title = Model.BookTitle, Authors = Model.Authors, CoverImageUrl = Model.CoverImageUrl, PublicationYear = Model.PublicationYear, Size = "compact" };
    var active = Model.Status is ReservationStatus.Pending or ReservationStatus.ReadyForPickup or ReservationStatus.Queued;
    var dueDate = ViewData.ModelState.TryGetValue("DueDate", out var dueState) ? dueState.AttemptedValue : Model.FulfillForm.DueDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}
<section class="reservation-page" id="reservation-details" data-reservation-id="@Model.Id" data-reservation-status="@Model.Status">
<header class="reservation-heading"><div><span class="section-caption">Кітапханадан алып кету · № @Model.Id</span><h1>Бронь туралы</h1><p>@(Model.IsStaff ? "Кітапты дайындап, студент келгенде ғана беруді растаңыз." : "Бронь мәртебесін және кітапханаға келетін уақытыңызды осы жерден көре аласыз.")</p></div><a asp-action="Index" class="btn btn-outline-secondary">Броньдар тізіміне</a></header>
<div class="reservation-detail-grid"><div>
    <div class="reservation-detail-book"><partial name="_BookCover" model="cover" /><div><span class="reservation-status" data-status="@Model.Status">@Model.StatusLabel</span><h2><a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId">@Model.BookTitle</a></h2><p>@Model.Authors</p>@if (Model.PublicationYear > 0) { <p>@Model.PublicationYear жылғы басылым</p> }</div></div>
    @if (Model.Status == ReservationStatus.Queued) { <div class="reservation-workflow-note"><i data-lucide="list-ordered" aria-hidden="true"></i><p>Кезектегі орныңыз: <strong>@Model.QueuePosition</strong>. Бос дана мен алып кету уақыты бөлінгенде хабарлама келеді. Кезек өтінімнің түскен ретімен жылжиды.</p></div> }
    @if (Model.Status == ReservationStatus.Pending) { <div class="reservation-workflow-note"><i data-lucide="package" aria-hidden="true"></i><p>Кітапханашы кітапты дайындауда. Келмес бұрын «Алып кетуге дайын» хабарламасын күтіңіз.</p></div> }
    @if (Model.Status == ReservationStatus.ReadyForPickup) { <div class="reservation-workflow-note"><i data-lucide="bookmark-check" aria-hidden="true"></i><p>Кітап алып кетуге дайын. Белгіленген уақытта кітапханаға келіп, бронь кодын кітапханашыға көрсетіңіз.</p></div> }
    <dl class="reservation-detail-meta"><div><dt>Алып кету орны</dt><dd>@Model.PickupLocationName @if (!string.IsNullOrWhiteSpace(Model.PickupLocationAddress)) { <br />@Model.PickupLocationAddress }</dd></div><div><dt>Алып кету уақыты</dt><dd>@(Model.PickupAt?.ToString("dd.MM.yyyy · HH:mm") ?? "Кезек келгенде белгіленеді")</dd></div><div><dt>Бронь жасалған уақыт</dt><dd>@Model.CreatedAt.ToString("dd.MM.yyyy · HH:mm")</dd></div>@if (Model.ExpiresAt.HasValue) { <div><dt>@(active ? "Бронь жарамды" : "Бронь мерзімі")</dt><dd>@Model.ExpiresAt.Value.ToString("dd.MM.yyyy · HH:mm") дейін</dd></div> }@if (Model.IsStaff) { <div><dt>Оқырман</dt><dd>@Model.StudentName<br /><span class="text-muted">@Model.StudentNumber</span></dd></div> }@if (!string.IsNullOrWhiteSpace(Model.InventoryNumber)) { <div><dt>Кітап данасы</dt><dd>@Model.InventoryNumber @if (!string.IsNullOrWhiteSpace(Model.ShelfLocation)) { <br /><span class="text-muted">Сөре: @Model.ShelfLocation</span> }</dd></div> }@if (Model.ReadyAt.HasValue) { <div><dt>Дайындалған уақыт</dt><dd>@Model.ReadyAt.Value.ToString("dd.MM.yyyy · HH:mm")</dd></div> }</dl>
    @if (Model.CanPrepare) { <section class="reservation-ready-action"><h2>Кітапты дайындау</h2><p>Броньға бөлінген дананы тексеріп, алып кетуге дайын екенін белгілеңіз. Бұл қадамда кітап беру жазбасы ашылмайды.</p><a asp-action="Prepare" asp-route-id="@Model.Id" class="btn btn-primary" id="reservation-prepare-link"><i data-lucide="package-check" aria-hidden="true"></i> Дайындауды растау</a></section> }
    @if (Model.CanFulfill) {
        <section class="reservation-ready-action"><h2>Кітапты студентке беру</h2><p>Студенттің келгенін және кітапты қолына алғанын тексеріңіз. Ол көрсеткен бронь кодын енгізген соң ғана кітап беру жазбасы ашылады.</p>
        <form asp-action="Fulfill" method="post" id="reservation-fulfill-form" data-confirm="Студент кітапты қолына алды ма? Расталғанда кітап беру жазбасы ашылады."><div asp-validation-summary="All" class="text-danger" role="alert"></div><input name="Id" value="@Model.Id" type="hidden" /><input name="RowVersion" value="@Model.FulfillForm.RowVersion" type="hidden" /><div class="form-group"><label for="reservation-pickup-code">Студент көрсеткен бронь коды</label><input name="PickupCode" id="reservation-pickup-code" class="form-control" value="" required maxlength="100" autocomplete="off" spellcheck="false" placeholder="ELR-…" /><span class="text-danger">@Html.ValidationMessage("PickupCode")</span></div><div class="form-group"><label for="reservation-due-date">Қайтару мерзімі</label><input name="DueDate" id="reservation-due-date" type="date" class="form-control" value="@dueDate" required /><span class="text-danger">@Html.ValidationMessage("DueDate")</span></div><button type="submit" class="btn btn-primary" id="reservation-fulfill-submit"><i data-lucide="book-check" aria-hidden="true"></i> Кітапты қолына беруді растау</button></form></section>
    }
    @if (Model.LoanId.HasValue) { <div class="actions mt-4"><a asp-controller="Loans" asp-action="Details" asp-route-id="@Model.LoanId" class="btn btn-primary">Кітап беру жазбасын ашу <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div> }
    @if (Model.CanCancel) { <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" id="reservation-cancel-form" class="mt-4" data-confirm="Броньды тоқтатқыңыз келе ме? Кезектегі орныңыз бен бөлінген уақытыңыз босатылады."><input name="rowVersion" type="hidden" value="@Model.RowVersion" /><button type="submit" class="btn btn-outline-danger" id="reservation-cancel-submit">Броньды тоқтату</button></form> }
</div><aside>
    @if (!Model.IsStaff && active && !string.IsNullOrWhiteSpace(Model.PickupCode)) { <section class="reservation-code-panel"><h2>Сіздің алып кету кодыңыз</h2><p>Кітапханаға келгенде осы QR кодты немесе төмендегі кодты кітапханашыға көрсетіңіз.</p><img src="@Url.Action("Qr", new { id = Model.Id })" class="reservation-qr" alt="Осы броньның алып кету QR коды" width="210" height="210" /><code id="reservation-pickup-code-value">@Model.PickupCode</code><p>Кодты басқа адамға бермеңіз. Код тек осы броньға тиесілі; кітапты алу кезінде тексеріледі.</p></section> }
    else { <section class="reservation-code-panel"><h2>@(Model.IsStaff ? "Алып кету тәртібі" : "Бронь тарихы")</h2><p>@(Model.IsStaff ? "Дайындау → дайын екені туралы хабарлама → студенттің келуі → кодты тексеру → кітапты қолына беру." : "Осы бронь туралы мәліметтер тарихта сақталады. Келесі кітапты каталогтан таңдай аласыз.")</p>@if (Model.IsStaff) { <a asp-action="Lookup" class="btn btn-outline-secondary mt-3">Бронь кодын оқу</a> }else { <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary mt-3">Каталогқа өту</a> }</section> }
</aside></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
