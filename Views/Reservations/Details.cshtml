@model EduLibrary.ViewModels.ReservationDetailsViewModel
@using EduLibrary.ViewModels
@using EduLibrary.Models.Enums
@using System.Globalization
@{
    ViewData["Title"] = UiText.Get("Бронь туралы");
    var cover = new BookCoverViewModel { BookId = Model.BookId, Title = Model.BookTitle, Authors = Model.Authors, CoverImageUrl = Model.CoverImageUrl, PublicationYear = Model.PublicationYear, Size = "compact" };
    var active = Model.Status is ReservationStatus.Pending or ReservationStatus.ReadyForPickup or ReservationStatus.Queued;
    var dueDate = ViewData.ModelState.TryGetValue("DueDate", out var dueState) ? dueState.AttemptedValue : Model.FulfillForm.DueDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}
<section class="reservation-page" id="reservation-details" data-reservation-id="@Model.Id" data-reservation-status="@Model.Status">
<header class="reservation-heading"><div><span class="section-caption">@T["Кітапханадан алып кету · №"] @Model.Id</span><h1>@T["Бронь туралы"]</h1><p>@(Model.IsStaff ? UiText.Get("Кітапты дайындап, студент келгенде ғана беруді растаңыз.") : UiText.Get("Бронь мәртебесін және кітапханаға келетін уақытыңызды осы жерден көре аласыз."))</p></div><a asp-action="Index" class="btn btn-outline-secondary">@T["Броньдар тізіміне"]</a></header>
<div class="reservation-detail-grid"><div>
    <div class="reservation-detail-book"><partial name="_BookCover" model="cover" /><div><span class="reservation-status" data-status="@Model.Status">@Model.StatusLabel</span><h2><a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId">@Model.BookTitle</a></h2><p>@Model.Authors</p>@if (Model.PublicationYear > 0) { <p>@Model.PublicationYear @T["жылғы басылым"]</p> }</div></div>
    @if (Model.Status == ReservationStatus.Queued) { <div class="reservation-workflow-note"><i data-lucide="list-ordered" aria-hidden="true"></i><p>@T["Кезектегі орныңыз:"] <strong>@Model.QueuePosition</strong>@T[". Бос дана мен алып кету уақыты бөлінгенде хабарлама келеді. Кезек өтінімнің түскен ретімен жылжиды."]</p></div> }
    @if (Model.Status == ReservationStatus.Pending) { <div class="reservation-workflow-note"><i data-lucide="package" aria-hidden="true"></i><p>@T["Кітапханашы кітапты дайындауда. Келмес бұрын «Алып кетуге дайын» хабарламасын күтіңіз."]</p></div> }
    @if (Model.Status == ReservationStatus.ReadyForPickup) { <div class="reservation-workflow-note"><i data-lucide="bookmark-check" aria-hidden="true"></i><p>@T["Кітап алып кетуге дайын. Белгіленген уақытта кітапханаға келіп, бронь кодын кітапханашыға көрсетіңіз."]</p></div> }
    <dl class="reservation-detail-meta"><div><dt>@T["Алып кету орны"]</dt><dd>@Model.PickupLocationName @if (!string.IsNullOrWhiteSpace(Model.PickupLocationAddress)) { <br />@Model.PickupLocationAddress }</dd></div><div><dt>@T["Алып кету уақыты"]</dt><dd>@(Model.PickupAt?.ToString("g") ?? UiText.Get("Кезек келгенде белгіленеді"))</dd></div><div><dt>@T["Бронь жасалған уақыт"]</dt><dd>@Model.CreatedAt.ToString("g")</dd></div>@if (Model.ExpiresAt.HasValue) { <div><dt>@(active ? UiText.Get("Бронь жарамды") : UiText.Get("Бронь мерзімі"))</dt><dd>@Model.ExpiresAt.Value.ToString("g") @T["дейін"]</dd></div> }@if (Model.IsStaff) { <div><dt>@T["Оқырман"]</dt><dd>@Model.StudentName<br /><span class="text-muted">@Model.StudentNumber</span></dd></div> }@if (!string.IsNullOrWhiteSpace(Model.InventoryNumber)) { <div><dt>@T["Кітап данасы"]</dt><dd>@Model.InventoryNumber @if (!string.IsNullOrWhiteSpace(Model.ShelfLocation)) { <br /><span class="text-muted">@T["Сөре:"] @Model.ShelfLocation</span> }</dd></div> }@if (Model.ReadyAt.HasValue) { <div><dt>@T["Дайындалған уақыт"]</dt><dd>@Model.ReadyAt.Value.ToString("g")</dd></div> }</dl>
    @if (Model.CanPrepare) { <section class="reservation-ready-action"><h2>@T["Кітапты дайындау"]</h2><p>@T["Броньға бөлінген дананы тексеріп, алып кетуге дайын екенін белгілеңіз. Бұл қадамда кітап беру жазбасы ашылмайды."]</p><a asp-action="Prepare" asp-route-id="@Model.Id" class="btn btn-primary" id="reservation-prepare-link"><i data-lucide="package-check" aria-hidden="true"></i> @T["Дайындауды растау"]</a></section> }
    @if (Model.CanFulfill) {
        <section class="reservation-ready-action"><h2>@T["Кітапты студентке беру"]</h2><p>@T["Студенттің келгенін және кітапты қолына алғанын тексеріңіз. Ол көрсеткен бронь кодын енгізген соң ғана кітап беру жазбасы ашылады."]</p>
        <form asp-action="Fulfill" method="post" id="reservation-fulfill-form" data-confirm="@T["Студент кітапты қолына алды ма? Расталғанда кітап беру жазбасы ашылады."]"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input name="Id" value="@Model.Id" type="hidden" /><input name="RowVersion" value="@Model.FulfillForm.RowVersion" type="hidden" /><div class="form-group"><label for="reservation-pickup-code">@T["Студент көрсеткен бронь коды"]</label><input name="PickupCode" id="reservation-pickup-code" class="form-control" value="" required maxlength="100" autocomplete="off" spellcheck="false" placeholder="ELR-…" /><span class="text-danger">@Html.ValidationMessage("PickupCode")</span></div><div class="form-group"><label for="reservation-due-date">@T["Қайтару мерзімі"]</label><input name="DueDate" id="reservation-due-date" type="date" class="form-control" value="@dueDate" required /><span class="text-danger">@Html.ValidationMessage("DueDate")</span></div><button type="submit" class="btn btn-primary" id="reservation-fulfill-submit"><i data-lucide="book-check" aria-hidden="true"></i> @T["Кітапты қолына беруді растау"]</button></form></section>
    }
    @if (Model.LoanId.HasValue) { <div class="actions mt-4"><a asp-controller="Loans" asp-action="Details" asp-route-id="@Model.LoanId" class="btn btn-primary">@T["Кітап беру жазбасын ашу"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div> }
    @if (Model.CanCancel) { <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" id="reservation-cancel-form" class="mt-4" data-confirm="@T["Броньды тоқтатқыңыз келе ме? Кезектегі орныңыз бен бөлінген уақытыңыз босатылады."]"><input name="rowVersion" type="hidden" value="@Model.RowVersion" /><button type="submit" class="btn btn-outline-danger" id="reservation-cancel-submit">@T["Броньды тоқтату"]</button></form> }
</div><aside>
    @if (!Model.IsStaff && active && !string.IsNullOrWhiteSpace(Model.PickupCode)) { <section class="reservation-code-panel"><h2>@T["Сіздің алып кету кодыңыз"]</h2><p>@T["Кітапханаға келгенде осы QR кодты немесе төмендегі кодты кітапханашыға көрсетіңіз."]</p><img src="@Url.Action("Qr", new { id = Model.Id })" class="reservation-qr" alt="@T["Осы броньның алып кету QR коды"]" width="210" height="210" /><code id="reservation-pickup-code-value">@Model.PickupCode</code><p>@T["Keep this code private. It belongs to this reservation and is checked when you collect the book."]</p></section> }
    else { <section class="reservation-code-panel"><h2>@(Model.IsStaff ? UiText.Get("Алып кету тәртібі") : UiText.Get("Бронь тарихы"))</h2><p>@(Model.IsStaff ? UiText.Get("Дайындау → дайын екені туралы хабарлама → студенттің келуі → кодты тексеру → кітапты қолына беру.") : UiText.Get("Осы бронь туралы мәліметтер тарихта сақталады. Келесі кітапты каталогтан таңдай аласыз."))</p>@if (Model.IsStaff) { <a asp-action="Lookup" class="btn btn-outline-secondary mt-3">@T["Бронь кодын оқу"]</a> }else { <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary mt-3">@T["Каталогқа өту"]</a> }</section> }
</aside></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
