@model EduLibrary.ViewModels.ReservationListViewModel
@using EduLibrary.ViewModels
@{ ViewData["Title"] = Model.IsStaff ? UiText.Get("Броньдарды басқару") : UiText.Get("Менің броньдарым"); }
<section class="reservation-page" id="reservations-index">
<header class="reservation-heading"><div><span class="section-caption">@(Model.IsStaff ? UiText.Get("Кітапханадан алып кету") : UiText.Get("Келесі кітабыңызға бір қадам"))</span><h1>@ViewData["Title"]</h1><p>@(Model.IsStaff ? UiText.Get("Броньдарды дайындаңыз, кезекті бақылаңыз және студент келгенде кітапты тапсырыңыз.") : UiText.Get("Кітаптың дайындалуын бақылаңыз, кезектегі орныңызды қараңыз және алып кету кодын сақтаңыз."))</p></div><div class="actions">@if (Model.IsStaff) { <a asp-action="Lookup" class="btn btn-primary"><i data-lucide="scan-qr-code" aria-hidden="true"></i> @T["Бронь кодын тексеру"]</a> }else { <a asp-controller="Books" asp-action="Index" class="btn btn-primary">@T["Кітап таңдау"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a> }</div></header>
<div class="reservation-status-tabs" aria-label="@T["Бронь мәртебелері"]"><a asp-action="Index" asp-route-status="active" class="@(Model.Filter.Status == "active" ? "current" : "")">@T["Белсенді броньдар"]</a><a asp-action="Index" asp-route-status="Pending">@T["Дайындауды күтуде"] <span>@Model.PendingCount</span></a><a asp-action="Index" asp-route-status="ReadyForPickup">@T["Дайын"] <span>@Model.ReadyCount</span></a><a asp-action="Index" asp-route-status="Queued">@T["Кезекте"] <span>@Model.QueuedCount</span></a><a asp-action="Index" asp-route-status="all" class="@(Model.Filter.Status == "all" ? "current" : "")">@T["Барлық тарих"]</a></div>
<form asp-action="Index" method="get" class="reservation-filter-bar" role="search"><input name="BookId" type="hidden" value="@Model.Filter.BookId" />@if (Model.IsStaff) { <input name="StudentId" type="hidden" value="@Model.Filter.StudentId" /> }<div><label for="reservation-search">@T["Іздеу"]</label><input id="reservation-search" name="Search" value="@Model.Filter.Search" class="form-control" placeholder="@(Model.IsStaff ? UiText.Get("Кітап, студенттің аты немесе нөмірі") : UiText.Get("Кітап атауы"))" maxlength="200" /></div><div><label for="reservation-status">@T["Мәртебесі"]</label><select id="reservation-status" name="Status" class="form-select"><option value="active" selected="@(Model.Filter.Status == "active")">@T["Барлық белсенді бронь"]</option><option value="Pending" selected="@(Model.Filter.Status == "Pending")">@T["Дайындауды күтуде"]</option><option value="ReadyForPickup" selected="@(Model.Filter.Status == "ReadyForPickup")">@T["Алып кетуге дайын"]</option><option value="Queued" selected="@(Model.Filter.Status == "Queued")">@T["Кезекте"]</option><option value="Fulfilled" selected="@(Model.Filter.Status == "Fulfilled")">@T["Кітап берілді"]</option><option value="Cancelled" selected="@(Model.Filter.Status == "Cancelled")">@T["Тоқтатылған"]</option><option value="Expired" selected="@(Model.Filter.Status == "Expired")">@T["Мерзімі өткен"]</option><option value="all" selected="@(Model.Filter.Status == "all")">@T["Барлық мәртебе"]</option></select></div><button type="submit" class="btn btn-primary">@T["Іздеу"]</button><a asp-action="Index" class="btn btn-outline-secondary">@T["Тазарту"]</a></form>
<div class="reservation-ledger-heading"><h2>@(Model.IsStaff ? UiText.Get("Алып кету тізімі") : UiText.Get("Кітапханадағы өтінімдерім"))</h2><span>@Model.TotalCount @T["бронь"]</span></div>
@if (Model.Items.Count == 0)
{
    <div class="reservation-empty"><i data-lucide="bookmark" aria-hidden="true"></i><h2>@T["Броньдар табылмады"]</h2><p>@(Model.IsStaff ? UiText.Get("Таңдалған шарттарға сәйкес жазбалар жоқ. Жаңа броньдар осы жерде көрінеді.") : UiText.Get("Өзіңізге қажетті кітапты каталогтан тауып, алып кетуге брондаңыз немесе кезекке тұрыңыз."))</p><a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary">@T["Каталогты қарау"]</a></div>
}
else if (Model.IsStaff)
{
    <div class="table-responsive"><table class="table reservation-table"><thead><tr><th>@T["Кітап / оқырман"]</th><th>@T["Мәртебесі"]</th><th>@T["Алып кету"]</th><th>@T["Кезек / мерзім"]</th><th>@T["Әрекет"]</th></tr></thead><tbody>
    @foreach (var reservation in Model.Items)
    {
        var cover = new BookCoverViewModel { BookId = reservation.BookId, Title = reservation.BookTitle, Authors = reservation.Authors, CoverImageUrl = reservation.CoverImageUrl, PublicationYear = reservation.PublicationYear, Size = "compact" };
        <tr data-reservation-id="@reservation.Id" data-reservation-status="@reservation.Status"><td><div class="reservation-book-cell"><div class="reservation-mini-cover"><partial name="_BookCover" model="cover" /></div><div><h3><a asp-action="Details" asp-route-id="@reservation.Id">@reservation.BookTitle</a></h3><span class="reservation-student-name">@reservation.StudentName · @reservation.StudentNumber</span></div></div></td><td><span class="reservation-status" data-status="@reservation.Status">@reservation.StatusLabel</span></td><td>@reservation.PickupLocationName<div class="reservation-date-detail">@(reservation.PickupAt?.ToString("g") ?? UiText.Get("Кезек келгенде белгіленеді"))</div></td><td>@if (reservation.QueuePosition.HasValue) { <span class="reservation-queue-position">№ @reservation.QueuePosition</span> }else if (reservation.ExpiresAt.HasValue) { <span class="reservation-date-detail">@reservation.ExpiresAt.Value.ToString("g") @T["дейін"]</span> }else { <span class="text-muted">—</span> }</td><td><a asp-action="Details" asp-route-id="@reservation.Id" class="btn btn-sm btn-outline-secondary">@T["Броньды ашу"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></td></tr>
    }
    </tbody></table></div>
}
else
{
    <div class="reservation-student-list">
    @foreach (var reservation in Model.Items)
    {
        var cover = new BookCoverViewModel { BookId = reservation.BookId, Title = reservation.BookTitle, Authors = reservation.Authors, CoverImageUrl = reservation.CoverImageUrl, PublicationYear = reservation.PublicationYear, Size = "shelf" };
        <article class="reservation-student-card" data-reservation-id="@reservation.Id" data-reservation-status="@reservation.Status"><a asp-action="Details" asp-route-id="@reservation.Id" tabindex="-1" aria-hidden="true"><partial name="_BookCover" model="cover" /></a><div><span class="reservation-status" data-status="@reservation.Status">@reservation.StatusLabel</span><h2><a asp-action="Details" asp-route-id="@reservation.Id">@reservation.BookTitle</a></h2><p>@reservation.PickupLocationName @if (reservation.PickupAt.HasValue) { <span>· @reservation.PickupAt.Value.ToString("g")</span> }</p>@if (reservation.QueuePosition.HasValue) { <span class="reservation-queue-position">@T["Кезектегі орныңыз:"] @reservation.QueuePosition</span> }@if (reservation.ExpiresAt.HasValue) { <p>@reservation.ExpiresAt.Value.ToString("g") @T["дейін алып кетіңіз"]</p> }</div><div class="actions"><a asp-action="Details" asp-route-id="@reservation.Id" class="btn btn-outline-secondary">@T["Толығырақ"] <i data-lucide="arrow-right" aria-hidden="true"></i></a></div></article>
    }
    </div>
}
@if (Model.TotalPages > 1) { <nav class="reservation-pagination" aria-label="@T["Бронь беттері"]"><span>@Model.Filter.Page / @Model.TotalPages @T["бет"]</span><div class="actions">@if (Model.Filter.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Filter.Page - 1)" asp-route-search="@Model.Filter.Search" asp-route-status="@Model.Filter.Status" asp-route-bookId="@Model.Filter.BookId" asp-route-studentId="@Model.Filter.StudentId" class="btn btn-sm btn-outline-secondary">@T["Алдыңғы"]</a> }@if (Model.Filter.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Filter.Page + 1)" asp-route-search="@Model.Filter.Search" asp-route-status="@Model.Filter.Status" asp-route-bookId="@Model.Filter.BookId" asp-route-studentId="@Model.Filter.StudentId" class="btn btn-sm btn-outline-secondary">@T["Келесі"]</a> }</div></nav> }
</section>
