@model EduLibrary.ViewModels.ReservationReadyViewModel
@{ ViewData["Title"] = "Кітапты дайындау"; }
<section class="reservation-page"><header class="reservation-heading"><div><span class="section-caption">Броньды орындауға дайындау</span><h1>Кітапты дайындау</h1><p>@Model.BookTitle · @Model.StudentName</p></div><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Броньға оралу</a></header><div class="reservation-workflow-note"><i data-lucide="package-check" aria-hidden="true"></i><p>Броньға бөлінген немесе жүйе ұсынған дананы сөреден алып дайындаңыз. «Дайын» мәртебесі студентке хабарлама жібереді. Бұл қадамда кітап беру жазбасы құрылмайды.</p></div><form asp-action="MarkReady" method="post" class="reservation-form-panel" id="reservation-ready-form" data-confirm="Кітап сөреден алынып, студентке тапсыруға дайындалды ма?"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div class="form-group"><label asp-for="BookCopyId"></label><select asp-for="BookCopyId" asp-items="Model.CopyOptions" class="form-select" required><option value="">Дананы таңдаңыз</option></select><span asp-validation-for="BookCopyId" class="text-danger"></span></div>@if (Model.CopyOptions.Count == 0) { <p class="text-danger">Қазір таңдауға болатын дана жоқ. Кезек пен қор мәртебесін тексеріңіз.</p> }<div class="form-actions actions"><button type="submit" class="btn btn-primary" disabled="@(Model.CopyOptions.Count == 0)"><i data-lucide="check" aria-hidden="true"></i> Алып кетуге дайын</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Бас тарту</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
