@model EduLibrary.ViewModels.ReservationCodeLookupViewModel
@{ ViewData["Title"] = "Бронь кодын оқу"; }
<section class="reservation-page"><header class="reservation-heading"><div><span class="section-caption">Кітапханашы құралы</span><h1>Бронь кодын оқу</h1><p>Студент көрсеткен QR кодты сканерлеңіз немесе алып кету кодын енгізіңіз.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Броньдарға оралу</a></header>
<div class="reservation-lookup-grid" data-copy-scanner data-scan-success="Код оқылды. Бронь ізделуде…" data-scan-invalid="Бұл QR код бронь коды ретінде жарамсыз. Кодты қолмен енгізіңіз."><section class="reservation-lookup-panel"><h2>Код арқылы іздеу</h2><p>Кодты қолмен немесе USB сканермен енгізуге болады. Бронь ашылған соң кітапты беру бөлек расталады.</p><form asp-action="Lookup" method="post" id="copy-code-form" data-reservation-lookup-form><label asp-for="Code"></label><input asp-for="Code" id="copy-code" class="form-control" maxlength="100" autocomplete="off" spellcheck="false" autofocus placeholder="ELR-…" /><span asp-validation-for="Code" class="text-danger"></span><button type="submit" class="btn btn-primary mt-3"><i data-lucide="search" aria-hidden="true"></i> Броньды табу</button></form></section>
<section class="reservation-lookup-panel"><h2>Камерамен сканерлеу</h2><p>Камера өзіңіз қосқанда ғана іске қосылады. Камераға рұқсат болмаса, кодты сол жақтағы өріске енгізіңіз.</p><div class="scanner-preview"><video id="copy-scanner-video" playsinline muted hidden aria-label="Бронь QR код сканерінің камерасы"></video><div id="copy-scanner-idle"><i data-lucide="scan-qr-code" aria-hidden="true"></i><p>Студенттің бронь QR кодын камераға көрсетіңіз.</p></div></div><p id="copy-scanner-status" class="reservation-slot-status" role="status" aria-live="polite">Камера өшірулі. Кодты қолмен енгізуге болады.</p><div class="actions mt-3"><button type="button" class="btn btn-primary" id="copy-scanner-start"><i data-lucide="camera" aria-hidden="true"></i> Камераны қосу</button><button type="button" class="btn btn-outline-secondary" id="copy-scanner-stop" disabled>Тоқтату</button></div></section></div></section>
@section Scripts { <script src="~/lib/zxing/zxing-browser.min.js" asp-append-version="true"></script><script src="~/js/scanner.js" asp-append-version="true"></script><partial name="_ValidationScriptsPartial" /> }
