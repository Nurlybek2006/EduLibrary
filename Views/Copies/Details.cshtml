@model EduLibrary.ViewModels.CopyDetailsViewModel
@{ ViewData["Title"] = "Кітап данасының ақпараты"; }
<div class="page-header"><div><p class="eyebrow">ФИЗИКАЛЫҚ ДАНА</p><h1>@Model.BookTitle</h1><p class="text-muted">@Model.InventoryNumber · @Model.Barcode</p></div><div class="actions"><a asp-action="Lookup" class="btn btn-outline-secondary"><i data-lucide="scan-line" aria-hidden="true"></i> Код оқу</a><a asp-action="Index" class="btn btn-outline-secondary">Даналарға оралу</a></div></div>
@if (Model.BookArchived) { <div class="alert alert-warning">Кітап мұрағатта. Бұл дананы оқырманға беруге болмайды.</div> }
<div class="dashboard-grid">
    <section class="card"><div class="card-header"><h2>Түгендеу ақпараты</h2><span class="badge @(Model.CanIssue ? "badge-success" : "badge-warning")">@Model.StatusLabel</span></div><dl class="detail-grid"><div><dt>Кітап</dt><dd><a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId">@Model.BookTitle</a></dd></div><div><dt>ISBN</dt><dd>@Model.ISBN</dd></div><div><dt>Түгендеу нөмірі</dt><dd>@Model.InventoryNumber</dd></div><div><dt>Штрихкод</dt><dd><code>@Model.Barcode</code></dd></div><div><dt>Сөре</dt><dd>@Model.ShelfLocation</dd></div><div><dt>Жағдайы</dt><dd>@Model.Condition</dd></div><div><dt>Қабылданған күні</dt><dd>@Model.AcquiredAt.ToString("dd.MM.yyyy")</dd></div>@if (Model.ActiveLoanId.HasValue) { <div><dt>Қайтару мерзімі</dt><dd>@Model.DueDate?.ToString("dd.MM.yyyy")</dd></div> }</dl>
    <div class="actions mt-4">@if (Model.CanIssue) { <a asp-controller="Loans" asp-action="Create" asp-route-copyId="@Model.Id" class="btn btn-primary"><i data-lucide="arrow-up-right" aria-hidden="true"></i> Кітап беру</a> }@if (Model.CanReturn) { <a asp-controller="Returns" asp-action="Create" asp-route-id="@Model.ActiveLoanId" class="btn btn-primary"><i data-lucide="arrow-down-left" aria-hidden="true"></i> Қайтаруды рәсімдеу</a> }@if (!Model.ActiveLoanId.HasValue) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Өзгерту</a> }</div></section>
    <section class="card qr-card"><h2>Дананың QR коды</h2><img src="@Url.Action("Qr", new { id = Model.Id })" alt="@Model.InventoryNumber данасының QR коды" width="240" height="240" class="qr-image" /><p class="text-muted">QR код осы дананың бірегей штрихкодын қамтиды.</p><div class="actions"><a asp-action="Label" asp-route-id="@Model.Id" class="btn btn-primary"><i data-lucide="printer" aria-hidden="true"></i> Түгендеу жапсырмасы</a><a asp-action="Qr" asp-route-id="@Model.Id" class="btn btn-outline-secondary" download="edulibrary-copy-@(Model.Id).svg">QR жүктеу</a></div></section>
</div>
