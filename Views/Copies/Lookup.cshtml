@model EduLibrary.ViewModels.CopyLookupViewModel
@{ ViewData["Title"] = UiText.Get("QR / штрихкод оқу"); }
<div class="workspace-page copies-workspace index-workspace">
<div class="page-header workspace-heading"><div><p class="eyebrow">@T["Кітапханашы құралы"]</p><h1>@T["QR / штрихкод оқу"]</h1><p class="text-muted">@T["Кодты сканерлеңіз немесе түгендеу нөмірін енгізіп, кітап данасын бірден ашыңыз."]</p></div><a asp-action="Index" class="btn btn-outline-secondary">@T["Даналарға оралу"]</a></div>
<div class="dashboard-grid workspace-columns" data-copy-scanner>
    <section class="card ledger-panel"><h2>@T["Код арқылы іздеу"]</h2><p class="text-muted">@T["USB сканердің кодын да осы өріске енгізуге болады."]</p><form asp-action="Lookup" method="get" id="copy-code-form"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><label asp-for="Code"></label><input asp-for="Code" class="form-control" autocomplete="off" maxlength="100" id="copy-code" autofocus placeholder="@T["EDU000001001 немесе EL-0001-01"]" /><span asp-validation-for="Code" class="text-danger"></span><button type="submit" class="btn btn-primary mt-3"><i data-lucide="search" aria-hidden="true"></i> @T["Дананы табу"]</button></form><div class="note-block mt-4"><h3>@T["Келесі қадам"]</h3><p class="text-muted">@T["Дана ашылғанда, қолжетімді кітапты беруге немесе оқырмандағы кітапты қайтаруға болады. Әр операция бөлек расталады."]</p></div></section>
    <section class="card ledger-panel"><h2>@T["Камерамен сканерлеу"]</h2><p class="text-muted">@T["Камера тек «Камераны қосу» түймесін басқаннан кейін іске қосылады."]</p><div class="scanner-preview"><video id="copy-scanner-video" playsinline muted hidden aria-label="@T["QR код сканерінің камерасы"]"></video><div id="copy-scanner-idle"><i data-lucide="scan-qr-code" aria-hidden="true"></i><p>@T["Кітап данасының QR кодын камераға бағыттаңыз."]</p></div></div><p id="copy-scanner-status" class="text-muted mt-3" role="status" aria-live="polite">@T["Камера өшірулі. Кодты қолмен енгізу әрқашан қолжетімді."]</p><div class="actions"><button type="button" class="btn btn-primary" id="copy-scanner-start"><i data-lucide="camera" aria-hidden="true"></i> @T["Камераны қосу"]</button><button type="button" class="btn btn-outline-secondary" id="copy-scanner-stop" disabled>@T["Тоқтату"]</button></div></section>
</div>
</div>
@section Scripts { <script src="~/lib/zxing/zxing-browser.min.js" asp-append-version="true"></script><script src="~/js/scanner.js" asp-append-version="true"></script><partial name="_ValidationScriptsPartial" /> }
