@model EduLibrary.ViewModels.CopiesIndexViewModel
@using EduLibrary.ViewModels
@using EduLibrary.Models.Enums
@{ ViewData["Title"] = UiText.Get("Кітап даналары"); }
<div class="workspace-page copies-workspace index-workspace">
<div class="page-header workspace-heading"><div><p class="eyebrow">@T["Кітапхана қоры"]</p><h1>@T["Физикалық даналар"]</h1><p class="text-muted">@T["Қорда"] @Model.TotalCount @T["дана. Түгендеу, сөре және жағдай мәліметтері."]</p></div><a asp-action="Create" asp-route-bookId="@Model.BookId" class="btn btn-primary"><i data-lucide="plus" aria-hidden="true"></i> @T["Дана қосу"]</a></div>
<form method="get" class="card ledger-panel filter-card ledger-toolbar-pane mb-4" role="search"><input type="hidden" name="bookId" value="@Model.BookId" /><div class="form-grid"><div class="form-group"><label for="copy-search">@T["Дана іздеу"]</label><input id="copy-search" name="search" value="@Model.Search" class="form-control" placeholder="@T["Түгендеу нөмірі, штрихкод, кітап"]" maxlength="200" /></div><div class="form-group"><label for="copy-status">@T["Мәртебесі"]</label><select id="copy-status" name="status" class="form-select"><option value="">@T["Барлық мәртебелер"]</option>@foreach (var option in CatalogLabels.CopyStatuses()) { <option value="@option.Value" selected="@(option.Value == ((int?)Model.Status)?.ToString())">@option.Text</option> }</select></div></div><div class="actions mt-3"><button type="submit" class="btn btn-primary">@T["Іздеу"]</button><a asp-action="Index" class="btn btn-outline-secondary">@T["Тазарту"]</a>@if (Model.BookId.HasValue) { <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">@T["Кітапқа оралу"]</a> }</div></form>
<div class="card ledger-panel inventory-ledger">
<div class="ledger-caption"><div><span class="workspace-kicker">@T["Әр дананың өз орны бар"]</span><h2>@T["Түгендеу тізілімі"]</h2></div><a class="quiet-link" asp-action="Lookup"><i data-lucide="scan-line"></i> @T["Код арқылы табу"]</a></div>
@if (Model.Copies.Count == 0) { <div class="empty-state"><i data-lucide="library" aria-hidden="true"></i><h2>@T["Даналар табылмады"]</h2><p>@T["Іздеу шарттарын өзгертіңіз немесе жаңа дана тіркеңіз."]</p><a asp-action="Create" asp-route-bookId="@Model.BookId" class="btn btn-primary">@T["Дана қосу"]</a></div> }
else
{
    <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>@T["Кітап / түгендеу нөмірі"]</th><th>@T["Штрихкод"]</th><th>@T["Сөре / жағдайы"]</th><th>@T["Мәртебесі"]</th><th>@T["Әрекеттер"]</th></tr></thead><tbody>
    @foreach (var copy in Model.Copies)
    {
        <tr><td><a asp-controller="Books" asp-action="Details" asp-route-id="@copy.BookId"><strong>@copy.BookTitle</strong></a><div class="text-muted small"><a asp-action="Details" asp-route-id="@copy.Id">@copy.InventoryNumber</a></div></td><td><code>@copy.Barcode</code><div class="text-muted small">@copy.AcquiredAt.ToString("d")</div></td><td>@copy.ShelfLocation<div class="text-muted small">@copy.Condition</div></td><td><span class="badge @(copy.Status == CopyStatus.Available ? "badge-success" : copy.Status == CopyStatus.Lost ? "badge-danger" : "badge-warning")">@copy.StatusLabel</span></td><td><div class="actions"><a asp-action="Details" asp-route-id="@copy.Id" class="btn btn-sm btn-outline-secondary"><i data-lucide="qr-code"></i>QR</a>@if (copy.Status is not (CopyStatus.OnLoan or CopyStatus.Reserved)) { <a asp-action="Edit" asp-route-id="@copy.Id" class="btn btn-sm btn-outline-secondary">@T["Өзгерту"]</a> }@if (!copy.HasLoans && copy.Status is not (CopyStatus.OnLoan or CopyStatus.Reserved)) { <form asp-action="Delete" asp-route-id="@copy.Id" method="post" data-confirm="@T["Кітап данасы жойылсын ба?"]"><input name="rowVersion" type="hidden" value="@copy.RowVersion" /><button type="submit" class="btn btn-sm btn-outline-danger">@T["Жою"]</button></form> }else { <span class="text-muted small">@T["Тарихы сақталады"]</span> }</div></td></tr>
    }
    </tbody></table></div>
}
</div>
@if (Model.TotalPages > 1)
{
    <nav class="pagination mt-4" aria-label="@T["Даналар тізімінің беттері"]">@for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++) { <a asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-bookId="@Model.BookId" asp-route-status="@Model.Status" class="btn @(p == Model.Page ? "btn-primary" : "btn-outline-secondary")" aria-current="@(p == Model.Page ? "page" : null)">@p</a> }<span class="text-muted">@Model.Page / @Model.TotalPages @T["бет"]</span></nav>
}
</div>
