@model EduLibrary.ViewModels.DigitalLibraryPageViewModel
<form method="get" class="digital-filters" role="search"><div class="digital-search"><label for="digital-search" class="visually-hidden">@T["Search digital books"]</label><i data-lucide="search" aria-hidden="true"></i><input id="digital-search" name="Search" value="@Model.Filter.Search" maxlength="200" class="form-control" placeholder="@T["Search by title or author"]" /><button class="btn btn-primary" type="submit">@T["Search"]</button></div><div class="digital-filter-row"><div><label for="digital-format" class="visually-hidden">@T["Format"]</label><select id="digital-format" name="Format" class="form-select"><option value="">@T["All formats"]</option><option value="Pdf" selected="@(Model.Filter.Format == "Pdf")">PDF</option><option value="Epub" selected="@(Model.Filter.Format == "Epub")">EPUB</option></select></div><div><label for="digital-language" class="visually-hidden">@T["Language"]</label><select id="digital-language" name="Language" class="form-select"><option value="">@T["All languages"]</option>@foreach (var language in Model.Languages) { <option value="@language.Value" selected="@(language.Value == Model.Filter.Language)">@language.Text</option> }</select></div><details class="digital-more-filters"><summary>@T["Subjects and filters"] <i data-lucide="sliders-horizontal" aria-hidden="true"></i></summary><div><label for="digital-category">@T["Category"]</label><select id="digital-category" name="CategoryId" class="form-select"><option value="">@T["All categories"]</option>@foreach (var category in Model.Categories) { <option value="@category.Value" selected="@(category.Value == Model.Filter.CategoryId?.ToString())">@T[category.Text]</option> }</select><label for="digital-subject">@T["Subject"]</label><select id="digital-subject" name="SubjectId" class="form-select"><option value="">@T["All subjects"]</option>@foreach (var subject in Model.Subjects) { <option value="@subject.Value" selected="@(subject.Value == Model.Filter.SubjectId?.ToString())">@T[subject.Text]</option> }</select><label for="digital-author">@T["Author"]</label><select id="digital-author" name="AuthorId" class="form-select"><option value="">@T["All authors"]</option>@foreach (var author in Model.Authors) { <option value="@author.Value" selected="@(author.Value == Model.Filter.AuthorId?.ToString())">@author.Text</option> }</select><button class="btn btn-primary" type="submit">@T["Apply filters"]</button></div></details><label class="digital-sort"><span>@T["Sort by"]</span><select name="Sort" class="form-select"><option value="recent" selected="@(Model.Filter.Sort == "recent")">@T["Recently added"]</option><option value="popular" selected="@(Model.Filter.Sort == "popular")">@T["Most read"]</option><option value="title" selected="@(Model.Filter.Sort == "title")">@T["Title"]</option></select></label><a asp-action="@(Model.IsManagement ? "Manage" : Model.IsPersonal ? "My" : "Index")" class="digital-reset">@T["Reset"]</a></div></form>
