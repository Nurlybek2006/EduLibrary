@model EduLibrary.ViewModels.DigitalAssetEditViewModel
@{ ViewData["Title"] = T["Edit digital edition"].Value; }
<section class="digital-page"><header class="digital-heading"><div><span class="section-caption">@T["Digital collection"]</span><h1>@T["Edit digital edition"]</h1><p>@T["Update file metadata, rights and access. Leave the file field empty to keep the current edition."]</p></div><a asp-action="Manage" class="btn btn-outline-secondary">@T["Back to management"]</a></header><form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" id="digital-asset-form"><partial name="_Form" model="Model" /></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
