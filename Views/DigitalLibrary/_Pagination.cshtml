@model EduLibrary.ViewModels.DigitalLibraryPageViewModel
@if (Model.TotalPages > 1) { <nav class="digital-pagination" aria-label="@T["Pagination"]"><span>@T["Page {0} of {1}", Model.Filter.Page, Model.TotalPages]</span><div class="actions">@if (Model.Filter.Page > 1) { <a asp-route-page="@(Model.Filter.Page-1)" asp-route-search="@Model.Filter.Search" asp-route-format="@Model.Filter.Format" asp-route-language="@Model.Filter.Language" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-subjectId="@Model.Filter.SubjectId" asp-route-authorId="@Model.Filter.AuthorId" asp-route-sort="@Model.Filter.Sort" class="btn btn-outline-secondary">@T["Previous"]</a> }@if (Model.Filter.Page < Model.TotalPages) { <a asp-route-page="@(Model.Filter.Page+1)" asp-route-search="@Model.Filter.Search" asp-route-format="@Model.Filter.Format" asp-route-language="@Model.Filter.Language" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-subjectId="@Model.Filter.SubjectId" asp-route-authorId="@Model.Filter.AuthorId" asp-route-sort="@Model.Filter.Sort" class="btn btn-outline-secondary">@T["Next"]</a> }</div></nav> }
