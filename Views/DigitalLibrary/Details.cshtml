@model EduLibrary.ViewModels.DigitalAssetDetailsViewModel
@using EduLibrary.ViewModels
@{ ViewData["Title"]=Model.Title; var cover=new BookCoverViewModel {BookId=Model.BookId,Title=Model.Title,Authors=Model.Authors,CoverImageUrl=Model.CoverImageUrl,PublicationYear=Model.PublicationYear,Size="large"}; }
<section class="digital-page" id="digital-edition-details" data-asset-id="@Model.Id"><header class="digital-heading"><a asp-action="Index" class="text-link"><i data-lucide="arrow-left" aria-hidden="true"></i>@T["Back to digital library"]</a>@if (Model.CanManage) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">@T["Edit digital edition"]</a> }</header><div class="digital-detail-spread"><div class="digital-detail-cover"><partial name="_BookCover" model="cover" /></div><div><span class="section-caption">@T["Digital edition"] · @Model.Format</span><h1>@Model.Title</h1><p class="digital-detail-author">@Model.Authors</p><div class="actions digital-detail-actions"><a href="@Model.ReaderUrl" class="btn btn-primary"><i data-lucide="book-open" aria-hidden="true"></i>@(Model.ProgressPercentage > 0 ? T["Continue reading"] : T["Read online"])</a>@if (Model.AllowDownload) { <a asp-controller="Reader" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i data-lucide="download" aria-hidden="true"></i>@T["Download"]</a> }<a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="text-link">@T["Catalog information"]</a></div><p class="digital-description">@Model.Description</p><dl class="digital-detail-meta"><div><dt>@T["Format"]</dt><dd>@Model.Format · @((Model.FileSize/1024d/1024d).ToString("0.00")) MB</dd></div><div><dt>@T["Content language"]</dt><dd>@Model.Language</dd></div>@if (Model.PageCount > 0) { <div><dt>@T["Pages"]</dt><dd>@Model.PageCount</dd></div> }<div><dt>@T["Access level"]</dt><dd>@T[Model.AccessLevel.ToString()]</dd></div><div><dt>@T["License"]</dt><dd>@Model.LicenseName @if (!string.IsNullOrWhiteSpace(Model.LicenseUrl)) { <a href="@Model.LicenseUrl" target="_blank" rel="noopener noreferrer">@T["View license"]</a> }</dd></div><div><dt>@T["Rights holder"]</dt><dd>@Model.RightsHolder</dd></div>@if (!string.IsNullOrWhiteSpace(Model.SourceUrl)) { <div><dt>@T["Provenance"]</dt><dd><a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer">@T["View original source"]</a></dd></div> }</dl><p class="digital-license-note"><i data-lucide="shield-check" aria-hidden="true"></i>@T["Digital reading does not change physical copy availability or borrowing records."]</p>@if (Model.CanManage && !Model.IsArchived) { <form asp-action="Archive" asp-route-id="@Model.Id" method="post" data-confirm="@T["Archive this digital edition? It will no longer be available to readers."]"><input name="rowVersion" type="hidden" value="@Model.RowVersion" /><button class="btn btn-outline-danger" type="submit">@T["Archive digital edition"]</button></form> }</div></div></section>
