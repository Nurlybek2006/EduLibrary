@model EduLibrary.ViewModels.DigitalAssetCardViewModel
@using EduLibrary.ViewModels
@using System.Globalization
@{ var cover = new BookCoverViewModel { BookId=Model.BookId,Title=Model.Title,Authors=Model.Authors,CoverImageUrl=Model.CoverImageUrl,PublicationYear=Model.PublicationYear,Size="shelf" }; }
<article class="digital-card" data-asset-id="@Model.Id" data-format="@Model.Format"><a asp-controller="DigitalLibrary" asp-action="Details" asp-route-id="@Model.Id" class="digital-card-cover" tabindex="-1" aria-hidden="true"><partial name="_BookCover" model="cover" /><span class="digital-format">@Model.Format</span></a><div class="digital-card-body"><p class="digital-card-author">@Model.Authors</p><h3><a asp-controller="DigitalLibrary" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></h3><p class="digital-card-meta">@Model.Language · @(Model.FileFormat == EduLibrary.Models.Enums.DigitalFileFormat.Pdf ? T["{0} pages", Model.PageCount] : T["Reflowable text"])</p>@if (Model.ProgressPercentage.HasValue) { <div class="digital-progress"><progress value="@Model.ProgressPercentage.Value.ToString(CultureInfo.InvariantCulture)" max="100" aria-label="@T["Reading progress"]"></progress><span>@(Model.CompletedAt.HasValue ? T["Completed"] : T["{0}% read", Model.ProgressPercentage.Value.ToString("0")])</span></div> }<a href="@Model.ReaderUrl" class="digital-read-link">@(Model.ProgressPercentage > 0 ? T["Continue reading"] : T["Read online"]) <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div></article>
