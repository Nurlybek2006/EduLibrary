@model EduLibrary.ViewModels.DigitalAssetEditViewModel
@using EduLibrary.Models.Enums
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" />
<div class="digital-edit-grid"><section class="digital-edit-section"><span class="section-caption">01 / @T["Edition"]</span><h2>@T["File and catalog book"]</h2><p>@T["A digital edition belongs to an existing book. It does not create or change physical copies."]</p><div class="form-group"><label asp-for="BookId">@T["Catalog book"]</label><select asp-for="BookId" asp-items="Model.Books" class="form-select" required><option value="">@T["Choose a book"]</option></select></div><div class="form-grid"><div><label asp-for="FileFormat">@T["Format"]</label><select asp-for="FileFormat" class="form-select"><option value="Pdf">PDF</option><option value="Epub">EPUB</option></select></div><div><label asp-for="Language">@T["Content language"]</label><input asp-for="Language" class="form-control" required maxlength="40" /></div></div><div class="form-group"><label asp-for="File">@(Model.Id > 0 ? T["Replace file (optional)"] : T["PDF or EPUB file"])</label><input asp-for="File" type="file" accept="application/pdf,application/epub+zip,.pdf,.epub" class="form-control" required="@(Model.Id == 0)" /><small>@T["Maximum file size: {0} MB", Model.MaxFileBytes/1024/1024]. @T["The server checks the actual file structure and removes active EPUB content."]</small>@if (!string.IsNullOrWhiteSpace(Model.OriginalFileName)) { <p class="digital-current-file">@T["Current file"]: @Model.OriginalFileName</p> }</div></section>
<section class="digital-edit-section"><span class="section-caption">02 / @T["Rights"]</span><h2>@T["License and provenance"]</h2><p>@T["Publish only files with verified distribution rights. Commercial catalog metadata does not grant digital distribution permission."]</p><div class="form-grid"><div><label asp-for="LicenseType">@T["License type"]</label><select asp-for="LicenseType" class="form-select">@foreach (var value in Enum.GetValues<DigitalLicenseType>()) { <option value="@value">@T[value.ToString()]</option> }</select></div><div><label asp-for="LicenseName">@T["License name"]</label><input asp-for="LicenseName" class="form-control" maxlength="200" /></div></div><div class="form-group"><label asp-for="RightsHolder">@T["Rights holder"]</label><input asp-for="RightsHolder" class="form-control" maxlength="200" /></div><div class="form-group"><label asp-for="LicenseUrl">@T["License URL"]</label><input asp-for="LicenseUrl" type="text" class="form-control" maxlength="1000" placeholder="https://…" /></div><div class="form-group"><label asp-for="SourceUrl">@T["Source or provenance URL"]</label><input asp-for="SourceUrl" type="text" class="form-control" maxlength="1000" placeholder="https://…" /></div><label class="digital-checkbox"><input asp-for="RightsConfirmed" /> <span>@T["I confirm that the recorded rights permit this digital edition to be distributed."]</span></label></section>
<section class="digital-edit-section"><span class="section-caption">03 / @T["Access"]</span><h2>@T["Access and publication"]</h2><div class="form-group"><label asp-for="AccessLevel">@T["Access level"]</label><select asp-for="AccessLevel" class="form-select">@foreach (var value in Enum.GetValues<DigitalAccessLevel>()) { <option value="@value">@T[value.ToString()]</option> }</select></div><label class="digital-checkbox"><input asp-for="AllowDownload" /> <span>@T["Allow a separate file download"]</span></label><label class="digital-checkbox"><input asp-for="IsPublished" /> <span>@T["Publish this digital edition"]</span></label><p class="digital-form-note">@T["Drafts remain visible only to library staff. Publishing requires confirmed rights and complete provenance."]</p></section></div>
<div class="form-actions actions"><button type="submit" class="btn btn-primary"><i data-lucide="check" aria-hidden="true"></i>@T["Save digital edition"]</button><a asp-action="Manage" class="btn btn-outline-secondary">@T["Cancel"]</a></div>
