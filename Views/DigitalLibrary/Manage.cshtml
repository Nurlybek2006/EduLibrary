@model EduLibrary.ViewModels.DigitalLibraryPageViewModel
@{ ViewData["Title"] = T["Manage digital content"].Value; }
<section class="digital-page" id="digital-management"><header class="digital-heading"><div><span class="section-caption">@T["Library collection"]</span><h1>@T["Manage digital content"]</h1><p>@T["Upload, license and publish digital editions linked to existing catalog books."]</p></div><a asp-action="Upload" class="btn btn-primary"><i data-lucide="upload" aria-hidden="true"></i>@T["Upload digital edition"]</a></header><partial name="_Navigation" model="Model" /><partial name="_Filters" model="Model" /><div class="digital-section-heading"><h2>@T["Digital editions"]</h2><span>@Model.TotalCount</span></div>
@if (Model.Items.Count == 0) { <div class="digital-empty"><h2>@T["No digital editions found"]</h2><p>@T["Upload a PDF or EPUB and record its license before publishing."]</p></div> }else { <div class="table-responsive"><table class="table"><thead><tr><th>@T["Book"]</th><th>@T["Format"]</th><th>@T["Language"]</th><th>@T["License"]</th><th>@T["Status"]</th><th>@T["Readers"]</th><th>@T["Action"]</th></tr></thead><tbody>@foreach (var asset in Model.Items) { <tr data-asset-id="@asset.Id"><td><a asp-action="Details" asp-route-id="@asset.Id">@asset.Title</a><small class="digital-table-author">@asset.Authors</small></td><td>@asset.Format<small class="digital-table-author">@((asset.FileSize/1024d/1024d).ToString("0.00")) MB</small></td><td>@asset.Language</td><td>@asset.LicenseName</td><td><span class="badge">@(asset.IsArchived ? T["Archived"] : asset.IsPublished ? T["Published"] : T["Draft"])</span></td><td>@asset.ReaderCount</td><td><a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-secondary">@T["Edit"]</a></td></tr> }</tbody></table></div> }<partial name="_Pagination" model="Model" /></section>
