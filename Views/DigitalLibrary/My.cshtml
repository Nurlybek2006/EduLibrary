@model EduLibrary.ViewModels.DigitalLibraryPageViewModel
@{ ViewData["Title"] = T["My digital books"].Value; }
<section class="digital-page" id="my-digital-library"><header class="digital-heading"><div><span class="section-caption">@T["Your reading, everywhere"]</span><h1>@T["My digital books"]</h1><p>@T["Your reading history, saved places and bookmarks, securely linked to your account."]</p></div><a asp-action="Index" class="btn btn-primary">@T["Discover books"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></header><partial name="_Navigation" model="Model" />
<partial name="_Filters" model="Model" /><div class="digital-section-heading"><h2>@T["Currently reading"]</h2><span>@T["Continue from your saved place"]</span></div>@if (Model.ContinueReading.Count == 0) { <div class="digital-empty"><h2>@T["Your next chapter starts here"]</h2><p>@T["Open a digital book to begin. Your progress will be saved to your account."]</p><a asp-action="Index" class="btn btn-outline-secondary">@T["Browse digital books"]</a></div> }else { <div class="digital-book-grid">@foreach (var asset in Model.ContinueReading) { <partial name="_AssetCard" model="asset" /> }</div> }
@if (Model.CompletedBooks.Count > 0) { <section class="digital-shelf-section"><div class="digital-section-heading"><h2>@T["Completed books"]</h2></div><div class="digital-book-grid">@foreach (var asset in Model.CompletedBooks) { <partial name="_AssetCard" model="asset" /> }</div></section> }
@if (Model.RecentlyRead.Count > 0) { <section class="digital-shelf-section"><div class="digital-section-heading"><h2>@T["Recently opened"]</h2></div><div class="table-responsive"><table class="table"><thead><tr><th>@T["Book"]</th><th>@T["Last read"]</th><th>@T["Progress"]</th><th>@T["Bookmarks"]</th><th>@T["Action"]</th></tr></thead><tbody>@foreach (var asset in Model.RecentlyRead) { <tr data-asset-id="@asset.Id"><td><a href="@asset.ReaderUrl">@asset.Title</a> <span class="badge">@asset.Format</span></td><td>@asset.LastReadAt?.ToString("g")</td><td>@((asset.ProgressPercentage ?? 0).ToString("0"))%</td><td>@asset.BookmarkCount</td><td><a href="@asset.ReaderUrl" class="text-link">@T["Continue reading"]</a></td></tr> }</tbody></table></div></section> }
<partial name="_Pagination" model="Model" /></section>
