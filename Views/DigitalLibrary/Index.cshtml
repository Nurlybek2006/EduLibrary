@model EduLibrary.ViewModels.DigitalLibraryPageViewModel
@{ ViewData["Title"] = T["Digital library"].Value; }
<section class="digital-page" id="digital-library"><header class="digital-heading"><div><span class="section-caption">@T["A library without distance"]</span><h1>@T["Digital library"]</h1><p>@T["Read licensed PDF and EPUB books in your browser. Your place and bookmarks travel with you."]</p></div><a asp-action="My" class="btn btn-outline-secondary"><i data-lucide="library-big" aria-hidden="true"></i>@T["My digital books"]</a></header><partial name="_Navigation" model="Model" />
@if (Model.ContinueReading.Count > 0) { <section class="digital-continue"><div class="digital-section-heading"><h2>@T["Continue reading"]</h2><a asp-action="My" class="text-link">@T["View my shelf"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div><div class="digital-continue-grid">@foreach (var asset in Model.ContinueReading.Take(3)) { <partial name="_AssetCard" model="asset" /> }</div></section> }
<div class="digital-section-heading"><h2>@T["Discover digital books"]</h2><span>@T["{0} editions", Model.TotalCount]</span></div><partial name="_Filters" model="Model" />
@if (Model.Items.Count == 0) { <div class="digital-empty"><i data-lucide="book-open" aria-hidden="true"></i><h2>@T["No digital editions found"]</h2><p>@T["Try another format, subject or search phrase. Only registered digital files appear here."]</p></div> }else { <div class="digital-book-grid" id="digital-book-grid">@foreach (var asset in Model.Items) { <partial name="_AssetCard" model="asset" /> }</div> }
<partial name="_Pagination" model="Model" />
@if (Model.Recommended.Count > 0) { <section class="digital-recommendations"><div class="digital-section-heading"><h2>@T["Recommended for you"]</h2><a asp-controller="Recommendations" asp-action="Index" class="text-link">@T["All recommendations"]</a></div><div class="digital-book-grid">@foreach (var asset in Model.Recommended.Take(4)) { <partial name="_AssetCard" model="asset" /> }</div></section> }
@if (Model.Subjects.Count > 0) { <section class="digital-subjects"><h2>@T["Browse by subject"]</h2><div>@foreach (var subject in Model.Subjects) { <a asp-action="Index" asp-route-subjectId="@subject.Value">@T[subject.Text] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a> }</div></section> }
<p class="digital-license-note"><i data-lucide="shield-check" aria-hidden="true"></i>@T["Only materials with confirmed distribution rights are published. Digital reading does not borrow a physical copy."]</p></section>
