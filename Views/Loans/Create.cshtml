@model EduLibrary.ViewModels.IssueLoanViewModel
@{ ViewData["Title"] = UiText.Get("Кітап беру"); }
<div class="workspace-page loans-workspace form-workspace">
<div class="page-header workspace-heading"><div><span class="eyebrow">@T["Кітап айналымы"]</span><h1>@T["Кітап беру"]</h1><p>@T["Белсенді оқырман мен қолжетімді физикалық дананы таңдаңыз."]</p></div><a class="btn btn-secondary" asp-action="Index">@T["Тізімге оралу"]</a></div>
<div class="card ledger-panel form-card sheet-form">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-section-heading"><span>01</span><div><h2>@T["Оқырман және кітап"]</h2><p>@T["Кітапты алатын студент пен қордағы нақты дананы таңдаңыз."]</p></div></div>
    <div class="form-grid">
        <div><label asp-for="StudentId" class="form-label"></label><select asp-for="StudentId" asp-items="Model.Students" class="form-select" required><option value="">@T["Студентті таңдаңыз"]</option></select><span asp-validation-for="StudentId" class="text-danger"></span></div>
        <div><label for="copy-search" class="form-label">@T["Кітапты іздеу"]</label><input id="copy-search" class="form-control mb-2" type="search" placeholder="@T["Кітап атауы, дана нөмірі немесе сөре"]" autocomplete="off" /><label asp-for="BookCopyId" class="form-label"></label><select asp-for="BookCopyId" asp-items="Model.Copies" class="form-select" data-choose-copy="@T["Choose a book copy"]" required><option value="">@T["Кітап данасын таңдаңыз"]</option></select><span asp-validation-for="BookCopyId" class="text-danger"></span><small id="copy-search-count" class="text-muted" aria-live="polite" data-count-template="@T["{0} available copies"]">@Model.Copies.Count @T["Қолжетімді дана"]</small></div>
    </div>
    <div class="form-section-heading"><span>02</span><div><h2>@T["Оқу мерзімі"]</h2><p>@T["Кітаптың берілген күні мен қайтару мерзімін белгілеңіз."]</p></div></div>
    <div class="form-grid">
        <div><label asp-for="LoanDate" class="form-label"></label><input asp-for="LoanDate" class="form-control" /><span asp-validation-for="LoanDate" class="text-danger"></span></div>
        <div><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control" /><span asp-validation-for="DueDate" class="text-danger"></span><small class="text-muted">@T["Әдепкі мерзім:"] @Model.DefaultLoanDays @T["күн."]</small></div>
    </div>
    <div class="mb-4"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div>
    <div class="actions"><button class="btn btn-primary" type="submit"><i data-lucide="book-up"></i> @T["Беруді растау"]</button><a class="btn btn-secondary" asp-action="Index">@T["Бас тарту"]</a></div>
</form>
</div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const search = document.getElementById('copy-search');
            const select = document.getElementById('BookCopyId');
            const count = document.getElementById('copy-search-count');
            const choices = Array.from(select.options).slice(1).map(option => ({ value: option.value, text: option.text }));
            search.addEventListener('input', () => {
                const previous = select.value;
                const query = search.value.trim().toLocaleLowerCase(document.documentElement.lang);
                const matching = choices.filter(option => option.text.toLocaleLowerCase(document.documentElement.lang).includes(query));
                select.replaceChildren(new Option(select.dataset.chooseCopy, ''), ...matching.map(option => new Option(option.text, option.value)));
                if (matching.some(option => option.value === previous)) select.value = previous;
                count.textContent = count.dataset.countTemplate.replace('{0}', matching.length.toLocaleString(document.documentElement.lang));
            });
        })();
    </script>
}
