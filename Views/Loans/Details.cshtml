@model EduLibrary.ViewModels.LoanDetailsViewModel
@{ ViewData["Title"] = "Кітап беру жазбасы"; }
<div class="page-header"><div><span class="eyebrow">КІТАП АЙНАЛЫМЫ · №@Model.Loan.Id</span><h1>@Model.Loan.BookTitle</h1><p>@Model.Loan.InventoryNumber · @Model.Loan.StudentName</p></div><div class="actions"><a class="btn btn-secondary" asp-action="Index">Тізімге оралу</a>@if(Model.IsStaff && !Model.Loan.ReturnedAt.HasValue) { <a class="btn btn-primary" asp-controller="Returns" asp-action="Create" asp-route-id="@Model.Loan.Id">Кітапты қабылдау</a> }</div></div>
<div class="card"><div class="card-header"><h2>Беру ақпараты</h2><span class="badge badge-@Model.Loan.StatusClass">@Model.Loan.StatusLabel</span></div>
<dl class="detail-grid"><div><dt>Оқырман</dt><dd>@Model.Loan.StudentName <span class="text-muted">(@Model.Loan.StudentNumber)</span></dd></div><div><dt>Дананың нөмірі</dt><dd>@Model.Loan.InventoryNumber</dd></div><div><dt>Берілген күні</dt><dd>@Model.Loan.LoanDate.ToString("dd.MM.yyyy")</dd></div><div><dt>Қайтару мерзімі</dt><dd>@Model.Loan.DueDate.ToString("dd.MM.yyyy")</dd></div><div><dt>Қайтарылған күні</dt><dd>@(Model.Loan.ReturnedAt?.ToString("dd.MM.yyyy") ?? "Әлі қайтарылмаған")</dd></div><div><dt>Кешігу мерзімі</dt><dd>@Model.Loan.OverdueDays күн</dd></div><div><dt>@(Model.Loan.ReturnedAt.HasValue ? "Нақты айыппұл" : "Болжамды айыппұл")</dt><dd>@((Model.Loan.ReturnedAt.HasValue ? Model.FinalFine : Model.Loan.EstimatedFine).ToString("N2")) ₸</dd></div>@if(!string.IsNullOrWhiteSpace(Model.ReturnCondition)) { <div><dt>Қайтарылғандағы жағдайы</dt><dd>@Model.ReturnCondition</dd></div> }</dl>
@if(!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="note-block"><h3>Беру ескертпесі</h3><p>@Model.Notes</p></div> }
@if(!string.IsNullOrWhiteSpace(Model.ReturnNotes)) { <div class="note-block"><h3>Қайтару ескертпесі</h3><p>@Model.ReturnNotes</p></div> }
@if(!Model.Loan.ReturnedAt.HasValue && Model.Loan.OverdueDays > 0) { <div class="alert alert-warning">Айыппұл — бүгінгі күнге есептелген болжам. Нақты сома кітап қайтарылған күні бекітіледі.</div> }
</div>
