@model EduLibrary.ViewModels.LoanDetailsViewModel
@{ ViewData["Title"] = UiText.Get("Кітап беру жазбасы"); }
<div class="workspace-page loans-workspace detail-workspace">
<div class="page-header workspace-heading"><div><span class="eyebrow">@T["КІТАП АЙНАЛЫМЫ · №"]@Model.Loan.Id</span><h1>@Model.Loan.BookTitle</h1><p>@Model.Loan.InventoryNumber · @Model.Loan.StudentName</p></div><div class="actions"><a class="btn btn-secondary" asp-action="Index">@T["Тізімге оралу"]</a>@if(Model.IsStaff && !Model.Loan.ReturnedAt.HasValue) { <a class="btn btn-primary" asp-controller="Returns" asp-action="Create" asp-route-id="@Model.Loan.Id">@T["Кітапты қабылдау"]</a> }</div></div>
<div class="card ledger-panel"><div class="card-header section-heading"><h2>@T["Беру ақпараты"]</h2><span class="badge badge-@Model.Loan.StatusClass">@Model.Loan.StatusLabel</span></div>
<dl class="detail-grid record-grid"><div><dt>@T["Оқырман"]</dt><dd>@Model.Loan.StudentName <span class="text-muted">(@Model.Loan.StudentNumber)</span></dd></div><div><dt>@T["Дананың нөмірі"]</dt><dd>@Model.Loan.InventoryNumber</dd></div><div><dt>@T["Берілген күні"]</dt><dd>@Model.Loan.LoanDate.ToString("d")</dd></div><div><dt>@T["Қайтару мерзімі"]</dt><dd>@Model.Loan.DueDate.ToString("d")</dd></div><div><dt>@T["Қайтарылған күні"]</dt><dd>@(Model.Loan.ReturnedAt?.ToString("d") ?? UiText.Get("Әлі қайтарылмаған"))</dd></div><div><dt>@T["Кешігу мерзімі"]</dt><dd>@Model.Loan.OverdueDays @T["Күн"]</dd></div><div><dt>@(Model.Loan.ReturnedAt.HasValue ? UiText.Get("Нақты айыппұл") : UiText.Get("Болжамды айыппұл"))</dt><dd>@((Model.Loan.ReturnedAt.HasValue ? Model.FinalFine : Model.Loan.EstimatedFine).ToString("N2")) ₸</dd></div>@if(!string.IsNullOrWhiteSpace(Model.ReturnCondition)) { <div><dt>@T["Қайтарылғандағы жағдайы"]</dt><dd>@Model.ReturnCondition</dd></div> }</dl>
@if(!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="note-block"><h3>@T["Беру ескертпесі"]</h3><p>@Model.Notes</p></div> }
@if(!string.IsNullOrWhiteSpace(Model.ReturnNotes)) { <div class="note-block"><h3>@T["Қайтару ескертпесі"]</h3><p>@Model.ReturnNotes</p></div> }
@if(!Model.Loan.ReturnedAt.HasValue && Model.Loan.OverdueDays > 0) { <div class="alert alert-warning">@T["Айыппұл — бүгінгі күнге есептелген болжам. Нақты сома кітап қайтарылған күні бекітіледі."]</div> }
</div>
</div>
