@model EduLibrary.ViewModels.LoanListViewModel
@{ ViewData["Title"] = Model.IsStaff ? UiText.Get("Кітап беру") : UiText.Get("Менің кітаптарым"); }
<div class="workspace-page loans-workspace index-workspace">
<div class="page-header workspace-heading">
    <div><span class="eyebrow">@T["Кітап айналымы"]</span><h1>@ViewData["Title"]</h1><p>@T["Берілген кітаптар, қайтару мерзімдері және толық тарих."]</p></div>
    @if (Model.IsStaff) { <a class="btn btn-primary" asp-action="Create"><i data-lucide="plus"></i> @T["Кітап беру"]</a> }
</div>
<div class="card ledger-panel">
    <form method="get" class="filter-bar ledger-toolbar" role="search">
        <div class="search-field"><label class="visually-hidden" for="loan-search">@T["Іздеу"]</label><input id="loan-search" class="form-control" name="Search" value="@Model.Filter.Search" placeholder="@T["Кітап, студент немесе инвентарлық нөмір"]" /></div>
        <label class="visually-hidden" for="loan-status">@T["Мәртебесі"]</label>
        <select id="loan-status" name="Status" class="form-select">
            <option value="active" selected="@(Model.Filter.Status == "active")">@T["Оқырманда"]</option>
            <option value="overdue" selected="@(Model.Filter.Status == "overdue")">@T["Мерзімі өткен"]</option>
            <option value="returned" selected="@(Model.Filter.Status == "returned")">@T["Қайтарылған"]</option>
            <option value="all" selected="@(Model.Filter.Status == "all")">@T["Барлық тарих"]</option>
        </select>
        <button class="btn btn-primary" type="submit">@T["Іздеу"]</button><a class="btn btn-secondary" asp-action="Index">@T["Тазарту"]</a>
    </form>
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state"><i data-lucide="book-open"></i><h2>@T["Жазбалар табылмады"]</h2><p>@T["Іздеу шарттарын өзгертіңіз немесе жаңа кітап беріңіз."]</p></div>
    }
    else if (!Model.IsStaff)
    {
        <div class="reading-ledger-grid">
        @foreach (var loan in Model.Items)
        {
            <article class="reading-loan">
                <a class="reading-cover-link" asp-action="Details" asp-route-id="@loan.Id" tabindex="-1" aria-hidden="true"><partial name="_BookCover" model='new EduLibrary.ViewModels.BookCoverViewModel { BookId = loan.BookId, Title = loan.BookTitle, Authors = loan.Authors, CoverImageUrl = loan.CoverImageUrl, PublicationYear = loan.PublicationYear, Size = "compact" }'  /></a>
                <div><span class="badge badge-@loan.StatusClass">@loan.StatusLabel</span><h2 class="mt-3"><a asp-action="Details" asp-route-id="@loan.Id">@loan.BookTitle</a></h2><p>@loan.InventoryNumber</p><p>@(loan.ReturnedAt.HasValue ? UiText.Get("Қайтарылған күні") : UiText.Get("Қайтару мерзімі")): <strong>@((loan.ReturnedAt ?? loan.DueDate).ToString("d"))</strong></p>
                @if(!loan.ReturnedAt.HasValue && loan.OverdueDays > 0) { <p class="text-danger">@loan.OverdueDays @T["күн кешікті ·"] @loan.EstimatedFine.ToString("N0") @T["₸ болжамды айыппұл"]</p> }
                <a class="quiet-link" asp-action="Details" asp-route-id="@loan.Id">@T["Оқу жазбасын ашу"] <i data-lucide="arrow-up-right"></i></a></div>
            </article>
        }
        </div>
    }
    else
    {
        <div class="ledger-caption"><div><span class="workspace-kicker">@T["Кітап пен оқырман арасындағы байланыс"]</span><h2>@T["Беру жазбалары"]</h2></div><span class="ledger-total">@Model.TotalCount @T["жазба"]</span></div>
        <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>@T["Кітап / дана"]</th><th>@T["Оқырман"]</th><th>@T["Берілді"]</th><th>@T["Қайтару мерзімі"]</th><th>@T["Мәртебесі"]</th><th>@T["Болжамды айыппұл"]</th><th></th></tr></thead><tbody>
        @foreach (var loan in Model.Items)
        {
            <tr><td><a asp-action="Details" asp-route-id="@loan.Id"><strong>@loan.BookTitle</strong></a><small class="d-block text-muted">@loan.InventoryNumber</small></td><td>@loan.StudentName<small class="d-block text-muted">@loan.StudentNumber</small></td><td>@loan.LoanDate.ToString("d")</td><td>@loan.DueDate.ToString("d")</td><td><span class="badge badge-@loan.StatusClass">@loan.StatusLabel</span>@if(loan.OverdueDays > 0 && !loan.ReturnedAt.HasValue) { <small class="d-block text-danger">@loan.OverdueDays @T["Күн"]</small> }</td><td>@(loan.ReturnedAt.HasValue ? "—" : loan.EstimatedFine.ToString("N0") + " ₸")</td><td><div class="actions"><a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@loan.Id">@T["Толығырақ"]</a>@if (Model.IsStaff && !loan.ReturnedAt.HasValue) { <a class="btn btn-sm btn-primary" asp-controller="Returns" asp-action="Create" asp-route-id="@loan.Id">@T["Қабылдау"]</a> }</div></td></tr>
        }
        </tbody></table></div>
    }
    <div class="pagination-bar"><span class="text-muted">@T["Барлығы:"] @Model.TotalCount @T["жазба"]</span><div class="actions">@if(Model.Filter.Page > 1) { <a class="btn btn-secondary btn-sm" asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status" asp-route-Page="@(Model.Filter.Page - 1)">@T["Алдыңғы"]</a> }<span>@Model.Filter.Page / @Math.Max(1, Model.TotalPages)</span>@if(Model.Filter.Page < Model.TotalPages) { <a class="btn btn-secondary btn-sm" asp-route-Search="@Model.Filter.Search" asp-route-Status="@Model.Filter.Status" asp-route-Page="@(Model.Filter.Page + 1)">@T["Келесі"]</a> }</div></div>
</div>
</div>
