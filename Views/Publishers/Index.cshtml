@model EduLibrary.ViewModels.CatalogLookupViewModel
@{ ViewData["Title"] = UiText.Get("Баспалар"); }
<div class="workspace-page publishers-workspace index-workspace">
<div class="page-header workspace-heading"><div><p class="eyebrow">@T["КАТАЛОГ АНЫҚТАМАЛЫҒЫ"]</p><h1>@T["Баспалар"]</h1><p class="text-muted">@T["Кітапхана қорының анықтамалық мәліметтерін басқарыңыз."]</p></div><a asp-action="Create" class="btn btn-primary"><i data-lucide="plus" aria-hidden="true"></i> @T["Жаңа баспа"]</a></div>
<form method="get" class="card ledger-panel filter-card ledger-toolbar-pane mb-4" role="search"><div class="actions"><label for="lookup-search" class="visually-hidden">@T["Баспалар іздеу"]</label><input id="lookup-search" name="search" value="@Model.Search" class="form-control" placeholder="@T["Баспа атауы немесе елі"]" maxlength="200" /><button class="btn btn-primary" type="submit"><i data-lucide="search" aria-hidden="true"></i> @T["Іздеу"]</button><a asp-action="Index" class="btn btn-outline-secondary">@T["Тазарту"]</a></div></form>
<div class="card ledger-panel reference-ledger">
<div class="ledger-caption"><div><span class="workspace-kicker">@T["Әдебиетті жарыққа шығаратындар"]</span><h2>@T["Баспалар тізілімі"]</h2></div><span class="ledger-total">@Model.Items.Count @T["жазба"]</span></div>
@if (Model.Items.Count == 0)
{
    <div class="empty-state"><i data-lucide="folder-search" aria-hidden="true"></i><h2>@T["Жазбалар табылмады"]</h2><p>@T["Іздеу сөзін өзгертіңіз немесе жаңа баспа қосыңыз."]</p><a asp-action="Create" class="btn btn-primary">@T["Жаңа баспа"]</a></div>
}
else
{
    <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>@T["Атауы"]</th><th>@T["Қосымша мәлімет"]</th><th>@T["Кітаптар"]</th><th>@T["Әрекеттер"]</th></tr></thead><tbody>
    @foreach (var item in Model.Items)
    {
        <tr><td><strong>@item.Name</strong></td><td><span class="text-muted">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description.Length > 140 ? item.Description[..140] + "…" : item.Description)</span></td><td><a asp-controller="Books" asp-action="Index" asp-route-publisherId="@item.Id" class="badge badge-muted">@item.BookCount @T["Кітап"]</a></td><td><div class="actions"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" aria-label="@UiText.Format($"Edit {item.Name}")"><i data-lucide="pencil" aria-hidden="true"></i> @T["Өзгерту"]</a><form asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="@T["Бұл жазба жойылсын ба?"]"><button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(item.BookCount > 0)" title="@(item.BookCount > 0 ? UiText.Get("Кітаптармен байланысқан жазба жойылмайды.") : UiText.Get("Жазбаны жою"))" aria-label="@UiText.Format($"Delete {item.Name}")"><i data-lucide="trash-2" aria-hidden="true"></i> @T["Жою"]</button></form></div></td></tr>
    }
    </tbody></table></div>
}
</div>
</div>
