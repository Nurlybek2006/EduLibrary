@model EduLibrary.ViewModels.PublisherEditViewModel
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<input asp-for="Id" type="hidden" />
<div class="form-section-heading"><span>01</span><div><h2>Баспа деректері</h2><p>Баспаның атауы мен орналасқан елін көрсетіңіз.</p></div></div>
<div class="form-grid">
    <div class="form-group"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="form-group"><label asp-for="Country"></label><input asp-for="Country" class="form-control" /><span asp-validation-for="Country" class="text-danger"></span></div>
    <div class="form-group"><label asp-for="Website"></label><input asp-for="Website" class="form-control" /><span asp-validation-for="Website" class="text-danger"></span></div>
</div>
<div class="form-actions actions mt-4"><button type="submit" class="btn btn-primary"><i data-lucide="check" aria-hidden="true"></i> Сақтау</button><a asp-action="Index" class="btn btn-outline-secondary">Бас тарту</a></div>
