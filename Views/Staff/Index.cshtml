@model List<EduLibrary.ViewModels.StaffListItem>
@{ ViewData["Title"] = UiText.Get("Кітапханашылар"); }
<div class="workspace-page staff-workspace index-workspace">
<div class="page-header workspace-heading"><div><span class="eyebrow">@T["ЖҮЙЕНІ БАСҚАРУ"]</span><h1>@T["Кітапхана командасы"]</h1><p>@T["Қызметкерлер мен олардың жүйеге қолжетімділігін басқарыңыз."]</p></div><a asp-action="Create" class="btn btn-primary"><i data-lucide="user-plus"></i> @T["Кітапханашы қосу"]</a></div>
<section class="card ledger-panel">@if (Model.Count == 0) { <div class="empty-state"><i data-lucide="users"></i><h2>@T["Қызметкерлер табылмады"]</h2></div> } else { <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>@T["Қызметкер"]</th><th>@T["Рөлі"]</th><th>@T["Мәртебе"]</th><th>@T["Әрекет"]</th></tr></thead><tbody>@foreach (var staff in Model) { <tr><td><div class="avatar-identity">@await Component.InvokeAsync("Avatar", new { userId = staff.Id, name = staff.FullName, avatarPath = staff.AvatarPath, size = "small", resolved = true })<div><strong>@staff.FullName</strong><div class="text-muted">@staff.Email</div></div></div></td><td>@staff.Role</td><td><span class="badge @(staff.IsInactive ? "badge-secondary" : "badge-success")">@(staff.IsInactive ? UiText.Get("Тоқтатылған") : UiText.Get("Белсенді"))</span></td><td>@if (staff.CanDeactivate) { <form asp-action="Deactivate" asp-route-id="@staff.Id" method="post" data-confirm="@T["Кітапханашының аккаунтын тоқтатасыз ба?"]"><button type="submit" class="btn btn-sm btn-outline-danger">@T["Тоқтату"]</button></form> } else { <span class="text-muted">—</span> }</td></tr> }</tbody></table></div> }</section>
</div>
