@model List<EduLibrary.ViewModels.StaffListItem>
@{ ViewData["Title"] = "Кітапханашылар"; }
<div class="page-header"><div><span class="eyebrow">ЖҮЙЕНІ БАСҚАРУ</span><h1>Кітапхана командасы</h1><p>Қызметкерлер мен олардың жүйеге қолжетімділігін басқарыңыз.</p></div><a asp-action="Create" class="btn btn-primary"><i data-lucide="user-plus"></i> Кітапханашы қосу</a></div>
<section class="card">@if (Model.Count == 0) { <div class="empty-state"><i data-lucide="users"></i><h2>Қызметкерлер табылмады</h2></div> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Қызметкер</th><th>Рөлі</th><th>Мәртебе</th><th>Әрекет</th></tr></thead><tbody>@foreach (var staff in Model) { <tr><td><strong>@staff.FullName</strong><div class="text-muted">@staff.Email</div></td><td>@staff.Role</td><td><span class="badge @(staff.IsInactive ? "badge-secondary" : "badge-success")">@(staff.IsInactive ? "Тоқтатылған" : "Белсенді")</span></td><td>@if (staff.CanDeactivate) { <form asp-action="Deactivate" asp-route-id="@staff.Id" method="post" data-confirm="Кітапханашының аккаунтын тоқтатасыз ба?"><button type="submit" class="btn btn-sm btn-outline-danger">Тоқтату</button></form> } else { <span class="text-muted">—</span> }</td></tr> }</tbody></table></div> }</section>
