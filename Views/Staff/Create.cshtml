@model EduLibrary.ViewModels.CreateLibrarianViewModel
@{ ViewData["Title"] = "Кітапханашы қосу"; }
<div class="workspace-page staff-workspace form-workspace">
<div class="page-header workspace-heading"><div><span class="eyebrow">КОМАНДАҒА ҚОСУ</span><h1>Кітапханашы аккаунты</h1><p>Жаңа қызметкерге кітапхана модульдерін басқару құқығын беріңіз.</p></div></div>
<section class="card ledger-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div class="form-grid">
<div><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
<div><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="off" /><span asp-validation-for="Email" class="text-danger"></span></div>
<div><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><small class="text-muted">Кемінде 10 таңба: бас және кіші әріп, сан, арнайы таңба.</small><span asp-validation-for="Password" class="text-danger"></span></div>
<div><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
</div><div class="actions mt-4"><button class="btn btn-primary" type="submit">Аккаунт ашу</button><a asp-action="Index" class="btn btn-outline-secondary">Бас тарту</a></div></form></section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
