@model EduLibrary.ViewModels.StudentListViewModel
@{ ViewData["Title"] = UiText.Get("Студенттер"); }
<div class="workspace-page students-workspace index-workspace">
<div class="page-header workspace-heading"><div><span class="eyebrow">@T["ОҚЫРМАНДАР ҚАУЫМДАСТЫҒЫ"]</span><h1>@T["Студенттер"]</h1><p>@T["Барлығы"] @Model.TotalCount @T["студент · оқу және кітапхана деректері."]</p></div><a asp-action="Create" class="btn btn-primary"><i data-lucide="user-plus"></i> @T["Студент қосу"]</a></div>
<section class="card ledger-panel mb-4"><form method="get" class="form-grid">
    <div><label for="student-search">@T["Іздеу"]</label><input id="student-search" name="Search" value="@Model.Search" class="form-control" placeholder="@T["Аты-жөні немесе студент нөмірі"]" /></div>
    <div><label for="faculty">@T["Факультет"]</label><select id="faculty" name="Faculty" class="form-select"><option value="">@T["Барлық факультеттер"]</option>@foreach (var faculty in Model.Faculties) { <option value="@faculty" selected="@(faculty == Model.Faculty)">@faculty</option> }</select></div>
    <div><label for="course">@T["Курс"]</label><select id="course" name="Course" class="form-select"><option value="">@T["Барлық курстар"]</option>@for (var course = 1; course <= 8; course++) { <option value="@course" selected="@(course == Model.Course)">@course @T["Курс"]</option> }</select></div>
    <div><label for="group">@T["Топ"]</label><input id="group" name="GroupName" value="@Model.GroupName" class="form-control" placeholder="@T["Топ атауы"]" /></div>
    <div class="form-check"><input asp-for="IncludeInactive" class="form-check-input" /><label asp-for="IncludeInactive" class="form-check-label">@T["Белсенді емес студенттерді көрсету"]</label></div>
    <div class="actions"><button type="submit" class="btn btn-primary"><i data-lucide="search"></i> @T["Іздеу"]</button><a asp-action="Index" class="btn btn-outline-secondary">@T["Тазарту"]</a></div>
</form></section>
<section class="card ledger-panel">
    <div class="ledger-caption"><div><span class="workspace-kicker">@T["Кітапхана қауымдастығы"]</span><h2>@T["Оқырмандар тізілімі"]</h2></div><span class="ledger-total">@Model.TotalCount @T["Студент"]</span></div>
    @if (Model.Students.Count == 0)
    { <div class="empty-state"><i data-lucide="users"></i><h2>@T["Студенттер табылмады"]</h2><p>@T["Іздеу шарттарын өзгертіңіз немесе жаңа студент қосыңыз."]</p><a asp-action="Create" class="btn btn-primary">@T["Студент қосу"]</a></div> }
    else
    {
        <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>@T["Студент"]</th><th>@T["Байланыс"]</th><th>@T["Факультет"]</th><th>@T["Курс / топ"]</th><th>@T["Мәртебе"]</th><th><span class="visually-hidden">@T["Әрекеттер"]</span></th></tr></thead><tbody>
        @foreach (var student in Model.Students)
        {
            <tr><td><div class="avatar-identity">@await Component.InvokeAsync("Avatar", new { userId = student.IdentityUserId, name = student.FullName, avatarPath = student.AvatarPath, size = "small", resolved = true })<div><a asp-action="Details" asp-route-id="@student.Id"><strong>@student.FullName</strong></a><div class="text-muted">@student.StudentNumber</div></div></div></td><td>@student.Email</td><td>@student.Faculty</td><td>@student.Course @T["Курс"] <div class="text-muted">@student.GroupName</div></td><td><span class="badge @(student.IsActive ? "badge-success" : "badge-secondary")">@(student.IsActive ? UiText.Get("Белсенді") : UiText.Get("Тоқтатылған"))</span></td><td><a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-secondary">@T["Ашу"] <i data-lucide="arrow-up-right"></i></a></td></tr>
        }
        </tbody></table></div>
        <nav class="actions mt-3" aria-label="@T["Студенттер беттері"]">
            @if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-faculty="@Model.Faculty" asp-route-course="@Model.Course" asp-route-groupName="@Model.GroupName" asp-route-includeInactive="@Model.IncludeInactive" class="btn btn-outline-secondary">@T["Алдыңғы"]</a> }
            <span class="text-muted">@Model.Page / @Model.TotalPages @T["бет"]</span>
            @if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-faculty="@Model.Faculty" asp-route-course="@Model.Course" asp-route-groupName="@Model.GroupName" asp-route-includeInactive="@Model.IncludeInactive" class="btn btn-outline-secondary">@T["Келесі"]</a> }
        </nav>
    }
</section>
</div>
