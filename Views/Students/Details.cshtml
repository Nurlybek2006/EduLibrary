@model EduLibrary.ViewModels.StudentDetailsViewModel
@{ ViewData["Title"] = Model.FullName; }
<div class="workspace-page students-workspace reader-workspace">
<header class="page-header workspace-heading"><div><p class="workspace-kicker">@(Model.CanManage ? "Оқырманның жеке ісі" : "Сіздің жеке кітап сөреңіз") · @Model.StudentNumber</p><h1>@(Model.CanManage ? Model.FullName : "Менің оқу кеңістігім")</h1><p>@Model.Faculty · @Model.Course курс · @Model.GroupName</p></div><div class="actions">@if(Model.CanManage) { <a asp-action="Index" class="btn btn-outline-secondary">Студенттер</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i data-lucide="pencil"></i> Өңдеу</a> } else { <a asp-controller="Recommendations" asp-action="Index" class="btn btn-primary">Келесі кітабымды табу <i data-lucide="arrow-up-right"></i></a> }</div></header>
<section class="reader-dossier" aria-label="Оқырман туралы">
    <div class="reader-contact"><span class="reader-monogram" aria-hidden="true">@(Model.FullName.Length > 0 ? Model.FullName[..1] : "О")</span><div><h2>@Model.FullName</h2><p>@Model.Email<br />@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Телефон көрсетілмеген" : Model.PhoneNumber)</p><span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">@(Model.IsActive ? "Белсенді оқырман" : "Белсенділігі тоқтатылған")</span></div></div>
    <dl class="reader-facts"><div><dt>Қолындағы кітаптар</dt><dd>@Model.ActiveLoans.Count</dd><small>@Model.ActiveLoans.Count(l => l.OverdueDays > 0) мерзімі өткен</small></div><div><dt>Төленбеген айыппұл</dt><dd>@Model.OutstandingFines.ToString("N0") <small>₸</small></dd><small>Бекітілген берешек</small></div></dl>
</section>
<section class="record-section"><header class="section-heading"><div><p class="workspace-kicker">Оқу жалғасуда</p><h2>Қолындағы кітаптар</h2></div><a class="quiet-link" asp-controller="Recommendations" asp-action="Index" asp-route-studentId="@Model.Id">Жеке ұсыныстар <i data-lucide="arrow-up-right"></i></a></header>
@if(Model.ActiveLoans.Count == 0) { <div class="empty-state"><i data-lucide="book-open"></i><h3>Келесі жақсы кітапты күтіп тұр.</h3><p>Қазіргі уақытта қолында кітап жоқ.</p><a class="btn btn-outline-secondary" asp-controller="Books" asp-action="Index">Каталогты ашу</a></div> }
else { <div class="reading-ledger-grid">@foreach(var loan in Model.ActiveLoans) { <article class="reading-loan"><a class="reading-cover-link" asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id" aria-hidden="true" tabindex="-1"><partial name="_BookCover" model='new EduLibrary.ViewModels.BookCoverViewModel { BookId = loan.BookId, Title = loan.BookTitle, Authors = loan.Authors, CoverImageUrl = loan.CoverImageUrl, PublicationYear = loan.PublicationYear, Size = "compact" }'  /></a><div><span class="badge @(loan.OverdueDays > 0 ? "badge-danger" : "badge-success")">@(loan.OverdueDays > 0 ? loan.OverdueDays + " күн кешіккен" : "Мерзімі өтпеген")</span><h3 class="mt-3"><a asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id">@loan.BookTitle</a></h3><p>@loan.InventoryNumber</p><p>Қайтару мерзімі: <strong>@loan.DueDate.ToString("dd.MM.yyyy")</strong></p><a class="quiet-link" asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id">Беру жазбасын ашу <i data-lucide="arrow-up-right"></i></a></div></article> }</div> }
</section>
<section class="interest-notebook"><div><h2>Қызығушылықтары</h2>@if(Model.Interests.Count == 0) { <p class="text-muted">Қызығушылықтар көрсетілмеген.</p> } else { <div class="actions">@foreach(var interest in Model.Interests) { <span class="badge badge-secondary">@interest</span> }</div> }</div><div><h2>Оқитын пәндері</h2>@if(Model.Subjects.Count == 0) { <p class="text-muted">Пәндер таңдалмаған.</p> } else { <div class="actions">@foreach(var subject in Model.Subjects) { <span class="badge badge-secondary">@subject</span> }</div> }<a class="quiet-link mt-3" asp-controller="Recommendations" asp-action="Preferences" asp-route-studentId="@Model.Id">Оқу бағытын толықтыру <i data-lucide="arrow-right"></i></a></div></section>
<section class="ledger-panel"><div class="ledger-caption"><div><p class="workspace-kicker">Оқылған кітаптар ізі</p><h2>Кітап алу тарихы</h2></div><span class="ledger-total">@Model.History.Count жазба</span></div>
@if(Model.History.Count == 0) { <div class="empty-state"><p>Қайтарылған кітаптар әлі жоқ.</p></div> }
else { <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>Кітап / дана</th><th>Берілген күні</th><th>Мерзімі</th><th>Қайтарылған күні</th></tr></thead><tbody>@foreach(var loan in Model.History) { <tr><td><a asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id"><strong>@loan.BookTitle</strong></a><span class="record-secondary">@loan.InventoryNumber</span></td><td>@loan.LoanDate.ToString("dd.MM.yyyy")</td><td>@loan.DueDate.ToString("dd.MM.yyyy")</td><td>@loan.ReturnedAt?.ToString("dd.MM.yyyy") @if(loan.OverdueDays > 0) { <span class="badge badge-warning">@loan.OverdueDays күн кешіккен</span> }</td></tr> }</tbody></table></div> }
</section>
<section class="ledger-panel"><div class="ledger-caption"><div><p class="workspace-kicker">Қаржылық жазбалар</p><h2>Айыппұлдар тарихы</h2></div><span class="ledger-total">@Model.Fines.Count жазба</span></div>
@if(Model.Fines.Count == 0) { <div class="empty-state"><i data-lucide="check"></i><p>Айыппұлдар жоқ. Жақсы оқу әдетін сақтаңыз.</p></div> }
else { <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>Кітап / себеп</th><th>Күні</th><th>Сома</th><th>Төленді</th><th>Қалдық</th></tr></thead><tbody>@foreach(var fine in Model.Fines) { <tr><td>@fine.BookTitle<div class="record-secondary">@fine.Reason</div></td><td>@fine.CreatedAt.ToString("dd.MM.yyyy")</td><td>@fine.Amount.ToString("N2") ₸</td><td>@fine.PaidAmount.ToString("N2") ₸</td><td><span class="badge @(fine.Balance > 0 ? "badge-warning" : "badge-success")">@fine.Balance.ToString("N2") ₸</span></td></tr> }</tbody></table></div> }
</section>
@if(Model.CanManage && Model.IsActive) { <section class="record-section"><header class="section-heading"><div><h2>Оқырман белсенділігін тоқтату</h2><p>Кітап алу және төлем тарихы сақталады. Жаңа кітап беру және аккаунтқа кіру тоқтатылады.</p></div></header><form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" data-confirm="Студенттің белсенділігін тоқтатасыз ба?"><button type="submit" class="btn btn-outline-danger"><i data-lucide="user-x"></i> Белсенділігін тоқтату</button></form></section> }
</div>
