@model EduLibrary.ViewModels.StudentDetailsViewModel
@{ ViewData["Title"] = Model.FullName; }
<div class="workspace-page students-workspace reader-workspace">
<header class="page-header workspace-heading"><div><p class="workspace-kicker">@(Model.CanManage ? UiText.Get("Оқырманның жеке ісі") : UiText.Get("Сіздің жеке кітап сөреңіз")) · @Model.StudentNumber</p><h1>@(Model.CanManage ? Model.FullName : UiText.Get("Менің оқу кеңістігім"))</h1><p>@Model.Faculty · @Model.Course @T["курс ·"] @Model.GroupName</p></div><div class="actions">@if(Model.CanManage) { <a asp-action="Index" class="btn btn-outline-secondary">@T["Студенттер"]</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i data-lucide="pencil"></i> @T["Өңдеу"]</a> } else { <a asp-controller="Recommendations" asp-action="Index" class="btn btn-primary">@T["Келесі кітабымды табу"] <i data-lucide="arrow-up-right"></i></a> }</div></header>
<section class="reader-dossier" aria-label="@T["Оқырман туралы"]">
    <div class="reader-contact">@await Component.InvokeAsync("Avatar", new { userId = Model.IdentityUserId, name = Model.FullName, avatarPath = Model.AvatarPath, size = "large", resolved = true })<div><h2>@Model.FullName</h2><p>@Model.Email<br />@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? UiText.Get("Телефон көрсетілмеген") : Model.PhoneNumber)</p><span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary")">@(Model.IsActive ? UiText.Get("Белсенді оқырман") : UiText.Get("Белсенділігі тоқтатылған"))</span></div></div>
    <dl class="reader-facts"><div><dt>@T["Қолындағы кітаптар"]</dt><dd>@Model.ActiveLoans.Count</dd><small>@Model.ActiveLoans.Count(l => l.OverdueDays > 0) @T["Мерзімі өткен"]</small></div><div><dt>@T["Төленбеген айыппұл"]</dt><dd>@Model.OutstandingFines.ToString("N0") <small>₸</small></dd><small>@T["Бекітілген берешек"]</small></div></dl>
</section>
<section class="record-section"><header class="section-heading"><div><p class="workspace-kicker">@T["Оқу жалғасуда"]</p><h2>@T["Қолындағы кітаптар"]</h2></div><a class="quiet-link" asp-controller="Recommendations" asp-action="Index" asp-route-studentId="@Model.Id">@T["Жеке ұсыныстар"] <i data-lucide="arrow-up-right"></i></a></header>
@if(Model.ActiveLoans.Count == 0) { <div class="empty-state"><i data-lucide="book-open"></i><h3>@T["Келесі жақсы кітапты күтіп тұр."]</h3><p>@T["Қазіргі уақытта қолында кітап жоқ."]</p><a class="btn btn-outline-secondary" asp-controller="Books" asp-action="Index">@T["Каталогты ашу"]</a></div> }
else { <div class="reading-ledger-grid">@foreach(var loan in Model.ActiveLoans) { <article class="reading-loan"><a class="reading-cover-link" asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id" aria-hidden="true" tabindex="-1"><partial name="_BookCover" model='new EduLibrary.ViewModels.BookCoverViewModel { BookId = loan.BookId, Title = loan.BookTitle, Authors = loan.Authors, CoverImageUrl = loan.CoverImageUrl, PublicationYear = loan.PublicationYear, Size = "compact" }'  /></a><div><span class="badge @(loan.OverdueDays > 0 ? "badge-danger" : "badge-success")">@(loan.OverdueDays > 0 ? loan.OverdueDays + UiText.Get(" күн кешіккен") : UiText.Get("Мерзімі өтпеген"))</span><h3 class="mt-3"><a asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id">@loan.BookTitle</a></h3><p>@loan.InventoryNumber</p><p>@T["Қайтару мерзімі:"] <strong>@loan.DueDate.ToString("d")</strong></p><a class="quiet-link" asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id">@T["Беру жазбасын ашу"] <i data-lucide="arrow-up-right"></i></a></div></article> }</div> }
</section>
<section class="interest-notebook"><div><h2>@T["Қызығушылықтары"]</h2>@if(Model.Interests.Count == 0) { <p class="text-muted">@T["Қызығушылықтар көрсетілмеген."]</p> } else { <div class="actions">@foreach(var interest in Model.Interests) { <span class="badge badge-secondary">@interest</span> }</div> }</div><div><h2>@T["Оқитын пәндері"]</h2>@if(Model.Subjects.Count == 0) { <p class="text-muted">@T["Пәндер таңдалмаған."]</p> } else { <div class="actions">@foreach(var subject in Model.Subjects) { <span class="badge badge-secondary">@subject</span> }</div> }<a class="quiet-link mt-3" asp-controller="Recommendations" asp-action="Preferences" asp-route-studentId="@Model.Id">@T["Оқу бағытын толықтыру"] <i data-lucide="arrow-right"></i></a></div></section>
<section class="ledger-panel"><div class="ledger-caption"><div><p class="workspace-kicker">@T["Оқылған кітаптар ізі"]</p><h2>@T["Кітап алу тарихы"]</h2></div><span class="ledger-total">@Model.History.Count @T["жазба"]</span></div>
@if(Model.History.Count == 0) { <div class="empty-state"><p>@T["Қайтарылған кітаптар әлі жоқ."]</p></div> }
else { <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>@T["Кітап / дана"]</th><th>@T["Берілген күні"]</th><th>@T["Мерзімі"]</th><th>@T["Қайтарылған күні"]</th></tr></thead><tbody>@foreach(var loan in Model.History) { <tr><td><a asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id"><strong>@loan.BookTitle</strong></a><span class="record-secondary">@loan.InventoryNumber</span></td><td>@loan.LoanDate.ToString("d")</td><td>@loan.DueDate.ToString("d")</td><td>@loan.ReturnedAt?.ToString("d") @if(loan.OverdueDays > 0) { <span class="badge badge-warning">@loan.OverdueDays @T["күн кешіккен"]</span> }</td></tr> }</tbody></table></div> }
</section>
<section class="ledger-panel"><div class="ledger-caption"><div><p class="workspace-kicker">@T["Қаржылық жазбалар"]</p><h2>@T["Айыппұлдар тарихы"]</h2></div><span class="ledger-total">@Model.Fines.Count @T["жазба"]</span></div>
@if(Model.Fines.Count == 0) { <div class="empty-state"><i data-lucide="check"></i><p>@T["Айыппұлдар жоқ. Жақсы оқу әдетін сақтаңыз."]</p></div> }
else { <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>@T["Кітап / себеп"]</th><th>@T["Күні"]</th><th>@T["Сома"]</th><th>@T["Төленді"]</th><th>@T["Қалдық"]</th></tr></thead><tbody>@foreach(var fine in Model.Fines) { <tr><td>@fine.BookTitle<div class="record-secondary">@fine.Reason</div></td><td>@fine.CreatedAt.ToString("d")</td><td>@fine.Amount.ToString("N2") ₸</td><td>@fine.PaidAmount.ToString("N2") ₸</td><td><span class="badge @(fine.Balance > 0 ? "badge-warning" : "badge-success")">@fine.Balance.ToString("N2") ₸</span></td></tr> }</tbody></table></div> }
</section>
@if(Model.CanManage && Model.IsActive) { <section class="record-section"><header class="section-heading"><div><h2>@T["Оқырман белсенділігін тоқтату"]</h2><p>@T["Кітап алу және төлем тарихы сақталады. Жаңа кітап беру және аккаунтқа кіру тоқтатылады."]</p></div></header><form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" data-confirm="@T["Студенттің белсенділігін тоқтатасыз ба?"]"><button type="submit" class="btn btn-outline-danger"><i data-lucide="user-x"></i> @T["Белсенділігін тоқтату"]</button></form></section> }
</div>
