@model EduLibrary.ViewModels.ProfileViewModel
@{ ViewData["Title"] = T["My profile"].Value; }
<div class="page-header"><div><span class="eyebrow">@T["A space of your own"]</span><h1>@T["My profile"]</h1><p>@T["Your reading identity, preferences, and activity in one place."]</p></div>@if (Model.StudentId.HasValue) { <a asp-controller="ReadingSpace" asp-action="Index" class="btn btn-outline-secondary"><i data-lucide="book-open" aria-hidden="true"></i> @T["My reading space"]</a> }</div>
<div class="profile-layout">
<aside class="profile-index"><div class="profile-current-avatar">@await Component.InvokeAsync("Avatar", new { name = Model.FullName, avatarPath = Model.AvatarPath, size = "large" })</div><h2>@Model.FullName</h2><p>@(Model.Faculty ?? T["EduLibrary member"].Value)</p><nav aria-label="@T["Profile sections"]"><a href="#profile-photo">@T["Profile photo"]</a><a href="#profile-contact">@T["Personal information"]</a>@if (Model.StudentId.HasValue) { <a href="#profile-academic">@T["Academic information"]</a><a href="#profile-interests">@T["Reading interests"]</a> }<a href="#profile-settings">@T["Account settings"]</a>@if (Model.StudentId.HasValue) { <a href="#profile-activity">@T["Reading activity"]</a> }</nav></aside>
<div class="profile-content">
<section id="profile-photo" class="profile-section"><div class="profile-section-heading"><span>01</span><div><h2>@T["Profile photo"]</h2><p>@T["A familiar face across your library."]</p></div></div>
<div class="profile-photo-intro">@await Component.InvokeAsync("Avatar", new { name = Model.FullName, avatarPath = Model.AvatarPath, size = "large" })<div><h3>@T["Make this space yours"]</h3><p>@T["JPG, PNG, or WebP · Up to 2 MB · Saved as a 256 × 256 image"]</p><p>@T["Your photo is visible wherever your library profile appears."]</p></div></div>
<form asp-action="UploadAvatar" method="post" enctype="multipart/form-data" data-avatar-editor
    data-invalid-format="@T["Use a JPG, PNG, or WebP photo."]" data-too-large="@T["The photo must be no larger than 2 MB."]"
    data-invalid-image="@T["The photo cannot be decoded safely."]" data-dimensions="@T["The photo dimensions must not exceed 4096 pixels or 16 megapixels."]"
    data-ready="@T["Photo preview is ready. Adjust the crop, then confirm upload."]" data-uploading="@T["Saving photo…"]">
    <label for="avatar-file" class="form-label">@T[Model.AvatarPath is null ? "Upload a photo" : "Change photo"]</label>
    <input id="avatar-file" type="file" name="File" class="form-control avatar-file-input" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" required />
    <input type="hidden" name="CropX" value="0" /><input type="hidden" name="CropY" value="0" /><input type="hidden" name="CropSize" value="0" />
    <p class="avatar-editor-status" role="status" aria-live="polite" data-avatar-status></p>
    <div class="avatar-editor" hidden>
        <div class="avatar-crop-stage"><canvas width="512" height="512" tabindex="0" role="img" aria-label="@T["Square photo crop. Drag to reposition, or use the controls below."]" data-avatar-canvas></canvas><span class="avatar-crop-guide" aria-hidden="true"></span></div>
        <div class="avatar-editor-controls"><canvas width="160" height="160" class="avatar-circle-preview" role="img" aria-label="@T["Circular avatar preview"]" data-avatar-preview></canvas><p>@T["Drag the photo to reposition it. Arrow keys also move the crop."]</p><label for="avatar-zoom">@T["Zoom"]</label><input id="avatar-zoom" type="range" min="1" max="3" value="1" step="0.02" data-avatar-zoom /><label for="avatar-position-x">@T["Horizontal position"]</label><input id="avatar-position-x" type="range" min="0" max="100" value="50" step="1" data-avatar-x /><label for="avatar-position-y">@T["Vertical position"]</label><input id="avatar-position-y" type="range" min="0" max="100" value="50" step="1" data-avatar-y /></div>
    </div>
    <noscript><p class="text-muted">@T["Without JavaScript, your photo will be cropped to a centered square."]</p></noscript>
    <div class="actions avatar-editor-actions"><button type="submit" class="btn btn-primary" data-avatar-confirm><i data-lucide="upload" aria-hidden="true"></i>@T["Confirm upload"]</button><button type="button" class="btn btn-outline-secondary" data-avatar-cancel hidden>@T["Cancel upload"]</button></div>
</form>
@if (Model.AvatarPath is not null)
{
    <form asp-action="RemoveAvatar" method="post" class="avatar-remove-form"><button type="submit" class="btn btn-link" data-confirm="@T["Remove your profile photo and use initials instead?"]"><i data-lucide="trash-2" aria-hidden="true"></i>@T["Remove photo"]</button></form>
}
</section>
<form asp-action="Profile" method="post" class="profile-form" data-profile-preferences>
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <section id="profile-contact" class="profile-section"><div class="profile-section-heading"><span>02</span><div><h2>@T["Personal information"]</h2><p>@T["Keep your library contact details up to date."]</p></div></div>
    <div class="form-grid"><div><label asp-for="FullName">@T["Full name"]</label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName" class="text-danger"></span></div><div><label asp-for="Email">@T["Email address"]</label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div><div><label asp-for="PhoneNumber">@T["Phone number"]</label><input asp-for="PhoneNumber" class="form-control" autocomplete="tel" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div></div></section>
    @if (Model.StudentId.HasValue)
    {
        <section id="profile-academic" class="profile-section"><div class="profile-section-heading"><span>03</span><div><h2>@T["Academic information"]</h2><p>@T["Contact a librarian to update your academic record."]</p></div></div><dl class="profile-academic"><div><dt>@T["Student number"]</dt><dd>@Model.StudentNumber</dd></div><div><dt>@T["Faculty"]</dt><dd>@Model.Faculty</dd></div><div><dt>@T["Year of study"]</dt><dd>@Model.Course</dd></div><div><dt>@T["Group"]</dt><dd>@Model.GroupName</dd></div></dl></section>
        <section id="profile-interests" class="profile-section"><div class="profile-section-heading"><span>04</span><div><h2>@T["Reading interests"]</h2><p>@T["Your recommendations use these interests and subjects."]</p></div></div><div class="form-grid"><div><label asp-for="Interests">@T["Interests"]</label><textarea asp-for="Interests" class="form-control" rows="5" maxlength="1000" placeholder="@T["Programming, economics, history"]"></textarea><small class="text-muted">@T["Separate names with commas. Up to 20 interests."]</small><span asp-validation-for="Interests" class="text-danger"></span></div><div><label asp-for="SelectedSubjectIds">@T["Subjects"]</label><select asp-for="SelectedSubjectIds" asp-items="Model.Subjects" class="form-select" multiple size="6"></select><small class="text-muted">@T["Use Ctrl / Command to select multiple subjects."]</small><span asp-validation-for="SelectedSubjectIds" class="text-danger"></span></div></div></section>
    }
    <section id="profile-settings" class="profile-section"><div class="profile-section-heading"><span>@(Model.StudentId.HasValue ? "05" : "03")</span><div><h2>@T["Account settings"]</h2><p>@T["Choose how EduLibrary feels to you."]</p></div></div><div class="form-grid"><div><label asp-for="PreferredLanguage">@T["Preferred language"]</label><select asp-for="PreferredLanguage" class="form-select"><option value="kk-KZ">Қазақша</option><option value="ru-RU">Русский</option><option value="en-US">English</option></select><span asp-validation-for="PreferredLanguage" class="text-danger"></span></div><div><label asp-for="PreferredTheme">@T["Preferred theme"]</label><select asp-for="PreferredTheme" class="form-select"><option value="system">@T["Match device"]</option><option value="light">@T["Light"]</option><option value="dark">@T["Dark"]</option></select><span asp-validation-for="PreferredTheme" class="text-danger"></span></div></div></section>
    <div class="profile-save"><span>@T["Your preferences apply after you save."]</span><button class="btn btn-primary" type="submit"><i data-lucide="check" aria-hidden="true"></i> @T["Save changes"]</button></div>
</form>
@if (Model.StudentId.HasValue)
{
    <section id="profile-activity" class="profile-section profile-activity"><div class="profile-section-heading"><span>06</span><div><h2>@T["Reading activity"]</h2><p>@T["Your real library activity, saved to your account."]</p></div></div><dl class="profile-activity-stats"><div><dt>@T["Current loans"]</dt><dd>@Model.ActiveLoanCount</dd></div><div><dt>@T["Returned books"]</dt><dd>@Model.ReturnedLoanCount</dd></div><div><dt>@T["Digital books opened"]</dt><dd>@Model.DigitalBookCount</dd></div><div><dt>@T["Digital books completed"]</dt><dd>@Model.CompletedDigitalBookCount</dd></div></dl>
    <div class="profile-activity-heading"><h3>@T["Digital books"]</h3><a asp-controller="DigitalLibrary" asp-action="My">@T["My digital books"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div>
    @if (Model.DigitalBooks.Count == 0) { <p class="profile-activity-empty">@T["Open a digital book to begin your reading history."]</p> }
    else { <ul class="profile-reading-list">@foreach (var book in Model.DigitalBooks) { <li><div><a href="@book.ReaderUrl">@book.Title</a><span>@book.Format · @(book.CompletedAt.HasValue ? T["Completed"].Value : T["In progress"].Value)</span></div><div class="profile-progress"><progress max="100" value="@book.ProgressPercentage?.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="@T["Reading progress"]"></progress><span>@book.ProgressPercentage?.ToString("0")%</span></div><a href="@book.ReaderUrl" class="profile-continue">@T["Continue reading"]</a></li> }</ul> }
    <div class="profile-activity-heading"><h3>@T["Borrowing history"]</h3><a asp-controller="Loans" asp-action="Index" asp-route-status="all">@T["View all loans"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div>
    @if (Model.RecentLoans.Count == 0) { <p class="profile-activity-empty">@T["Your physical borrowing history will appear here."]</p> }
    else { <ul class="profile-reading-list">@foreach (var loan in Model.RecentLoans) { <li><div><a asp-controller="Loans" asp-action="Details" asp-route-id="@loan.Id">@loan.Title</a><span>@loan.LoanDate.ToString("d") · @(loan.ReturnedAt.HasValue ? T["Returned"].Value : T["On loan"].Value)</span></div><span class="profile-loan-date">@T["Due date"] @loan.DueDate.ToString("d")</span></li> }</ul> }
    </section>
}
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
