@model EduLibrary.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Тіркелу"; }
<div class="account-stage account-stage--register"><aside class="account-editorial"><a asp-controller="Books" asp-action="Index" class="account-wordmark"><i data-lucide="book-open" aria-hidden="true"></i> EduLibrary</a><div class="account-editorial-copy"><span class="account-kicker">Кітапханаға қош келдіңіз</span><h1>Өз оқу<br /> жолыңызды<br /> ашыңыз.</h1><p>Кітаптар, жеке ұсыныстар және оқу тарихыңыз бір кеңістікте.</p><ol class="account-guide"><li><span>01</span> Жеке мәліметтеріңіз</li><li><span>02</span> Академиялық ақпарат</li><li><span>03</span> Қауіпсіз құпиясөз</li></ol></div><div class="account-editorial-footer"><span>Университеттің цифрлық кітапханасы</span></div></aside>
<section class="account-form-panel" aria-labelledby="account-register-title"><div class="account-form-heading"><span class="account-kicker">Жаңа оқырман</span><h2 id="account-register-title">Студент аккаунтын ашу</h2><p>Оқу кеңістігіңіз бірнеше қадамнан басталады.</p></div><form asp-action="Register" method="post" class="account-form">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-grid">
        <div><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" autocomplete="name" /><span asp-validation-for="FullName" class="text-danger"></span></div>
        <div><label asp-for="StudentNumber"></label><input asp-for="StudentNumber" class="form-control" /><span asp-validation-for="StudentNumber" class="text-danger"></span></div>
        <div><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" class="form-control" autocomplete="tel" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
        <div><label asp-for="Faculty"></label><input asp-for="Faculty" class="form-control" /><span asp-validation-for="Faculty" class="text-danger"></span></div>
        <div><label asp-for="Course"></label><input asp-for="Course" class="form-control" /><span asp-validation-for="Course" class="text-danger"></span></div>
        <div><label asp-for="GroupName"></label><input asp-for="GroupName" class="form-control" /><span asp-validation-for="GroupName" class="text-danger"></span></div>
        <div></div>
        <div><label asp-for="Password"></label><div class="password-field"><input asp-for="Password" class="form-control" autocomplete="new-password" /><button type="button" data-password-toggle="Password" aria-controls="Password" aria-pressed="false" aria-label="Құпиясөзді көрсету"><i data-lucide="eye" aria-hidden="true"></i></button></div><small class="text-muted">Кемінде 10 таңба: бас және кіші әріп, сан, арнайы таңба.</small><span asp-validation-for="Password" class="text-danger"></span></div>
        <div><label asp-for="ConfirmPassword"></label><div class="password-field"><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><button type="button" data-password-toggle="ConfirmPassword" aria-controls="ConfirmPassword" aria-pressed="false" aria-label="Құпиясөзді көрсету"><i data-lucide="eye" aria-hidden="true"></i></button></div><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
    </div>
    <p class="account-form-note"><i data-lucide="info" aria-hidden="true"></i> Нөміріңіз кітапханада бұрын тіркелген болса, кітапханашыға хабарласыңыз.</p>
    <button class="btn btn-primary account-submit" type="submit">Аккаунт ашу <i data-lucide="arrow-right" aria-hidden="true"></i></button>
</form><p class="account-switch">Аккаунтыңыз бар ма? <a asp-action="Login">Жүйеге кіру</a></p></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
