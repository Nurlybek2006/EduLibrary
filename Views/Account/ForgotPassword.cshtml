@{ ViewData["Title"] = UiText.Get("Құпиясөзге қатысты көмек"); }
<div class="account-stage account-stage--help"><aside class="account-editorial"><a asp-controller="Books" asp-action="Index" class="account-wordmark"><i data-lucide="book-open" aria-hidden="true"></i> EduLibrary</a><div class="account-editorial-copy"><span class="account-kicker">@T["Оқу жолыңыз жалғассын"]</span><h1>@T["Қайта кіруге"]<br /> @T["көмектесеміз."]</h1><p>@T["Аккаунтыңызға қатысты сұрақты кітапхана қызметкерімен бірге шешіңіз."]</p></div><div class="account-editorial-footer"><span>@T["Университеттің цифрлық кітапханасы"]</span></div></aside><section class="account-form-panel"><span class="account-help-icon"><i data-lucide="key-round" aria-hidden="true"></i></span><div class="account-form-heading"><span class="account-kicker">@T["Кіруге қатысты көмек"]</span><h2>@T["Құпиясөзді ұмыттыңыз ба?"]</h2><p>@T["Қолжетімділікті қалпына келтіру тәртібін білу үшін кітапхана қызметкеріне хабарласыңыз."]</p></div><div class="account-help-steps"><p><strong>@T["Алдымен"]</strong> @T["кірген кезде қолданатын электрондық поштаны тексеріңіз."]</p><p><strong>@T["Көмек сұрағанда"]</strong> @T["аккаунтыңыздың поштасын немесе студент нөмірін дайындаңыз."]</p><p>@T["Бұл бет электрондық хат жібермейді және құпиясөзді автоматты өзгертпейді."]</p></div><a asp-action="Login" class="btn btn-primary account-submit"><i data-lucide="arrow-left" aria-hidden="true"></i> @T["Жүйеге кіруге оралу"]</a><a asp-controller="Books" asp-action="Index" class="account-catalog-link">@T["Әзірге каталогты қарау"]</a></section></div>
