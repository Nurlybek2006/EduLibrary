@model EduLibrary.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Жүйеге кіру"; }
<div class="auth-shell">
    <div class="auth-intro"><span class="eyebrow">EDULIBRARY · АКАДЕМИЯЛЫҚ КІТАПХАНА</span><h1>Білімге бастайтын<br />бір қадам.</h1><p>Кітаптарыңыз, оқу тарихыңыз және академиялық әлеміңіз — бір кеңістікте.</p><div class="auth-decoration"><i data-lucide="library-big"></i></div></div>
    <section class="card auth-card"><span class="eyebrow">ҚАЙТА ҚОШ КЕЛДІҢІЗ</span><h2>Жүйеге кіру</h2><p class="text-muted">Жеке кітапхана кеңістігіңізді ашыңыз.</p>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@university.kz" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="mb-3 form-check"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
            <button class="btn btn-primary w-100" type="submit">Кіру <i data-lucide="arrow-right"></i></button>
        </form>
        <p class="mt-4 text-muted">Аккаунтыңыз жоқ па? <a asp-action="Register">Тіркелу</a></p>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
