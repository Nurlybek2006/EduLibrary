@model EduLibrary.ViewModels.BookCatalogViewModel
@{ViewData["Title"]="Кітаптар каталогы";var staff=User.IsInRole("Admin")||User.IsInRole("Librarian");}
<div class="page-header"><div><span class="eyebrow">БІЛІМГЕ ЖОЛ АШЫҢЫЗ</span><h1>Кітаптар каталогы</h1><p>Оқуға, зерттеуге және жаңа идеяларға арналған @Model.TotalCount кітап.</p></div><div class="actions">@if(User.Identity?.IsAuthenticated==true){<a class="btn btn-outline-secondary" asp-controller="Recommendations" asp-action="Index"><i data-lucide="sparkles"></i>Маған арналған</a>}@if(staff){<a class="btn btn-primary" asp-action="Create"><i data-lucide="plus"></i>Кітап қосу</a>}</div></div>
<section class="catalog-hero"><div><span class="eyebrow">БІЛІМДІҢ ЖАҢА КӨКЖИЕКТЕРІ</span><h2>Келесі идеяңыз осы жерде.</h2><p>Академиялық қордан өзіңізге қажетті әдебиетті табыңыз.</p></div><div class="catalog-hero-mark" aria-hidden="true"><i data-lucide="book-open-check"></i></div></section>
<form method="get" id="catalog-filter" class="card filter-card mb-4" role="search" aria-label="Кітаптарды іздеу және сүзу"><div class="catalog-search"><i data-lucide="search"></i><label class="visually-hidden" for="catalog-search">Кітап іздеу</label><input id="catalog-search" name="Search" value="@Model.Filter.Search" class="form-control" placeholder="Кітап, автор, ISBN, пән немесе тақырып іздеңіз…" maxlength="200" autocomplete="off"/><span class="search-key-hint">Каталог</span></div>
<div class="form-grid catalog-filter-grid"><div><label for="catalog-author">Автор</label><select id="catalog-author" name="AuthorId" class="form-select"><option value="">Барлық авторлар</option>@foreach(var item in Model.Authors){<option value="@item.Value" selected="@(item.Value==Model.Filter.AuthorId?.ToString())">@item.Text</option>}</select></div><div><label for="catalog-publisher">Баспа</label><select id="catalog-publisher" name="PublisherId" class="form-select"><option value="">Барлық баспалар</option>@foreach(var item in Model.Publishers){<option value="@item.Value" selected="@(item.Value==Model.Filter.PublisherId?.ToString())">@item.Text</option>}</select></div><div><label for="catalog-category">Санат</label><select id="catalog-category" name="CategoryId" class="form-select"><option value="">Барлық санаттар</option>@foreach(var item in Model.Categories){<option value="@item.Value" selected="@(item.Value==Model.Filter.CategoryId?.ToString())">@item.Text</option>}</select></div><div><label for="catalog-subject">Пән</label><select id="catalog-subject" name="SubjectId" class="form-select"><option value="">Барлық пәндер</option>@foreach(var item in Model.Subjects){<option value="@item.Value" selected="@(item.Value==Model.Filter.SubjectId?.ToString())">@item.Text</option>}</select></div><div><label for="catalog-language">Тілі</label><select id="catalog-language" name="Language" class="form-select"><option value="">Барлық тілдер</option>@foreach(var item in Model.Languages){<option value="@item.Value" selected="@(item.Value==Model.Filter.Language)">@item.Text</option>}</select></div><div><label for="catalog-sort">Реті</label><select id="catalog-sort" name="Sort" class="form-select"><option value="title" selected="@(Model.Filter.Sort=="title")">Атауы бойынша</option><option value="year" selected="@(Model.Filter.Sort=="year")">Жаңа басылымдар</option><option value="popularity" selected="@(Model.Filter.Sort=="popularity")">Танымалдығы бойынша</option><option value="rating" selected="@(Model.Filter.Sort=="rating")">Рейтингі бойынша</option></select></div></div>
<div class="catalog-filter-bottom"><div class="actions"><label class="form-check-label"><input class="form-check-input" type="checkbox" name="AvailableOnly" value="true" checked="@Model.Filter.AvailableOnly"/> Тек қолжетімді</label>@if(staff){<label class="form-check-label"><input class="form-check-input" type="checkbox" name="IncludeArchived" value="true" checked="@Model.Filter.IncludeArchived"/> Мұрағатпен бірге</label>}</div><div class="actions"><a class="btn btn-outline-secondary" asp-action="Index">Тазарту</a><button class="btn btn-primary" type="submit"><i data-lucide="search"></i>Іздеу</button></div></div></form>
<div class="catalog-toolbar"><span id="catalog-status" class="text-muted" aria-live="polite">Кітапхана қорын зерттеңіз</span><div class="view-switch" aria-label="Каталог көрінісі"><button type="button" data-catalog-view="grid" aria-label="Тор көрінісі" aria-pressed="true"><i data-lucide="layout-grid"></i></button><button type="button" data-catalog-view="list" aria-label="Тізім көрінісі" aria-pressed="false"><i data-lucide="list"></i></button></div></div>
<div id="catalog-results"><partial name="_Results" model="Model"/></div>
@section Scripts{<script src="~/js/catalog.js" asp-append-version="true"></script>}
