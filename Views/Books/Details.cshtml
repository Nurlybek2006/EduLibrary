@model EduLibrary.ViewModels.BookDetailsViewModel
@using EduLibrary.Models.Enums
@{
    ViewData["Title"] = Model.Book.Title;
    var staff = User.IsInRole("Admin") || User.IsInRole("Librarian");
    var description = string.IsNullOrWhiteSpace(Model.Description) ? "Бұл кітаптың сипаттамасы әлі қосылмаған." : Model.Description;
    var introduction = description.Length > 280 ? description[..280].TrimEnd() + "…" : description;
    var cover = new EduLibrary.ViewModels.BookCoverViewModel { BookId = Model.Book.Id, Title = Model.Book.Title, Authors = Model.Book.Authors, CoverImageUrl = Model.Book.CoverImageUrl, PublicationYear = Model.Book.PublicationYear, Category = Model.Categories.FirstOrDefault(), Size = "large", EagerLoad = true };
}
<article class="book-product-page">
    <nav class="book-breadcrumb" aria-label="Бет жолы"><a asp-action="Index">Кітаптар каталогы</a><i data-lucide="chevron-right" aria-hidden="true"></i><span>Кітап туралы</span></nav>
    @if (Model.Book.IsArchived) { <div class="alert alert-warning" role="status">Кітап мұрағатта. Оның даналары оқырманға берілмейді.</div> }
    <div class="book-product">
        <div class="book-product-art"><div class="book-product-jacket"><partial name="_BookCover" model="cover" /></div><div class="book-art-caption"><i data-lucide="book-open" aria-hidden="true"></i><span>@Model.PageCount бет · @Model.Book.Language</span></div></div>
        <div class="book-product-content">
            <div class="book-product-categories">@foreach (var category in Model.Categories) { <a asp-action="Index" asp-route-search="@category">@category</a> }</div>
            <h1>@Model.Book.Title</h1>
            <p class="book-product-author">@Model.Book.Authors</p>
            <div class="book-product-rating"><span class="book-rating-star" aria-hidden="true">★</span><strong>@(Model.Book.ReviewCount > 0 ? Model.Book.AverageRating.ToString("0.0") : "—")</strong><a href="#reviews">@(Model.Book.ReviewCount > 0 ? $"{Model.Book.ReviewCount} оқырман пікірі" : "Алғашқы пікірді жазыңыз")</a><span class="product-rating-divider"></span><span>@Model.Book.PublicationYear жылғы басылым</span></div>
            <p class="book-product-introduction">@introduction</p>
            @if (Model.RecommendationContext is not null) { <aside class="recommendation-context"><i data-lucide="sparkles" aria-hidden="true"></i><div><strong>@Model.RecommendationContext.Score.ToString("0.#")% жеке сәйкестік</strong><span>Соңғы жеке ұсынысыңыздың нәтижесі.</span></div><a asp-controller="Recommendations" asp-action="Index" aria-label="Жеке ұсыныстарды қарау"><i data-lucide="arrow-up-right" aria-hidden="true"></i></a></aside> }
            <dl class="book-product-meta"><div><dt>Баспа</dt><dd>@Model.Book.Publisher</dd></div><div><dt>Тілі</dt><dd>@Model.Book.Language</dd></div><div><dt>Беттер саны</dt><dd>@Model.PageCount</dd></div><div><dt>ISBN</dt><dd>@Model.Book.ISBN</dd></div></dl>
            <div class="book-stock-panel"><div><span class="book-availability @(Model.Book.AvailableCopies > 0 ? "is-available" : "is-unavailable")"><span></span>@(Model.Book.AvailableCopies > 0 ? "Кітапханада қолжетімді" : "Қазір бос дана жоқ")</span><p><strong>@Model.Book.AvailableCopies</strong> қолжетімді <span>/ @Model.Book.TotalCopies дана</span></p></div><a href="#physical-copies" class="btn btn-primary">Даналарды көру <i data-lucide="arrow-down" aria-hidden="true"></i></a></div>
            @if (staff) { <div class="book-staff-actions"><a asp-action="Edit" asp-route-id="@Model.Book.Id"><i data-lucide="pencil" aria-hidden="true"></i> Кітапты өзгерту</a>@if (!Model.Book.IsArchived) { <a asp-controller="Copies" asp-action="Create" asp-route-bookId="@Model.Book.Id"><i data-lucide="plus" aria-hidden="true"></i> Дана қосу</a> }@if (Model.Book.IsArchived) { <form asp-action="Restore" asp-route-id="@Model.Book.Id" method="post"><button type="submit">Мұрағаттан қалпына келтіру</button></form> }else { <form asp-action="Archive" asp-route-id="@Model.Book.Id" method="post" data-confirm="Кітап мұрағатқа көшірілсін бе? Берілу тарихы сақталады."><button type="submit"><i data-lucide="archive" aria-hidden="true"></i> Мұрағатқа көшіру</button></form> }</div> }
        </div>
    </div>
    <nav class="book-section-nav" aria-label="Кітап бөлімдері"><a href="#about-book">Кітап туралы</a><a href="#physical-copies">Қолжетімді даналар <span>@Model.Book.AvailableCopies</span></a><a href="#reviews">Пікірлер <span>@Model.Book.ReviewCount</span></a><a href="#related-books">Ұқсас әдебиеттер</a></nav>
    <section class="book-about-section" id="about-book"><div><span class="section-caption">Оқырманға</span><h2>Осы кітап туралы</h2></div><div><p class="preserve-lines">@description</p>@if (Model.Subjects.Count > 0) { <div class="book-subjects"><span>Оқу пәндері</span><div>@foreach (var subject in Model.Subjects) { <a asp-action="Index" asp-route-search="@subject">@subject</a> }</div></div> }</div></section>
    <section class="book-copies-section" id="physical-copies"><header class="book-section-heading"><div><span class="section-caption">Кітапхана қоры</span><h2>Физикалық даналар</h2></div><span>@Model.Copies.Count дана тіркелген</span></header>
    @if (Model.Copies.Count == 0) { <div class="empty-state"><i data-lucide="library" aria-hidden="true"></i><h3>Даналар әлі тіркелмеген</h3><p>Кітапхана қызметкері физикалық даналарды қоса алады.</p></div> }
    else { <div class="table-responsive"><table class="table"><thead><tr><th>Түгендеу нөмірі</th><th>Сөредегі орны</th><th>Жағдайы</th><th>Мәртебесі</th>@if (staff) { <th>Әрекет</th> }</tr></thead><tbody>@foreach (var copy in Model.Copies) { <tr><td>@if (staff) { <a asp-controller="Copies" asp-action="Details" asp-route-id="@copy.Id"><strong>@copy.InventoryNumber</strong></a> }else { <strong>@copy.InventoryNumber</strong> }</td><td>@copy.ShelfLocation</td><td>@copy.Condition</td><td><span class="badge @(copy.Status == CopyStatus.Available ? "badge-success" : copy.Status == CopyStatus.Lost ? "badge-danger" : "badge-warning")">@copy.StatusLabel</span></td>@if (staff) { <td><div class="actions">@if (copy.Status == CopyStatus.Available && !Model.Book.IsArchived) { <a asp-controller="Loans" asp-action="Create" asp-route-copyId="@copy.Id" class="btn btn-sm btn-primary">Кітап беру</a> }@if (copy.Status != CopyStatus.OnLoan) { <a asp-controller="Copies" asp-action="Edit" asp-route-id="@copy.Id" class="btn btn-sm btn-outline-secondary">Өзгерту</a> }</div></td> }</tr> }</tbody></table></div> }
    </section>
    @await Component.InvokeAsync("BookReviews", new { bookId = Model.Book.Id })
    @await Component.InvokeAsync("RelatedBooks", new { bookId = Model.Book.Id })
</article>
