@model EduLibrary.ViewModels.BookCatalogViewModel
<div class="catalog-results-summary" data-result-count="@Model.TotalCount"><span><strong>@Model.TotalCount</strong> кітап табылды</span><span>@Model.Filter.Page / @Model.TotalPages бет</span></div>
@if(Model.Books.Count==0){<div class="card empty-state"><i data-lucide="search-x"></i><h2>Кітап табылмады</h2><p>Іздеу сөзін немесе сүзгілерді өзгертіп көріңіз.</p><a asp-action="Index" class="btn btn-primary">Барлық кітаптар</a></div>}
else{
<div class="book-grid" id="book-grid">@foreach(var book in Model.Books){<article class="book-card card"><a asp-action="Details" asp-route-id="@book.Id" class="book-cover" tabindex="-1" aria-hidden="true">@if(!string.IsNullOrEmpty(book.CoverImageUrl)){<img src="@book.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer"/>}else{<div class="book-cover-placeholder" data-tone="@(book.Id%5)"><span>EDU<br/>LIBRARY</span><i data-lucide="book-open"></i><strong>@book.Title</strong><small>@book.PublicationYear</small></div>}</a><div class="book-card-body"><div class="actions"><span class="badge badge-muted">@book.Language</span><span class="rating-label"><i data-lucide="star"></i>@(book.ReviewCount>0?book.AverageRating.ToString("0.0"):"—")<small>(@book.ReviewCount)</small></span></div><h2><a asp-action="Details" asp-route-id="@book.Id">@book.Title</a></h2><p class="text-muted book-authors">@book.Authors</p><div class="book-category-tags">@foreach(var category in book.Categories.Take(2)){<span>@category</span>}</div><div class="book-card-footer">@if(book.IsArchived){<span class="badge badge-muted">Мұрағатта</span>}else if(book.AvailableCopies>0){<span class="badge badge-success">@book.AvailableCopies / @book.TotalCopies қолжетімді</span>}else{<span class="badge badge-warning">Қазір қолжетімсіз</span>}<a asp-action="Details" asp-route-id="@book.Id" class="icon-link" aria-label="@book.Title — толығырақ"><i data-lucide="arrow-up-right"></i></a></div></div></article>}</div>
@if(Model.TotalPages>1){<nav class="pagination" aria-label="Каталог беттері">@for(var page=Math.Max(1,Model.Filter.Page-2);page<=Math.Min(Model.TotalPages,Model.Filter.Page+2);page++){<a asp-action="Index" asp-route-page="@(page)" asp-route-search="@Model.Filter.Search" asp-route-authorId="@Model.Filter.AuthorId" asp-route-publisherId="@Model.Filter.PublisherId" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-subjectId="@Model.Filter.SubjectId" asp-route-language="@Model.Filter.Language" asp-route-sort="@Model.Filter.Sort" asp-route-availableOnly="@Model.Filter.AvailableOnly" asp-route-includeArchived="@Model.Filter.IncludeArchived" class="btn @(page==Model.Filter.Page?"btn-primary":"btn-outline-secondary")" aria-current="@(page==Model.Filter.Page?"page":null)">@(page)</a>}<span class="text-muted">@Model.Filter.Page / @Model.TotalPages бет</span></nav>}
}
