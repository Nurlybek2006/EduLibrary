@model EduLibrary.ViewModels.BookCatalogViewModel
<div class="catalog-results-summary" data-result-count="@Model.TotalCount"><div><h2>@(string.IsNullOrWhiteSpace(Model.Filter.Search) ? "Кітапхана сөресі" : "Іздеу нәтижелері")</h2><span><strong>@Model.TotalCount</strong> кітап</span></div><span>@Model.Filter.Page / @Model.TotalPages бет</span></div>
@if (Model.Books.Count == 0)
{
    <div class="catalog-empty-state"><span class="catalog-empty-symbol"><i data-lucide="search-x" aria-hidden="true"></i></span><h2>Кітап табылмады.</h2><p>Басқа іздеу сөзін қолданып немесе сүзгілерді өзгертіп көріңіз.</p><a asp-action="Index" class="btn btn-primary">Барлық кітапты көру</a></div>
}
else
{
    <div class="editorial-book-grid" id="book-grid">
    @foreach (var book in Model.Books)
    {
        <partial name="_BookCard" model="new EduLibrary.ViewModels.BookCardPresentationViewModel { BookId = book.Id, Title = book.Title, Authors = book.Authors, CoverImageUrl = book.CoverImageUrl, PublicationYear = book.PublicationYear, Category = book.Categories.FirstOrDefault(), AverageRating = book.AverageRating, ReviewCount = book.ReviewCount, AvailableCopies = book.AvailableCopies, TotalCopies = book.TotalCopies, IsArchived = book.IsArchived, Language = book.Language }" />
    }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="pagination catalog-pagination" aria-label="Каталог беттері">
        @for (var pageNumber = Math.Max(1, Model.Filter.Page - 2); pageNumber <= Math.Min(Model.TotalPages, Model.Filter.Page + 2); pageNumber++)
        {
            <a asp-action="Index" asp-route-page="@pageNumber" asp-route-search="@Model.Filter.Search" asp-route-authorId="@Model.Filter.AuthorId" asp-route-publisherId="@Model.Filter.PublisherId" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-subjectId="@Model.Filter.SubjectId" asp-route-language="@Model.Filter.Language" asp-route-sort="@Model.Filter.Sort" asp-route-availableOnly="@Model.Filter.AvailableOnly" asp-route-includeArchived="@Model.Filter.IncludeArchived" class="@(pageNumber == Model.Filter.Page ? "is-current" : "")" aria-current="@(pageNumber == Model.Filter.Page ? "page" : null)">@pageNumber</a>
        }
        <span>@Model.TotalCount кітаптың @(((Model.Filter.Page - 1) * 12) + 1)–@(Math.Min(Model.Filter.Page * 12, Model.TotalCount)) аралығы</span>
        </nav>
    }
}
