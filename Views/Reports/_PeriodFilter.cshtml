@model EduLibrary.ViewModels.ReportFilterViewModel
<div>
    <label for="Range" class="form-label">@T["Кезең"]</label>
    <select id="Range" name="Range" class="form-select" data-period-range>
        <option value="7" selected="@(Model.Range == "7")">@T["Соңғы 7 күн"]</option>
        <option value="30" selected="@(Model.Range == "30")">@T["Соңғы 30 күн"]</option>
        <option value="90" selected="@(Model.Range == "90")">@T["Соңғы 90 күн"]</option>
        <option value="year" selected="@(Model.Range == "year")">@T["Осы жыл"]</option>
        <option value="custom" selected="@(Model.Range == "custom")">@T["Өз кезеңім"]</option>
    </select>
</div>
<div data-period-custom><label for="StartDate" class="form-label">@T["Басталу күні"]</label><input id="StartDate" name="StartDate" type="date" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" /></div>
<div data-period-custom><label for="EndDate" class="form-label">@T["Аяқталу күні"]</label><input id="EndDate" name="EndDate" type="date" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" /></div>
