@model EduLibrary.ViewModels.NotificationPageViewModel
@{ ViewData["Title"] = UiText.Get("Хабарландырулар"); }
<div class="workspace-page notifications-workspace">
<header class="page-header workspace-heading"><div><p class="workspace-kicker">@T["Кітапханамен байланыста"]</p><h1>@T["Хабарландырулар"]</h1><p>@T["Оқу жолыңыздағы маңызды күндер мен кітапхана жаңалықтары."]</p></div>@if(Model.UnreadCount > 0) { <form asp-action="ReadAll" method="post"><button class="btn btn-outline-secondary" type="submit"><i data-lucide="check-check"></i> @T["Барлығын оқу"]</button></form> }</header>
<nav class="tab-bar" aria-label="@T["Хабарландыру көрінісі"]"><a class="@(!Model.UnreadOnly ? "active" : "")" asp-action="Index">@T["Барлық хаттар"] <span>@Model.TotalCount</span></a><a class="@(Model.UnreadOnly ? "active" : "")" asp-action="Index" asp-route-unreadOnly="true">@T["Оқылмаған"] <span>@Model.UnreadCount</span></a></nav>
<section class="notification-list" aria-label="@T["Кітапхана хабарлары"]">
@if(Model.Items.Count == 0) { <div class="empty-state"><i data-lucide="bell-off"></i><h2>@(Model.UnreadOnly ? UiText.Get("Барлық хабарландыру оқылды") : UiText.Get("Хабарландырулар әлі жоқ"))</h2><p>@T["Брондау, кезек, алып кету мерзімі, кітап беру және қайтару туралы хабарлар осында сақталады."]</p><div class="actions"><a class="btn btn-outline-secondary" asp-controller="Books" asp-action="Index">@T["Кітаптарға оралу"]</a><a class="btn btn-outline-secondary" asp-controller="Reservations" asp-action="Index">@T["Броньдарды көру"]</a></div></div> }
@foreach(var item in Model.Items)
{
    <article class="notification-item @(item.IsRead ? "" : "unread")">
        <span class="notification-symbol" aria-hidden="true"><i data-lucide="@(item.Type.StartsWith("Reservation", StringComparison.Ordinal) ? "bookmark-check" : item.Type == "Overdue" ? "alarm-clock" : item.Type == "Fine" ? "receipt" : "mail-open")"></i></span>
        <div><time datetime="@item.CreatedAt.ToString("yyyy-MM-ddTHH:mm")">@item.CreatedAt.ToString("dd MMMM yyyy") · @item.CreatedAt.ToString("HH:mm")</time><h2>@item.Title</h2><p>@item.Message</p><div class="actions"><a class="btn btn-outline-secondary" href="@item.Link">@T["Жазбаны ашу"] <i data-lucide="arrow-up-right"></i></a>@if(!item.IsRead) { <form asp-action="Read" asp-route-id="@item.Id" method="post"><button class="btn btn-link" type="submit">@T["Оқылды деп белгілеу"]</button></form> }</div></div>
        @if(!item.IsRead) { <span class="unread-dot" aria-label="@T["Оқылмаған"]"></span> }
    </article>
}
</section>
@if(Model.TotalPages > 1) { <nav class="pagination" aria-label="@T["Хабарландыру беттері"]">@for(var page = Math.Max(1, Model.Page - 2); page <= Math.Min(Model.TotalPages, Model.Page + 2); page++) { <a class="btn @(page == Model.Page ? "btn-primary" : "btn-outline-secondary")" asp-action="Index" asp-route-page="@(page)" asp-route-unreadOnly="@Model.UnreadOnly">@(page)</a> }</nav> }
</div>
