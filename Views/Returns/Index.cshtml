@model EduLibrary.ViewModels.ReturnListViewModel
@{ ViewData["Title"] = "Қайтарылған кітаптар"; }
<div class="workspace-page returns-workspace index-workspace">
<div class="page-header workspace-heading"><div><span class="eyebrow">КІТАП АЙНАЛЫМЫ</span><h1>Қайтарылған кітаптар</h1><p>Қабылданған даналардың сақталған тарихы.</p></div><a class="btn btn-primary" asp-controller="Loans" asp-action="Index">Кітап қабылдау</a></div>
<div class="card ledger-panel"><form method="get" class="filter-bar ledger-toolbar" role="search"><label class="visually-hidden" for="return-search">Іздеу</label><input id="return-search" class="form-control" name="search" value="@Model.Search" placeholder="Кітап, студент немесе инвентарлық нөмір" /><button class="btn btn-primary" type="submit">Іздеу</button><a class="btn btn-secondary" asp-action="Index">Тазарту</a></form>
@if(Model.Items.Count == 0) { <div class="empty-state"><i data-lucide="book-check"></i><h2>Қайтару жазбалары табылмады</h2><p>Қабылданған кітаптар осы жерде көрсетіледі.</p></div> }
else { <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>Кітап / дана</th><th>Оқырман</th><th>Қайтарылған күні</th><th>Жағдайы</th><th>Айыппұл</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items) { <tr><td><strong>@item.BookTitle</strong><small class="d-block text-muted">@item.InventoryNumber</small></td><td>@item.StudentName</td><td>@item.ReturnDate.ToString("dd.MM.yyyy")</td><td><span class="badge">@item.ReturnCondition</span></td><td>@item.FineAmount.ToString("N2") ₸</td><td><a class="btn btn-sm btn-secondary" asp-controller="Loans" asp-action="Details" asp-route-id="@item.LoanId">Жазбаны ашу</a></td></tr> }</tbody></table></div> }
<div class="pagination-bar"><span class="text-muted">Барлығы: @Model.TotalCount жазба</span><div class="actions">@if(Model.Page > 1) { <a class="btn btn-secondary btn-sm" asp-route-search="@Model.Search" asp-route-page="@(Model.Page-1)">Алдыңғы</a> }<span>@Model.Page / @Math.Max(1, Model.TotalPages)</span>@if(Model.Page < Model.TotalPages) { <a class="btn btn-secondary btn-sm" asp-route-search="@Model.Search" asp-route-page="@(Model.Page+1)">Келесі</a> }</div></div></div>
</div>
