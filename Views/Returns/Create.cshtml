@model EduLibrary.ViewModels.ReturnLoanViewModel
@{ ViewData["Title"] = "Кітап қабылдау"; }
<div class="page-header"><div><span class="eyebrow">КІТАП АЙНАЛЫМЫ</span><h1>Кітап қабылдау</h1><p>Дананың жағдайын тексеріп, қайтарылған күнін белгілеңіз.</p></div><a class="btn btn-secondary" asp-controller="Loans" asp-action="Details" asp-route-id="@Model.LoanId">Жазбаға оралу</a></div>
<div class="card form-card"><div class="card-header"><div><h2>@Model.BookTitle</h2><p class="text-muted">@Model.InventoryNumber · @Model.StudentName</p></div><span class="badge badge-warning">Мерзімі: @Model.DueDate.ToString("dd.MM.yyyy")</span></div>
<form asp-action="Create" method="post"><input asp-for="LoanId" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><div class="form-grid"><div><label asp-for="ReturnDate" class="form-label"></label><input asp-for="ReturnDate" class="form-control" /><span asp-validation-for="ReturnDate" class="text-danger"></span></div><div><label asp-for="ReturnCondition" class="form-label"></label><select asp-for="ReturnCondition" class="form-select"><option value="Good">Жақсы — қайта беруге дайын</option><option value="Damaged">Зақымдалған — тексеру қажет</option></select><span asp-validation-for="ReturnCondition" class="text-danger"></span></div></div><div class="mb-4"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" maxlength="2000"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div><div class="alert alert-info">Бүгінгі болжам: <strong>@Model.OverdueDays күн · @Model.EstimatedFine.ToString("N2") ₸</strong>. Тариф: күніне @Model.FinePerOverdueDay.ToString("N2") ₸. Нақты сома таңдалған қайтару күні бойынша есептеледі.</div><div class="actions"><button class="btn btn-primary" type="submit"><i data-lucide="book-check"></i> Қабылдауды растау</button><a class="btn btn-secondary" asp-controller="Loans" asp-action="Details" asp-route-id="@Model.LoanId">Бас тарту</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
