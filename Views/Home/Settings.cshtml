@model EduLibrary.Helpers.LibraryOptions
@{ ViewData["Title"]="Баптаулар"; }
<div class="page-header"><div><div class="eyebrow">ЖҮЙЕ</div><h1>Кітапхана саясаты</h1><p>Кітап беру мен айыппұл есептеудің ағымдағы параметрлері.</p></div></div>
