@model EduLibrary.Helpers.LibraryOptions
@{ ViewData["Title"]=UiText.Get("Баптаулар"); }
<article class="information-page"><header class="information-heading"><span class="eyebrow">@T["КІТАПХАНАНЫҢ ЖҰМЫС ТӘРТІБІ"]</span><h1>@T["Ортақ ережелер."]<br />@T["Түсінікті қызмет."]</h1><p class="text-muted">@T["Кітап беру мен айыппұл есептеудің ағымдағы саясаты."]</p></header><dl class="policy-values"><div><dt>@T["Стандартты беру мерзімі"]</dt><dd>@Model.DefaultLoanDays @T["Күн"]</dd></div><div><dt>@T["Бір күндік кешігу айыппұлы"]</dt><dd>@Model.FinePerOverdueDay.ToString("N2") ₸</dd></div><div><dt>@T["Кітапхана уақыты"]</dt><dd>Asia/Qyzylorda</dd></div></dl><p class="information-body text-muted">@T["Бұл параметрлер барлық жаңа беру операциясына қолданылады. Саясатты өзгерту үшін сервердегі Library конфигурациясын жаңартып, қосымшаны қайта іске қосыңыз."]</p><a class="btn btn-primary" asp-controller="Staff" asp-action="Index">@T["Қызметкерлерді басқару"] <i data-lucide="arrow-up-right"></i></a></article>
