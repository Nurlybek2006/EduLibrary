@model EduLibrary.ViewModels.ReviewModerationViewModel
@{ ViewData["Title"] = UiText.Get("Пікірлерді модерациялау"); }
<div class="workspace-page reviews-workspace index-workspace">
<div class="page-header workspace-heading"><div><p class="eyebrow">@T["ҚАУЫМДАСТЫҚ САПАСЫ"]</p><h1>@T["Пікірлерді модерациялау"]</h1><p class="text-muted">@T["Жария пікірлер ғана кітаптың орташа бағасына және ұсыныстарға қосылады."]</p></div><span class="badge badge-muted">@Model.TotalCount @T["Пікір"]</span></div>
<form method="get" class="card ledger-panel mb-4"><input name="BookId" type="hidden" value="@Model.BookId" /><div class="form-grid"><div><label for="review-search">@T["Іздеу"]</label><input id="review-search" name="Search" value="@Model.Search" class="form-control" placeholder="@T["Кітап, оқырман немесе пікір мәтіні"]" maxlength="200" /></div><div><label for="review-status">@T["Мәртебесі"]</label><select id="review-status" name="Status" class="form-select"><option value="active" selected="@(Model.Status == "active")">@T["Белсенді пікірлер"]</option><option value="visible" selected="@(Model.Status == "visible")">@T["Жарияланған"]</option><option value="hidden" selected="@(Model.Status == "hidden")">@T["Жасырылған"]</option><option value="deleted" selected="@(Model.Status == "deleted")">@T["Автор жойған"]</option><option value="all" selected="@(Model.Status == "all")">@T["Барлығы"]</option></select></div></div><div class="actions mt-3"><button class="btn btn-primary" type="submit">@T["Іздеу"]</button><a asp-action="Index" class="btn btn-outline-secondary">@T["Тазарту"]</a></div></form>
<div class="card ledger-panel">
@if (Model.Reviews.Count == 0) { <div class="empty-state"><i data-lucide="messages-square" aria-hidden="true"></i><h2>@T["Пікірлер табылмады"]</h2><p>@T["Іздеу шарттарын өзгертіңіз. Жаңа пікірлер осы жерде көрінеді."]</p></div> }
else { <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>@T["Кітап / оқырман"]</th><th>@T["Баға / пікір"]</th><th>@T["Күні"]</th><th>@T["Мәртебе"]</th><th>@T["Әрекет"]</th></tr></thead><tbody>@foreach (var review in Model.Reviews) { <tr><td><a asp-controller="Books" asp-action="Details" asp-route-id="@review.BookId" asp-fragment="reviews"><strong>@review.BookTitle</strong></a><div class="avatar-identity mt-2">@await Component.InvokeAsync("Avatar", new { userId = review.ReviewerUserId, name = review.ReviewerLabel, avatarPath = review.AvatarPath, size = "tiny", resolved = true })<small class="text-muted">@review.ReviewerLabel</small></div></td><td><span class="review-stars">@review.Rating ★</span><p class="preserve-lines">@review.Comment</p></td><td>@review.CreatedAt.ToString("d")</td><td><span class="badge @(review.IsDeleted ? "badge-muted" : review.IsHidden ? "badge-warning" : "badge-success")">@(review.IsDeleted ? UiText.Get("Жойылған") : review.IsHidden ? UiText.Get("Жасырылған") : UiText.Get("Жарияланған"))</span></td><td>@if (!review.IsDeleted) { <form asp-action="Moderate" asp-route-id="@review.Id" method="post" data-confirm="@T["Пікірдің жариялану мәртебесі өзгертілсін бе?"]"><input name="hidden" type="hidden" value="@((!review.IsHidden).ToString().ToLowerInvariant())" /><input name="rowVersion" type="hidden" value="@review.RowVersion" /><input name="bookId" type="hidden" value="@Model.BookId" /><button class="btn btn-sm @(review.IsHidden ? "btn-outline-primary" : "btn-outline-danger")" type="submit">@(review.IsHidden ? UiText.Get("Қайта жариялау") : UiText.Get("Жасыру"))</button></form> }</td></tr> }</tbody></table></div> }
<nav class="actions mt-3" aria-label="@T["Модерация беттері"]">@if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-bookId="@Model.BookId" class="btn btn-sm btn-outline-secondary">@T["Алдыңғы"]</a> }<span class="text-muted">@Model.Page / @Model.TotalPages @T["бет"]</span>@if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-bookId="@Model.BookId" class="btn btn-sm btn-outline-secondary">@T["Келесі"]</a> }</nav>
</div>
</div>
