@model EduLibrary.ViewModels.ReviewModerationViewModel
@{ ViewData["Title"] = "Пікірлерді модерациялау"; }
<div class="workspace-page reviews-workspace index-workspace">
<div class="page-header workspace-heading"><div><p class="eyebrow">ҚАУЫМДАСТЫҚ САПАСЫ</p><h1>Пікірлерді модерациялау</h1><p class="text-muted">Жария пікірлер ғана кітаптың орташа бағасына және ұсыныстарға қосылады.</p></div><span class="badge badge-muted">@Model.TotalCount пікір</span></div>
<form method="get" class="card ledger-panel mb-4"><input name="BookId" type="hidden" value="@Model.BookId" /><div class="form-grid"><div><label for="review-search">Іздеу</label><input id="review-search" name="Search" value="@Model.Search" class="form-control" placeholder="Кітап, оқырман немесе пікір мәтіні" maxlength="200" /></div><div><label for="review-status">Мәртебесі</label><select id="review-status" name="Status" class="form-select"><option value="active" selected="@(Model.Status == "active")">Белсенді пікірлер</option><option value="visible" selected="@(Model.Status == "visible")">Жарияланған</option><option value="hidden" selected="@(Model.Status == "hidden")">Жасырылған</option><option value="deleted" selected="@(Model.Status == "deleted")">Автор жойған</option><option value="all" selected="@(Model.Status == "all")">Барлығы</option></select></div></div><div class="actions mt-3"><button class="btn btn-primary" type="submit">Іздеу</button><a asp-action="Index" class="btn btn-outline-secondary">Тазарту</a></div></form>
<div class="card ledger-panel">
@if (Model.Reviews.Count == 0) { <div class="empty-state"><i data-lucide="messages-square" aria-hidden="true"></i><h2>Пікірлер табылмады</h2><p>Іздеу шарттарын өзгертіңіз. Жаңа пікірлер осы жерде көрінеді.</p></div> }
else { <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>Кітап / оқырман</th><th>Баға / пікір</th><th>Күні</th><th>Мәртебе</th><th>Әрекет</th></tr></thead><tbody>@foreach (var review in Model.Reviews) { <tr><td><a asp-controller="Books" asp-action="Details" asp-route-id="@review.BookId" asp-fragment="reviews"><strong>@review.BookTitle</strong></a><small class="d-block text-muted">@review.ReviewerLabel</small></td><td><span class="review-stars">@review.Rating ★</span><p class="preserve-lines">@review.Comment</p></td><td>@review.CreatedAt.ToString("dd.MM.yyyy")</td><td><span class="badge @(review.IsDeleted ? "badge-muted" : review.IsHidden ? "badge-warning" : "badge-success")">@(review.IsDeleted ? "Жойылған" : review.IsHidden ? "Жасырылған" : "Жарияланған")</span></td><td>@if (!review.IsDeleted) { <form asp-action="Moderate" asp-route-id="@review.Id" method="post" data-confirm="Пікірдің жариялану мәртебесі өзгертілсін бе?"><input name="hidden" type="hidden" value="@((!review.IsHidden).ToString().ToLowerInvariant())" /><input name="rowVersion" type="hidden" value="@review.RowVersion" /><input name="bookId" type="hidden" value="@Model.BookId" /><button class="btn btn-sm @(review.IsHidden ? "btn-outline-primary" : "btn-outline-danger")" type="submit">@(review.IsHidden ? "Қайта жариялау" : "Жасыру")</button></form> }</td></tr> }</tbody></table></div> }
<nav class="actions mt-3" aria-label="Модерация беттері">@if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-bookId="@Model.BookId" class="btn btn-sm btn-outline-secondary">Алдыңғы</a> }<span class="text-muted">@Model.Page / @Model.TotalPages бет</span>@if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-bookId="@Model.BookId" class="btn btn-sm btn-outline-secondary">Келесі</a> }</nav>
</div>
</div>
