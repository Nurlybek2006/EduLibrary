@model EduLibrary.ViewModels.ReadingSpaceViewModel
@using EduLibrary.ViewModels
@{ ViewData["Title"] = UiText.Get("Менің оқу кеңістігім"); }
<link rel="stylesheet" href="~/css/recommendations.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/reading-space.css" asp-append-version="true" />
@if (!Model.HasStudentProfile)
{
    <header class="reading-heading"><span class="eyebrow">@T["Жеке кітап сөреңіз"]</span><h1>@T["Менің оқу кеңістігім"]</h1></header><section class="curated-empty"><span class="curated-empty-mark"><i data-lucide="book-open" aria-hidden="true"></i></span><h2>@T["Оқу кеңістігіңізді бірге ашайық."]</h2><p>@T["Your account is not linked to a student library record yet. Contact a librarian; you can browse the catalog meanwhile."]</p><a asp-controller="Books" asp-action="Index" class="btn btn-primary">@T["Каталогты қарау"] <i data-lucide="arrow-right" aria-hidden="true"></i></a></section>
}
else
{
    <header class="reading-heading"><div><div class="reading-profile-welcome">@await Component.InvokeAsync("Avatar", new { size = "medium" })<span class="eyebrow">@T["Қош келдіңіз,"] @Model.FullName</span></div><h1>@T["Менің оқу кеңістігім"]</h1><p>@T["Қолдағы кітаптар, жаңа ойлар және келесі оқу таңдауыңыз."]</p></div><a asp-controller="Books" asp-action="Index" class="reading-text-link">@T["Кітап іздеу"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></header>
    <div class="reading-main-grid"><section aria-labelledby="current-shelf-title"><div class="reading-section-heading"><h2 id="current-shelf-title">@T["Қолымдағы кітаптар"] <span>@Model.ActiveLoanCount</span></h2><a asp-controller="Loans" asp-action="Index" asp-route-status="active">@T["Барлығын көру"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div>
        @if (Model.CurrentBooks.Count == 0)
        { <div class="reading-shelf-empty"><i data-lucide="book-open" aria-hidden="true"></i><h3>@T["Сөреңіз келесі кітапты күтіп тұр."]</h3><p>@T["Қызықты әдебиетті тауып, кітапханашыдан ала аласыз."]</p><a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary">@T["Каталогтан таңдау"]</a></div> }
        else
        { <div class="reading-current-grid">@foreach (var book in Model.CurrentBooks)
          {
              var coverModel = new BookCoverViewModel { BookId = book.BookId, Title = book.Title, Authors = book.Authors, CoverImageUrl = book.CoverImageUrl, PublicationYear = book.PublicationYear, Size = "shelf", EagerLoad = true };
              var bookUrl = book.IsArchived ? Url.Action("Details", "Loans", new { id = book.LoanId }) : Url.Action("Details", "Books", new { id = book.BookId });
              <article class="reading-current-book"><a href="@bookUrl" class="reading-book-cover" tabindex="-1" aria-hidden="true"><partial name="_BookCover" model="coverModel" /></a><div class="reading-deadline @(book.DaysUntilDue < 0 ? "is-overdue" : book.DaysUntilDue <= 3 ? "is-soon" : "")"><span aria-hidden="true"></span> @book.DeadlineLabel</div><h3><a href="@bookUrl">@book.Title</a></h3><p>@book.Authors</p><a asp-controller="Loans" asp-action="Details" asp-route-id="@book.LoanId" class="reading-loan-date">@T["Қайтару:"] <time datetime="@book.DueDate.ToString("yyyy-MM-dd")">@book.DueDate.ToString("d")</time><i data-lucide="arrow-right" aria-hidden="true"></i></a></article>
          }</div> }
    </section>
    <aside class="reading-notebook" aria-label="@T["Жеке оқу ақпараты"]">
        <section class="reading-notebook-section"><span class="reading-note-label">@T["Есте сақтаңыз"]</span><h2>@T["Қайтару мерзімдері"]</h2>@if (Model.CurrentBooks.Count == 0) { <p>@T["Қазір қайтаруды күтетін кітап жоқ."]</p> } else { <ol class="reading-deadline-list">@foreach (var book in Model.CurrentBooks.Take(3)) { <li><time datetime="@book.DueDate.ToString("yyyy-MM-dd")"><strong>@book.DueDate.ToString("dd")</strong><span>@book.DueDate.ToString("MMM")</span></time><div><a asp-controller="Loans" asp-action="Details" asp-route-id="@book.LoanId">@book.Title</a><span class="@(book.DaysUntilDue < 0 ? "text-danger" : "")">@book.DeadlineLabel</span></div></li> }</ol> }</section>
        <section class="reading-notebook-section"><span class="reading-note-label">@T["Оқу бағытым"]</span><h2>@T["Қызығушылықтар"]</h2>@if (Model.Interests.Count == 0) { <p>@T["Өзіңізге жақын тақырыптарды қосып, жеке таңдауыңызды нақтылаңыз."]</p> } else { <div class="reading-interest-tags">@foreach (var interest in Model.Interests.Take(8)) { <span>@interest</span> }</div> }@if (Model.Subjects.Count > 0) { <p class="reading-subject-count">@T["Оқу бағытыңызда"] @Model.Subjects.Count @T["пән бар."]</p> }<a asp-controller="Recommendations" asp-action="Preferences" asp-route-studentId="@Model.StudentId" class="reading-text-link">@T["Оқу бағытын өзгерту"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></section>
        <section class="reading-notebook-section reading-balance"><span class="reading-note-label">@T["Айыппұлдарым"]</span><strong>@Model.OutstandingFines.ToString("N2") <small>₸</small></strong><p>@(Model.OutstandingFines > 0 ? UiText.Get("Бекітілген төленбеген сома. Төлем туралы кітапханашыға хабарласыңыз.") : UiText.Get("Төленбеген айыппұлыңыз жоқ."))</p><a asp-controller="Fines" asp-action="Index" class="reading-text-link">@T["Айыппұлдар тарихы"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></section>
    </aside></div>
    @await Component.InvokeAsync("ReservationSummary")
    <section class="reading-recommendation-shelf" aria-labelledby="reading-recommendation-title"><div class="reading-section-heading"><div><span class="eyebrow">@T["Келесі кітабыңыз осы жерде болуы мүмкін"]</span><h2 id="reading-recommendation-title">@T["Сізге арналған таңдау"]</h2></div><a asp-controller="Recommendations" asp-action="Index">@T["Барлық ұсыныстар"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div>
    @if (Model.Recommendations.Count == 0) { <div class="curated-shelf-empty"><i data-lucide="bookmark" aria-hidden="true"></i><p>@T["Жаңа ұсыныстар әзірге жоқ. Оқу бағытыңызды нақтылаңыз немесе бүкіл каталогты қараңыз."]</p></div> } else { <div class="curated-book-grid">@foreach (var recommendation in Model.Recommendations) { <partial name="~/Views/Recommendations/_RecommendationCard.cshtml" model="recommendation" /> }</div><p class="reading-selection-mode">@T[Model.RecommendationMode] @T["· Нақты каталог пен оқу деректеріңізге негізделген."]</p> }</section>
    <div class="reading-bottom-grid"><section aria-labelledby="reading-history-title"><div class="reading-section-heading"><h2 id="reading-history-title">@T["Оқыған кітаптарым"] <span>@Model.ReturnedBookCount</span></h2><a asp-controller="Students" asp-action="MyHistory">@T["Толық тарих"] <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div>
    @if (Model.History.Count == 0) { <div class="reading-history-empty"><p>@T["Оқу тарихыңыз алғашқы қайтарылған кітаптан басталады."]</p></div> } else { <div class="reading-history-grid">@foreach (var book in Model.History) { var coverModel = new BookCoverViewModel { BookId = book.BookId, Title = book.Title, Authors = book.Authors, CoverImageUrl = book.CoverImageUrl, PublicationYear = book.PublicationYear, Size = "compact" }; <article class="reading-history-book"><a asp-controller="Loans" asp-action="Details" asp-route-id="@book.LoanId" class="reading-history-cover" tabindex="-1" aria-hidden="true"><partial name="_BookCover" model="coverModel" /></a><div><h3><a asp-controller="Loans" asp-action="Details" asp-route-id="@book.LoanId">@book.Title</a></h3><p>@book.Authors</p><span>@book.ReturnedAt?.ToString("d") @T["Қайтарылды"]</span></div></article> }</div> }</section>
    <section class="reading-activity" aria-labelledby="reading-activity-title"><div class="reading-section-heading"><h2 id="reading-activity-title">@T["Соңғы әрекеттер"]</h2><a asp-controller="Notifications" asp-action="Index" aria-label="@T["Барлық хабарландыру"]"><i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div>@if (Model.RecentActivity.Count == 0) { <p class="reading-history-empty">@T["Кітапханадағы жаңа әрекеттеріңіз осы жерде көрінеді."]</p> } else { <ol class="reading-activity-list">@foreach (var activity in Model.RecentActivity) { <li><span class="reading-activity-dot" aria-hidden="true"></span><div><time datetime="@activity.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")">@activity.CreatedAt.ToString("dd MMM · HH:mm")</time><h3><a href="@activity.Link">@activity.Title</a></h3><p>@activity.Message</p></div></li> }</ol> }</section></div>
}
