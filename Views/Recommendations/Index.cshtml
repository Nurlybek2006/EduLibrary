@model EduLibrary.ViewModels.RecommendationViewModel
@{ ViewData["Title"] = "Жеке кітап ұсыныстары"; }
<link rel="stylesheet" href="~/css/recommendations.css" asp-append-version="true" />
<header class="curated-heading"><div><span class="eyebrow">Оқу жолыңызға арналған таңдау</span><h1>Сізге арналған кітаптар</h1><p>Бір қызығушылықтан жаңа әлемге. Әр ұсыныстың өз себебі бар.</p></div>@if (Model.StudentId.HasValue) { <a asp-action="Preferences" asp-route-studentId="@Model.StudentId" class="btn btn-outline-secondary"><i data-lucide="sliders-horizontal" aria-hidden="true"></i> Оқу бағытын өзгерту</a> }</header>
@if (Model.IsStaff)
{
    <form asp-action="Index" method="get" class="curated-reader"><label for="recommendation-student">Оқырманды таңдаңыз</label><select id="recommendation-student" asp-for="StudentId" asp-items="Model.Students" class="form-select"><option value="">Студентті таңдаңыз</option></select><button class="btn btn-primary" type="submit">Ұсыныстарды ашу <i data-lucide="arrow-right" aria-hidden="true"></i></button></form>
}
@if (!Model.StudentId.HasValue)
{
    <section class="curated-empty"><span class="curated-empty-mark"><i data-lucide="book-open" aria-hidden="true"></i></span><h2>@(Model.IsStaff ? "Әр оқырманның өз сөресі бар." : "Жеке сөреңізді бірге ашайық.")</h2><p>@(Model.IsStaff ? "Студентті таңдаңыз. Оның пәндері, қызығушылықтары және оқу тарихына сәйкес әдебиеттерді көрсетеміз." : "Аккаунтыңыз студент жазбасымен байланыстырылмаған. Кітапханашыға хабарласыңыз; әзірге каталогтағы әдебиеттерді қарай аласыз.")</p><a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary">Каталогты қарау <i data-lucide="arrow-right" aria-hidden="true"></i></a></section>
}
else
{
    <div class="curated-context"><div class="curated-context-topics">@if (Model.IsStaff) { <strong>@Model.StudentName</strong> }@foreach (var interest in Model.Interests.Take(4)) { <span class="recommendation-topic">@interest</span> }@foreach (var subject in Model.Subjects.Take(2)) { <span class="recommendation-topic recommendation-topic--subject">@subject</span> }</div><span class="curated-engine"><i data-lucide="sparkles" aria-hidden="true"></i> @Model.ActualMode</span></div>
    @if (Model.IsColdStart)
    { <div class="curated-note" role="status"><i data-lucide="sprout" aria-hidden="true"></i><div><strong>Оқу жолыңыз енді басталады.</strong><p>Жеке деректеріңіз әлі жеткіліксіз. Бұл таңдауда кітапханадағы танымалдық, ашық бағалар және факультет деректері ескерілді. <a asp-action="Preferences" asp-route-studentId="@Model.StudentId">Қызығушылықтарыңызды қосыңыз.</a></p></div></div> }
    else if (Model.HasMissingSignals)
    { <p class="curated-method">Қолда бар деректерге сүйендік. Әр кітаптан нақты факторлар мен олардың салмағын көре аласыз.</p> }
    <div class="curated-tools"><nav class="curated-nav" aria-label="Ұсыныс сөрелері">@foreach (var recommendationSection in Model.Sections) { <a href="#@recommendationSection.Key">@recommendationSection.Title</a> }</nav><form asp-action="Index" method="get" class="curated-policy"><input type="hidden" name="studentId" value="@Model.StudentId" /><label class="form-check-label"><input class="form-check-input" asp-for="IncludePreviouslyRead" /> Бұрын оқылғандарды қосу</label><button class="btn btn-sm btn-outline-secondary" type="submit">Қолдану</button></form></div>
    @if (Model.CandidateLimitReached) { <p class="curated-method">Алдымен қолжетімді және жиі алынатын @Model.CandidateCount кітап қаралды.</p> }
    @for (var shelfIndex = 0; shelfIndex < Model.Sections.Count; shelfIndex++)
    {
        var recommendationSection = Model.Sections[shelfIndex];
        <section id="@recommendationSection.Key" class="curated-shelf" aria-labelledby="heading-@recommendationSection.Key"><div class="curated-shelf-heading"><span class="curated-shelf-number">@((shelfIndex + 1).ToString("00"))</span><div><h2 id="heading-@recommendationSection.Key">@recommendationSection.Title</h2><p>@recommendationSection.Description</p></div><span class="curated-shelf-count">@recommendationSection.Books.Count кітап</span></div>
        @if (recommendationSection.Books.Count == 0) { <div class="curated-shelf-empty"><i data-lucide="bookmark" aria-hidden="true"></i><p>@recommendationSection.EmptyMessage</p></div> }
        else { <div class="curated-book-grid">@foreach (var book in recommendationSection.Books) { <partial name="_RecommendationCard" model="book" /> }</div> }
        </section>
    }
    <footer class="curated-footnote"><i data-lucide="shield-check" aria-hidden="true"></i><p>Кітаптарды жергілікті алгоритм таңдайды. Қазір қолдағы кітаптар көрсетілмейді, бос даналарға басымдық беріледі. LLM қосылса, тек түсіндірме мәтінін толықтырады; жеке байланыс деректері жіберілмейді.</p><a asp-controller="Books" asp-action="Index">Бүкіл каталог <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></footer>
}
