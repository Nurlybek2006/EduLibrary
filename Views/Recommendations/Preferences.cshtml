@model EduLibrary.ViewModels.RecommendationPreferencesViewModel
@{ ViewData["Title"] = "Оқу бағыты"; }
<link rel="stylesheet" href="~/css/recommendations.css" asp-append-version="true" />
<header class="curated-heading"><div><span class="eyebrow">Жеке таңдауыңызды нақтылау</span><h1>Сізді не қызықтырады?</h1><p>@Model.StudentName · @Model.Faculty</p></div><a asp-action="Index" asp-route-studentId="@Model.StudentId" class="btn btn-outline-secondary"><i data-lucide="arrow-left" aria-hidden="true"></i> Ұсыныстарға оралу</a></header>
<div class="preference-layout"><aside class="preference-aside"><span class="preference-aside-mark"><i data-lucide="sprout" aria-hidden="true"></i></span><h2>Қызығушылықтан<br />басталатын оқу.</h2><p>Өзіңізге жақын тақырыптар мен пәндерді таңдаңыз. Әр жаңа мәлімет жеке кітап сөреңізді нақтылай түседі.</p><p class="preference-privacy"><i data-lucide="lock-keyhole" aria-hidden="true"></i> Оқу бағытыңызды кез келген уақытта өзгерте аласыз.</p></aside>
<form asp-action="Preferences" method="post" id="recommendation-preferences" class="preference-form"><input type="hidden" asp-for="StudentId" /><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <section class="preference-section"><div class="preference-section-heading"><span>01</span><div><h2>Қызығушылықтарыңыз</h2><p>Мысалы: Python, алгоритмдер, тарих немесе дизайн.</p></div></div>
    <div id="interest-textarea"><label asp-for="Interests"></label><textarea asp-for="Interests" class="form-control" rows="4" maxlength="1000"></textarea><small class="form-text text-muted">Атауларды үтірмен бөліңіз. Ең көбі 20 бағыт; әр атау 100 таңбадан аспасын.</small></div>
    <div id="interest-editor" hidden><label for="new-interest">Тақырып қосу</label><div class="recommendation-interest-input"><input id="new-interest" type="text" class="form-control" maxlength="100" placeholder="Мысалы, деректер қоры" autocomplete="off" /><button id="add-interest" type="button" class="btn btn-primary"><i data-lucide="plus" aria-hidden="true"></i> Қосу</button></div><div id="interest-chips" class="recommendation-interest-chips" aria-label="Қызығушылықтар"></div><p id="interest-editor-error" class="text-danger" role="status" aria-live="polite"></p></div><span asp-validation-for="Interests" class="text-danger"></span></section>
    <section class="preference-section"><div class="preference-section-heading"><span>02</span><div><h2>Оқып жүрген пәндеріңіз</h2><p>Оқу жоспарыңыздағы пәндерге белгі қойыңыз.</p></div></div>
    <div class="recommendation-subjects">@foreach (var subject in Model.Subjects) { var selected = Model.SelectedSubjectIds.Contains(int.Parse(subject.Value)); <label class="recommendation-subject"><input class="form-check-input" type="checkbox" name="SelectedSubjectIds" value="@subject.Value" checked="@selected" /><span>@subject.Text</span></label> }</div>
    @if (Model.Subjects.Count == 0) { <p class="text-muted">Пәндер каталогы әлі толтырылмаған. Қазір қызығушылықтарыңызды сақтай аласыз.</p> }<span asp-validation-for="SelectedSubjectIds" class="text-danger"></span></section>
    <div class="preference-actions"><button type="submit" class="btn btn-primary">Сақтау және ұсыныстарды жаңарту <i data-lucide="arrow-right" aria-hidden="true"></i></button><a asp-action="Index" asp-route-studentId="@Model.StudentId">Бас тарту</a></div>
</form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/recommendations.js" asp-append-version="true"></script> }
