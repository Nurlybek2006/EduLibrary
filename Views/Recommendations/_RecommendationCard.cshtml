@model EduLibrary.ViewModels.RecommendationResult
@using EduLibrary.ViewModels
@{ var coverModel = new BookCoverViewModel { BookId = Model.BookId, Title = Model.Title, Authors = Model.Authors, CoverImageUrl = Model.CoverImageUrl, PublicationYear = Model.PublicationYear, Category = Model.Categories.FirstOrDefault(), Size = "shelf" }; }
<article class="recommendation-entry">
    <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" asp-route-relevance="@Model.DetailsToken" class="recommendation-cover-link" tabindex="-1" aria-hidden="true"><partial name="_BookCover" model="coverModel" /></a>
    <div class="recommendation-entry-meta"><span class="recommendation-match">@Model.RelevanceScore.ToString("0.#")<span>% сәйкестік</span></span><span class="recommendation-rating"><i data-lucide="star" aria-hidden="true"></i> @(Model.ReviewCount > 0 ? Model.AverageRating.ToString("0.0") : "Баға жоқ")</span></div>
    <h3><a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" asp-route-relevance="@Model.DetailsToken">@Model.Title</a></h3><p class="recommendation-author">@Model.Authors</p>
    <p class="recommendation-excerpt">@Model.Explanation</p>
    @if (Model.MatchingInterests.Count > 0 || Model.MatchingSubjects.Count > 0)
    { <div class="recommendation-topics">@foreach (var interest in Model.MatchingInterests.Take(2)) { <span class="recommendation-topic">@interest</span> }@foreach (var subject in Model.MatchingSubjects.Take(1)) { <span class="recommendation-topic recommendation-topic--subject">@subject</span> }</div> }
    <details class="recommendation-reason"><summary>Неліктен ұсынылды? <i data-lucide="plus" aria-hidden="true"></i></summary>@if (Model.IsLlmEnhanced) { <p class="recommendation-enhanced-note">Түсіндірме LLM көмегімен толықтырылды.</p> }<div class="table-responsive"><table class="table"><caption class="visually-hidden">Сәйкестік факторлары</caption><thead><tr><th scope="col">Фактор</th><th scope="col">0–1</th><th scope="col">Салмақ</th><th scope="col">Үлес</th></tr></thead><tbody>@foreach (var factor in Model.Breakdown) { <tr><th scope="row">@factor.Label</th><td>@factor.Value.ToString("0.00")</td><td>@((factor.EffectiveWeight * 100).ToString("0.#"))%</td><td>@factor.Contribution.ToString("0.#")</td></tr> }</tbody></table></div><p class="recommendation-calculation">Баға = фактор × салмақ үлестерінің қосындысы. Дерек жоқ фактордың салмағы қайта бөлінеді.</p></details>
    <div class="recommendation-availability"><span class="@(Model.AvailableCopies > 0 ? "available" : "unavailable")"><span aria-hidden="true"></span> @(Model.AvailableCopies > 0 ? Model.AvailableCopies + " дана қолжетімді" : "Қазір бос дана жоқ")</span><a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" asp-route-relevance="@Model.DetailsToken" aria-label="@Model.Title кітабын ашу"><i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div>
</article>
