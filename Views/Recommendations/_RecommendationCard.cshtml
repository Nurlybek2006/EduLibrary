@model EduLibrary.ViewModels.RecommendationResult
<article class="card recommendation-card">
    <div class="recommendation-book-heading">
        <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" asp-route-relevance="@Model.DetailsToken" class="recommendation-cover" tabindex="-1" aria-hidden="true">
        @if (!string.IsNullOrEmpty(Model.CoverImageUrl)) { <img src="@Model.CoverImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /> }
        else { <div class="book-cover-placeholder" data-tone="@(Model.BookId % 5)"><span>EDU<br />LIBRARY</span><i data-lucide="book-open" aria-hidden="true"></i><strong>@Model.Title</strong></div> }
        </a>
        <div class="recommendation-book-title"><span class="eyebrow">@Model.PublicationYear · @string.Join(" / ", Model.Categories.Take(2))</span><h3><a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" asp-route-relevance="@Model.DetailsToken">@Model.Title</a></h3><p>@Model.Authors</p><span class="recommendation-rating"><i data-lucide="star" aria-hidden="true"></i> @(Model.ReviewCount > 0 ? Model.AverageRating.ToString("0.0") + " / 5 · " + Model.ReviewCount + " пікір" : "Баға әлі қойылмаған")</span></div>
        <div class="recommendation-score"><strong>@Model.RelevanceScore.ToString("0.#")<small>%</small></strong><span>сәйкестік</span></div>
    </div>
    <div class="recommendation-reason"><span><i data-lucide="sparkles" aria-hidden="true"></i> Неліктен осы кітап?</span><p>@Model.Explanation</p>@if (Model.IsLlmEnhanced) { <small>Түсіндірме LLM көмегімен толықтырылды.</small> }</div>
    @if (Model.MatchingInterests.Count > 0 || Model.MatchingSubjects.Count > 0)
    { <div class="recommendation-matches">@foreach (var interest in Model.MatchingInterests.Take(3)) { <span class="recommendation-topic"><i data-lucide="heart" aria-hidden="true"></i> @interest</span> }@foreach (var subject in Model.MatchingSubjects.Take(2)) { <span class="recommendation-topic"><i data-lucide="graduation-cap" aria-hidden="true"></i> @subject</span> }</div> }
    <details class="recommendation-breakdown"><summary>Сәйкестік қалай есептелді?</summary><div class="table-responsive"><table class="table"><caption class="visually-hidden">Сәйкестік факторлары және қорытынды бағаға үлесі</caption><thead><tr><th scope="col">Фактор</th><th scope="col">0–1 мәні</th><th scope="col">Салмақ</th><th scope="col">Үлесі</th></tr></thead><tbody>@foreach (var factor in Model.Breakdown) { <tr><th scope="row">@factor.Label</th><td>@factor.Value.ToString("0.00")</td><td>@((factor.EffectiveWeight * 100).ToString("0.#"))%</td><td>@factor.Contribution.ToString("0.#")</td></tr> }</tbody></table></div><p>Қорытынды = фактор × нақты салмақ үлестерінің қосындысы. Бұл — деректерге негізделген салыстырмалы баға.</p></details>
    <div class="recommendation-card-footer"><span class="badge @(Model.AvailableCopies > 0 ? "badge-success" : "badge-warning")">@(Model.AvailableCopies > 0 ? Model.AvailableCopies + " дана қолжетімді" : "Қазір бос дана жоқ")</span><a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" asp-route-relevance="@Model.DetailsToken" class="btn btn-sm btn-outline-primary">Кітапты ашу <i data-lucide="arrow-up-right" aria-hidden="true"></i></a></div>
</article>

