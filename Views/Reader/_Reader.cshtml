@model EduLibrary.ViewModels.ReaderViewModel
@using System.Text.Json
@using EduLibrary.Models.Enums
@{
    var pdf = Model.Asset.FileFormat == DigitalFileFormat.Pdf;
    var messages = new Dictionary<string,string> {
        ["loading"]=T["Loading your book…"].Value,["loadFailed"]=T["The book could not be opened. Check your connection and try again."].Value,
        ["saving"]=T["Saving your place…"].Value,["saved"]=T["Your place is saved"].Value,["saveFailed"]=T["Your place could not be saved. Keep this page open and try again."].Value,
        ["ready"]=T["Ready to read"].Value,["page"]=T["Page {0}"].Value,["progress"]=T["{0}% read"].Value,
        ["emptyBookmarks"]=T["No bookmarks yet. Save a page or passage to return to it later."].Value,["open"]=T["Open"].Value,["edit"]=T["Edit"].Value,["remove"]=T["Remove"].Value,
        ["removeConfirm"]=T["Remove this bookmark?"].Value,["bookmarkSaved"]=T["Bookmark saved"].Value,["bookmarkRemoved"]=T["Bookmark removed"].Value,
        ["bookmarkFailed"]=T["The bookmark could not be saved. Please try again."].Value,["bookmarkTitle"]=T["Reading bookmark"].Value,
        ["searching"]=T["Searching the book…"].Value,["noMatches"]=T["No matching text found"].Value,["match"]=T["Match {0} of {1}"].Value,
        ["fullscreenFailed"]=T["Fullscreen is unavailable in this browser."].Value,["chapter"]=T["Chapter"].Value,["completed"]=T["Completed"].Value
    };
    var config = new { assetId=Model.Asset.Id, fileUrl=Model.FileUrl, format=pdf ? "pdf" : "epub",pageCount=Model.Asset.PageCount, initialProgress=Model.Progress,bookmarks=Model.Bookmarks,messages,
        endpoints=new {progress=Url.Action("Progress","Reader"),bookmark=Url.Action("Bookmark","Reader"),removeBookmark=Url.Action("RemoveBookmark","Reader")} };
}
<section class="reader-shell" id="reader-shell" data-reader-format="@(pdf ? "pdf" : "epub")" data-reader-theme="light">
<script type="application/json" id="reader-config">@Html.Raw(JsonSerializer.Serialize(config,new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
<div id="reader-token" hidden>@Html.AntiForgeryToken()</div>
<header class="reader-heading"><a asp-controller="DigitalLibrary" asp-action="Details" asp-route-id="@Model.Asset.Id" class="reader-back" title="@T["Back to book information"]"><i data-lucide="arrow-left" aria-hidden="true"></i><span>@T["Library"]</span></a><div><span class="section-caption">@(pdf ? "PDF" : "EPUB") · @Model.Asset.Authors</span><h1>@Model.Asset.Title</h1></div><a asp-controller="DigitalLibrary" asp-action="My" class="reader-my-link">@T["My digital books"]</a></header>
<div class="reader-toolbar" role="toolbar" aria-label="@T["Reading controls"]"><div class="reader-control-group"><button type="button" id="reader-prev" title="@T["Previous page"]" aria-label="@T["Previous page"]" disabled><i data-lucide="chevron-left" aria-hidden="true"></i></button>@if (pdf) { <label for="reader-page" class="visually-hidden">@T["Current page"]</label><input type="number" id="reader-page" min="1" value="1" aria-label="@T["Current page"]" /><span class="reader-page-divider">/ <output id="reader-total">@Model.Asset.PageCount</output></span> }<button type="button" id="reader-next" title="@T["Next page"]" aria-label="@T["Next page"]" disabled><i data-lucide="chevron-right" aria-hidden="true"></i></button></div>
@if (pdf) { <div class="reader-control-group"><button type="button" id="reader-zoom-out" title="@T["Zoom out"]" aria-label="@T["Zoom out"]"><i data-lucide="minus" aria-hidden="true"></i></button><output id="reader-zoom">100%</output><button type="button" id="reader-zoom-in" title="@T["Zoom in"]" aria-label="@T["Zoom in"]"><i data-lucide="plus" aria-hidden="true"></i></button><button type="button" id="reader-fit" class="reader-text-button">@T["Fit width"]</button></div><form id="reader-search-form" class="reader-search" role="search"><label for="reader-search" class="visually-hidden">@T["Search in book"]</label><input id="reader-search" type="search" placeholder="@T["Search in book"]" maxlength="200" /><button type="submit" title="@T["Find next"]" aria-label="@T["Find next"]"><i data-lucide="search" aria-hidden="true"></i></button></form> }
else { <div class="reader-control-group reader-toc-control"><label for="reader-toc" class="visually-hidden">@T["Table of contents"]</label><select id="reader-toc" aria-label="@T["Table of contents"]"><option value="">@T["Table of contents"]</option></select></div><div class="reader-control-group"><label for="reader-font">@T["Font size"]</label><input type="range" id="reader-font" min="85" max="170" step="5" value="110" /><label for="reader-spacing" class="visually-hidden">@T["Line spacing"]</label><select id="reader-spacing" title="@T["Line spacing"]"><option value="1.5">1.5</option><option value="1.8" selected>1.8</option><option value="2.1">2.1</option></select></div> }
<div class="reader-control-group reader-tools-end"><label for="reader-theme" class="visually-hidden">@T["Reading theme"]</label><select id="reader-theme" title="@T["Reading theme"]"><option value="light">@T["Light"]</option><option value="sepia">@T["Sepia"]</option><option value="dark">@T["Dark"]</option></select><button type="button" id="reader-bookmarks-toggle" title="@T["Bookmarks"]" aria-label="@T["Bookmarks"]" aria-expanded="false" aria-controls="reader-sidebar"><i data-lucide="bookmark" aria-hidden="true"></i><span id="reader-bookmark-count">@Model.Bookmarks.Count</span></button><button type="button" id="reader-fullscreen" title="@T["Fullscreen"]" aria-label="@T["Fullscreen"]"><i data-lucide="maximize" aria-hidden="true"></i></button></div></div>
<div class="reader-content-workspace"><section class="reader-stage" id="reader-stage" aria-label="@T["Book content"]"><div class="reader-loading" id="reader-loading"><span class="reader-spinner" aria-hidden="true"></span><p>@T["Loading your book…"]</p></div>@if (pdf) { <div class="reader-pdf-page" id="reader-pdf-page" hidden><canvas id="reader-canvas" aria-label="@T["PDF page"]"></canvas><div class="textLayer" id="reader-text-layer"></div></div> }else { <div id="reader-epub-view" class="reader-epub-view"></div> }</section><aside id="reader-sidebar" class="reader-sidebar" hidden><div><h2>@T["Bookmarks"]</h2><button type="button" id="reader-sidebar-close" aria-label="@T["Close bookmarks"]"><i data-lucide="x" aria-hidden="true"></i></button></div><button type="button" class="btn btn-primary" id="reader-add-bookmark" disabled><i data-lucide="bookmark-plus" aria-hidden="true"></i>@T["Add bookmark"]</button><div id="reader-bookmark-list" class="reader-bookmark-list"></div></aside></div>
<footer class="reader-footer"><div class="reader-progress-wrap"><progress id="reader-progress" max="100" value="0" aria-label="@T["Reading progress"]"></progress><output id="reader-progress-label">0%</output></div><p id="reader-status" role="status" aria-live="polite">@T["Loading your book…"]</p><button type="button" id="reader-retry-save" class="text-link" hidden>@T["Retry saving"]</button></footer>
<dialog id="reader-bookmark-dialog" class="reader-bookmark-dialog"><form id="reader-bookmark-form"><div class="reader-dialog-heading"><h2>@T["Save a bookmark"]</h2><button type="button" id="reader-bookmark-cancel" aria-label="@T["Close"]"><i data-lucide="x" aria-hidden="true"></i></button></div><input type="hidden" id="reader-bookmark-id" value="0" /><div class="form-group"><label for="reader-bookmark-title">@T["Bookmark title"]</label><input id="reader-bookmark-title" class="form-control" maxlength="200" required /></div><div class="form-group"><label for="reader-bookmark-note">@T["Note (optional)"]</label><textarea id="reader-bookmark-note" class="form-control" maxlength="2000" rows="3"></textarea></div><div class="actions"><button class="btn btn-primary" type="submit" id="reader-bookmark-save">@T["Save bookmark"]</button><button class="btn btn-outline-secondary" type="button" data-reader-dialog-close>@T["Cancel"]</button></div></form></dialog>
<noscript><p class="digital-license-note">@T["This reader requires JavaScript to render pages and save your reading position."]</p></noscript></section>
