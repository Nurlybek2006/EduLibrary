@model EduLibrary.ViewModels.FineListViewModel
@{ ViewData["Title"] = Model.IsStaff ? "Айыппұлдар" : "Менің айыппұлдарым"; }
<div class="workspace-page fines-workspace index-workspace">
<div class="page-header workspace-heading"><div><span class="eyebrow">ЕСЕП ЖӘНЕ ТӨЛЕМ</span><h1>@ViewData["Title"]</h1><p>Бекітілген айыппұлдар мен тіркелген төлемдер.</p></div><div class="balance-chip"><span class="text-muted">Қалған берешек</span><strong>@Model.OutstandingTotal.ToString("N2") ₸</strong></div></div>
<div class="card ledger-panel"><form method="get" class="filter-bar ledger-toolbar" role="search"><label class="visually-hidden" for="fine-search">Іздеу</label><input id="fine-search" class="form-control" name="search" value="@Model.Search" placeholder="Оқырман немесе кітап атауы" /><label class="visually-hidden" for="fine-status">Мәртебесі</label><select id="fine-status" name="status" class="form-select"><option value="outstanding" selected="@(Model.Status == "outstanding")">Берешегі бар</option><option value="partial" selected="@(Model.Status == "partial")">Ішінара төленген</option><option value="paid" selected="@(Model.Status == "paid")">Толық төленген</option><option value="all" selected="@(Model.Status == "all")">Барлық айыппұлдар</option></select><button class="btn btn-primary" type="submit">Іздеу</button><a class="btn btn-secondary" asp-action="Index">Тазарту</a></form>
@if(Model.Items.Count == 0) { <div class="empty-state"><i data-lucide="circle-check"></i><h2>Айыппұлдар табылмады</h2><p>Осы іздеу шарттарына сәйкес жазбалар жоқ.</p></div> }
else { <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>Оқырман</th><th>Кітап</th><th>Есептелді</th><th>Сома</th><th>Төленді</th><th>Қалдық</th><th>Мәртебесі</th><th></th></tr></thead><tbody>@foreach(var fine in Model.Items) { <tr><td>@fine.StudentName<small class="d-block text-muted">@fine.StudentNumber</small></td><td>@fine.BookTitle</td><td>@fine.CreatedAt.ToString("dd.MM.yyyy")</td><td>@fine.Amount.ToString("N2") ₸</td><td>@fine.PaidAmount.ToString("N2") ₸</td><td><strong>@fine.Balance.ToString("N2") ₸</strong></td><td><span class="badge badge-@fine.StatusClass">@fine.StatusLabel</span></td><td><a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@fine.Id">Толығырақ</a></td></tr> }</tbody></table></div> }
<div class="pagination-bar"><span class="text-muted">Барлығы: @Model.TotalCount жазба</span><div class="actions">@if(Model.Page > 1) { <a class="btn btn-sm btn-secondary" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)">Алдыңғы</a> }<span>@Model.Page / @Math.Max(1, Model.TotalPages)</span>@if(Model.Page < Model.TotalPages) { <a class="btn btn-sm btn-secondary" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)">Келесі</a> }</div></div></div>
<p class="text-muted mt-3">Қайтарылмаған кітаптардың болжамды айыппұлы «Кітап беру» бөлімінде көрсетіледі. Сома қайтару кезінде бекітіледі.</p>
</div>
