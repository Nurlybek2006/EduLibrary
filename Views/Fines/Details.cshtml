@model EduLibrary.ViewModels.FineDetailsViewModel
@{
    ViewData["Title"] = UiText.Get("Айыппұл ақпараты");
    var paymentAmount = ViewData.ModelState.TryGetValue("Amount", out var paymentState)
        ? paymentState.AttemptedValue
        : Model.Fine.Balance.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<div class="workspace-page fines-workspace detail-workspace">
<div class="page-header workspace-heading"><div><span class="eyebrow">@T["ЕСЕП ЖӘНЕ ТӨЛЕМ · №"]@Model.Fine.Id</span><h1>@T["Айыппұл ақпараты"]</h1><p>@Model.Fine.StudentName · @Model.Fine.BookTitle</p></div><a class="btn btn-secondary" asp-action="Index">@T["Тізімге оралу"]</a></div>
<div class="dashboard-grid workspace-columns">
<div class="card ledger-panel"><div class="card-header section-heading"><h2>@T["Есеп ақпараты"]</h2><span class="badge badge-@Model.Fine.StatusClass">@Model.Fine.StatusLabel</span></div><dl class="detail-grid record-grid"><div><dt>@T["Оқырман"]</dt><dd>@Model.Fine.StudentName</dd></div><div><dt>@T["Студент нөмірі"]</dt><dd>@Model.Fine.StudentNumber</dd></div><div><dt>@T["Айыппұл сомасы"]</dt><dd>@Model.Fine.Amount.ToString("N2") ₸</dd></div><div><dt>@T["Төленген сома"]</dt><dd>@Model.Fine.PaidAmount.ToString("N2") ₸</dd></div><div><dt>@T["Қалған берешек"]</dt><dd><strong>@Model.Fine.Balance.ToString("N2") ₸</strong></dd></div><div><dt>@T["Есептелген күні"]</dt><dd>@Model.Fine.CreatedAt.ToString("d")</dd></div></dl><div class="note-block"><h3>@T["Себебі"]</h3><p>@Model.Fine.Reason</p></div><a class="btn btn-secondary" asp-controller="Loans" asp-action="Details" asp-route-id="@Model.Fine.LoanId">@T["Кітап беру жазбасын ашу"]</a></div>
<div class="card ledger-panel"><div class="card-header section-heading"><h2>@T["Төлемдер тарихы"]</h2><i data-lucide="receipt"></i></div>
@if(Model.Payments.Count == 0) { <div class="empty-state"><i data-lucide="wallet"></i><p>@T["Төлемдер әлі тіркелмеген."]</p></div> }
else { <div class="table-responsive"><table class="table data-ledger"><thead><tr><th>@T["Күні"]</th><th>@T["Сома"]</th></tr></thead><tbody>@foreach(var payment in Model.Payments) { <tr><td>@payment.PaidAt.ToString("d")</td><td><strong>@payment.Amount.ToString("N2") ₸</strong></td></tr> }</tbody></table></div> }
</div></div>
@if(Model.IsStaff && Model.Fine.Balance > 0)
{
<div class="card ledger-panel mt-4 form-card sheet-form"><div class="card-header section-heading"><h2>@T["Төлемді тіркеу"]</h2></div><form asp-action="Pay" method="post"><input type="hidden" name="FineId" value="@Model.Fine.Id" /><input type="hidden" name="RowVersion" value="@Model.RowVersion" /><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="form-grid"><div><label class="form-label" for="fine-amount">@T["Төлем сомасы (₸)"]</label><input id="fine-amount" class="form-control" type="number" name="Amount" min="0.01" max="@Model.Fine.Balance.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" value="@paymentAmount" required /><small class="text-muted">@T["Ең көбі:"] @Model.Fine.Balance.ToString("N2") @T["₸. Ішінара төлем қабылданады."]</small></div></div><button class="btn btn-primary" type="submit"><i data-lucide="circle-check"></i> @T["Төлемді растау"]</button></form></div>
}
</div>
